```gitignore
# Mini-program specific
miniprogram/.swan/
miniprogram/.vscode/
miniprogram/node_modules/

# Build outputs
miniprogram/dist/
miniprogram/build/

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# Python specific
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg-info/
.eggs/

# Node specific
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled files
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out

# MyPy cache
.mypy_cache/
# Pytest cache
.pytest_cache/

# Gradle
.gradle/
build/

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```