```gitignore
# Mini-program specific
miniprogram/.swan/
miniprogram/dist/
miniprogram/node_modules/

# Compiled and build artifacts
*.wxml.js
*.wxss.js
*.json.js
*.swan.js

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db
```