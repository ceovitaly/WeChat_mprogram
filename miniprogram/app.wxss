page {
  --color-blue: #007AFF;
  --color-green: #34C759;
  --color-orange: #FF9500;
  --color-red: #FF3B30;
  --color-gray: #8E8E93;
  --color-separator: #C6C6C8;
  --color-bg: #F2F2F7;
  --color-card: #FFFFFF;
  --color-text-primary: #000000;
  --color-text-secondary: #8E8E93;
  --color-text-tertiary: #C7C7CC;
  --radius-card: 12rpx;
  --radius-btn: 12rpx;
  --radius-input: 10rpx;

  /* Theme variables */
  --bg: #F2F2F7;
  --bg-card: #FFFFFF;
  --bg-input: #F2F2F7;
  --bg-section: #F2F2F7;
  --text: #000000;
  --text-2: #8E8E93;
  --text-3: #C7C7CC;
  --text-green: #1D9E75;
  --separator: rgba(0,0,0,0.1);
  --border: #C6C6C8;
  --blue: #007AFF;
  --red: #FF3B30;
  --green: #34C759;

  font-family: -apple-system, 'SF Pro Display', 'PingFang SC', sans-serif;
  font-size: 28rpx;
  color: var(--text);
  background-color: var(--bg);
  box-sizing: border-box;
}

@media (prefers-color-scheme: dark) {
  page {
    --bg: #000000;
    --bg-card: #1C1C1E;
    --bg-input: #2C2C2E;
    --bg-section: #1C1C1E;
    --text: #FFFFFF;
    --text-2: #AEAEB2;
    --text-3: #636366;
    --text-green: #30D158;
    --separator: rgba(255,255,255,0.08);
    --border: #38383A;
    --blue: #0A84FF;
    --red: #FF453A;
    --green: #30D158;
  }
}

view, text, input, button {
  box-sizing: border-box;
}

button::after {
  border: none;
}

.card {
  background: var(--bg-card);
  border-radius: 12rpx;
  overflow: hidden;
}

.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx;
  border-bottom: 0.5px solid var(--bg);
}

.card-row:last-child {
  border-bottom: none;
}

.section-title {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 1rpx;
  padding: 24rpx 32rpx 12rpx;
}

.primary-btn {
  background: var(--blue);
  border-radius: 24rpx;
  padding: 26rpx;
  text-align: center;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  width: 100%;
}

.destructive-btn {
  background: var(--red);
  border-radius: 24rpx;
  padding: 26rpx;
  text-align: center;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  width: 100%;
}

.ghost-btn {
  background: transparent;
  border-radius: 24rpx;
  padding: 26rpx;
  text-align: center;
  color: var(--blue);
  font-size: 32rpx;
  font-weight: 500;
  border: 1rpx solid var(--blue);
  width: 100%;
}

.ios-input {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  font-size: 30rpx;
  color: var(--text);
  width: 100%;
}

.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: var(--text-2);
  font-size: 28rpx;
}

.chevron {
  color: var(--text-3);
  font-size: 26rpx;
}

.badge {
  font-size: 22rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.badge-green {
  background: #E8F8F0;
  color: #1D9E75;
}

.badge-blue {
  background: #E8F0FB;
  color: #185FA5;
}

.badge-orange {
  background: #FFF3E0;
  color: #E65100;
}

.badge-red {
  background: #FFEBE9;
  color: #FF3B30;
}

.badge-gray {
  background: var(--bg);
  color: var(--text-2);
}
