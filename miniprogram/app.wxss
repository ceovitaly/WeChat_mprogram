/* ── Design tokens ──
   Mirrors the token pattern used by the admin app's app.wxss: custom
   properties declared on `page{}` so they cascade into every child
   component, overridden per-token inside a `page{}` block nested in
   `@media (prefers-color-scheme: dark)`. */
page {
  --accent: #FF6B35;       /* brand accent — primary CTAs, selected/active states */
  --blue: #007AFF;         /* system/link/neutral action color */
  --bg: #F2F2F7;           /* page background */
  --bg-elevated: #FFFFFF;  /* card / header / sheet surfaces */
  --bg-inset: #F2F2F7;     /* nested panels inside an elevated surface */
  --text-primary: #1C1C1E; /* primary text */
  --text-secondary: #8E8E93; /* secondary text — same value in light & dark */
  --border: #E5E5EA;       /* borders, dividers, neutral fills/pressed states */

  background: var(--bg);
  font-family: -apple-system, 'SF Pro Display', 'PingFang SC', sans-serif;
  -webkit-font-smoothing: antialiased;
}

@media (prefers-color-scheme: dark) {
  page {
    --blue: #0A84FF;
    --bg: #000000;
    --bg-elevated: #1C1C1E;
    --bg-inset: #2C2C2E;
    --text-primary: #FFFFFF;
    --border: #38383A;
  }
}

/* ── Icon system ──
   Single-path outline icons (24×24 viewBox, 2px stroke, round caps —
   Feather/Lucide aesthetic) rendered as -webkit-mask data URIs so the
   glyph is tinted purely by background-color. Default tint is
   currentColor, so an icon inside e.g. a white-text button is white
   automatically; override background-color (with a token) per site.
   Size by overriding width/height on the usage-site class. */
.icon {
  display: block;
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  background-color: currentColor;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
}

.icon--list {
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='none'%20stroke='black'%20stroke-width='2'%20stroke-linecap='round'%20stroke-linejoin='round'%3E%3Cpath%20d='M8%206h13M8%2012h13M8%2018h13M3%206h.01M3%2012h.01M3%2018h.01'/%3E%3C/svg%3E");
}

.icon--search {
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='none'%20stroke='black'%20stroke-width='2'%20stroke-linecap='round'%20stroke-linejoin='round'%3E%3Cpath%20d='M11%204a7%207%200%201%200%200%2014%207%207%200%200%200%200-14M16%2016l5%205'/%3E%3C/svg%3E");
}

.icon--calendar {
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='none'%20stroke='black'%20stroke-width='2'%20stroke-linecap='round'%20stroke-linejoin='round'%3E%3Cpath%20d='M5%204h14a2%202%200%200%201%202%202v13a2%202%200%200%201-2%202H5a2%202%200%200%201-2-2V6a2%202%200%200%201%202-2zM16%202v4M8%202v4M3%2010h18'/%3E%3C/svg%3E");
}

.icon--camera {
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='none'%20stroke='black'%20stroke-width='2'%20stroke-linecap='round'%20stroke-linejoin='round'%3E%3Cpath%20d='M23%2019a2%202%200%200%201-2%202H3a2%202%200%200%201-2-2V8a2%202%200%200%201%202-2h4l2-3h6l2%203h4a2%202%200%200%201%202%202zM12%209a4%204%200%201%200%200%208%204%204%200%200%200%200-8z'/%3E%3C/svg%3E");
}

.icon--close {
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='none'%20stroke='black'%20stroke-width='2'%20stroke-linecap='round'%20stroke-linejoin='round'%3E%3Cpath%20d='M18%206L6%2018M6%206l12%2012'/%3E%3C/svg%3E");
}

.icon--user {
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='none'%20stroke='black'%20stroke-width='2'%20stroke-linecap='round'%20stroke-linejoin='round'%3E%3Cpath%20d='M20%2021v-2a4%204%200%200%200-4-4H8a4%204%200%200%200-4%204v2M12%203a4%204%200%201%200%200%208%204%204%200%200%200%200-8z'/%3E%3C/svg%3E");
}

.icon--edit {
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='none'%20stroke='black'%20stroke-width='2'%20stroke-linecap='round'%20stroke-linejoin='round'%3E%3Cpath%20d='M17%203a2.85%202.83%200%201%201%204%204L7.5%2020.5%202%2022l1.5-5.5L17%203z'/%3E%3C/svg%3E");
}

/* Large muted icon for empty states (replaces the old emoji glyphs) */
.icon-empty {
  width: 96rpx;
  height: 96rpx;
  background-color: var(--text-secondary);
}

/* ── Press feedback ──
   WeChat applies hover-class as a class swap (not a pseudo-class), so
   the transition must live on the base element for a smooth release.
   Usage: class="... pressable" hover-class="pressed" (cards/buttons)
   or hover-class="pressed-soft" (list rows / text rows). Pair with
   hover-start-time="20" hover-stay-time="80" for a snappy feel. */
.pressable {
  transition: transform 0.16s ease, opacity 0.16s ease;
}
.pressed {
  transform: scale(0.98);
  opacity: 0.85;
}
.pressed-soft {
  opacity: 0.7;
}

/* ── Shared nav ── */
.nav-bar {
  background: var(--bg-elevated);
  padding: 16rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 0.5px solid #C6C6C8;
  position: sticky;
  top: 0;
  z-index: 10;
}
.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.nav-back-text {
  font-size: 28rpx;
  color: var(--blue);
  min-width: 100rpx;
}

/* ── Shared card ── */
.card {
  background: var(--bg-elevated);
  border-radius: 20rpx;
  overflow: hidden;
}

/* ── Empty state ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  gap: 16rpx;
}
.empty-icon { font-size: 80rpx; }
.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.empty-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.5;
}

/* ── Tab bar spacer ── */
.tab-bar-spacer { height: 160rpx; }

/* ── Shared spinner (used by register/me/mytickets loading states) ── */
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 6rpx solid var(--border);
  border-top-color: var(--blue);
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
