page {
  background: #F2F2F7;
  font-family: -apple-system, 'SF Pro Display', 'PingFang SC', sans-serif;
  -webkit-font-smoothing: antialiased;
  height: 100vh;
  box-sizing: border-box;
  --header-height: 88rpx;
  --safe-top: env(safe-area-inset-top);
  --safe-bottom: env(safe-area-inset-bottom);
  --primary-color: #07c160;
  --danger-color: #fa5151;
  --text-main: #1a1a1a;
  --text-sub: #888;
  --card-bg: #ffffff;
  --radius-lg: 24rpx;
  --radius-md: 16rpx;
  --spacing-page: 32rpx;
}

/* ── Unified Header System ── */
.page-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-top: var(--safe-top);
  box-sizing: border-box;
}

.common-header {
  position: relative;
  height: var(--header-height);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 var(--spacing-page);
  box-sizing: border-box;
  background-color: #F2F2F7;
  z-index: 100;
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #000;
  text-align: center;
  line-height: 1.2;
}

.back-btn {
  position: absolute;
  left: var(--spacing-page);
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  cursor: pointer;
  z-index: 101;
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
  fill: #007AFF;
}

/* ── Scrollable Content ── */
.scroll-content {
  flex: 1;
  overflow-y: auto;
  padding-bottom: calc(160rpx + var(--safe-bottom));
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
}

/* ── Cards & Sections ── */
.section {
  margin-bottom: 32rpx;
  padding: 0 var(--spacing-page);
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #000;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

/* ── Floating Bottom Navigation ── */
.floating-nav {
  position: fixed;
  bottom: calc(24rpx + var(--safe-bottom));
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 48rpx;
  z-index: 1000;
  pointer-events: none;
}

.nav-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  transition: transform 0.2s;
  border: 4rpx solid #F2F2F7;
}

.nav-circle:active {
  transform: scale(0.95);
}

.nav-icon {
  width: 56rpx;
  height: 56rpx;
  fill: #333;
}

/* ── Common Buttons ── */
.btn-full {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-sizing: border-box;
}

.btn-primary {
  background: var(--primary-color);
  color: #fff;
}

.btn-danger {
  background: var(--danger-color);
  color: #fff;
}

/* ── Inputs & Filters ── */
.filter-trigger {
  flex: 1;
  height: 72rpx;
  background: #fff;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-main);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}

.filter-panel {
  background: #fff;
  border-radius: var(--radius-md);
  padding: 16rpx;
  margin-top: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.option-item {
  padding: 24rpx 16rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.option-item:last-child {
  border-bottom: none;
}

/* ── Shared nav (legacy) ── */
.nav-bar {
  background: #FFFFFF;
  padding: 16rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 0.5px solid #C6C6C8;
  position: sticky;
  top: 0;
  z-index: 10;
}
.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #000;
}
.nav-back-text {
  font-size: 28rpx;
  color: #007AFF;
  min-width: 100rpx;
}

/* ── Empty state ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  gap: 16rpx;
}
.empty-icon { font-size: 80rpx; }
.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #000;
}
.empty-sub {
  font-size: 26rpx;
  color: #8E8E93;
  text-align: center;
  line-height: 1.5;
}

/* ── Tab bar spacer ── */
.tab-bar-spacer { height: 160rpx; }