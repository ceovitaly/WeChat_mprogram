page {
  /* Theme variables */
  --bg: #F2F2F7;
  --bg-card: #FFFFFF;
  --bg-input: #F2F2F7;
  --bg-section: #F2F2F7;
  --text: #000000;
  --text-2: #8E8E93;
  --text-3: #C7C7CC;
  --text-green: #1D9E75;
  --separator: rgba(0,0,0,0.1);
  --border: #C6C6C8;
  --blue: #007AFF;
  --red: #FF3B30;
  --green: #34C759;

  font-family: -apple-system, 'SF Pro Display', 'PingFang SC', sans-serif;
  font-size: 28rpx;
  color: var(--text);
  background-color: var(--bg);
  box-sizing: border-box;
}

@media (prefers-color-scheme: dark) {
  page {
    --bg: #000000;
    --bg-card: #1C1C1E;
    --bg-input: #2C2C2E;
    --bg-section: #1C1C1E;
    --text: #FFFFFF;
    --text-2: #AEAEB2;
    --text-3: #636366;
    --text-green: #30D158;
    --separator: rgba(255,255,255,0.08);
    --border: #38383A;
    --blue: #0A84FF;
    --red: #FF453A;
    --green: #30D158;
  }
}

view, text, input, button {
  box-sizing: border-box;
}

button::after {
  border: none;
}

/* ══════════════════════════════════════════════════════════════
   SHARED PAGE STYLES

   Everything below this line was previously duplicated verbatim
   across page .wxss files and was hoisted here so it is parsed
   once at startup instead of once per page.

   Page .wxss is appended after app.wxss, so an equal-specificity
   rule in a page still wins — pages that needed a different value
   keep a local override with a comment pointing back here.
   ══════════════════════════════════════════════════════════════ */

/* Surfaces ─────────────────────────────────────────────────── */

/* was duplicated in: event-edit, event-guests, venue-edit, counter/work.
   team (24rpx) and register (glass card) keep their own radius. */
.card {
  background: var(--bg-card);
  border-radius: 20rpx;
  overflow: hidden;
}

/* was duplicated in: event-edit, event-guests, stats, venue-edit,
   plus promoters (.action-section-title) and staff (.role-section-title).
   team keeps a local override (0 8rpx 12rpx). */
.section-title {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 1rpx;
  padding: 0 4rpx 12rpx;
  display: block;
}

/* counter/work is the last page still hand-rolling a header row (it is
   NOT on the shared <nav-bar> component — see components/nav-bar), so
   this is now used by that page alone. */
.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

/* Trailing actions placed in <nav-bar>'s "right" slot. Slot content is
   rendered in the HOST PAGE's scope, so these must be global — the
   component's own .wxss cannot reach them. */
.nav-action { padding: 0 8rpx; }
.nav-action:active { opacity: 0.5; }

.nav-action-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--blue);
}

/* in-flight Save */
.nav-action-text--dim { opacity: 0.4; }
/* destructive trailing action (Log out) — red, not blue */
.nav-action-text--danger { color: var(--red); }

/* Page header toolbar ───────────────────────────────────────── */
/* Sits BETWEEN </nav-bar> and the scroll-view on list pages, as a
   flex-shrink:0 sibling of both (part of the page's fixed header,
   NOT inside the scroll-view). Holds the primary action that used
   to live in <nav-bar>'s right slot — given its own row so it gets
   a proper pill shape and full touch width instead of the
   capsule-aligned text label. */
.page-toolbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: var(--bg-card);
}

.page-add-btn {
  height: 76rpx;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: var(--blue);
  border-radius: 999rpx;
  border: none;
}

.page-add-btn:active { opacity: 0.8; }

.page-add-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* was duplicated in: calendar, team, counter/work.
   stats and counter/stats keep their own flat 160rpx value. */
.tab-bar-spacer {
  height: calc(100rpx + env(safe-area-inset-bottom));
}

/* Card list pages (venue-list / promoters / staff) ──────────── */

.scroll-content {
  flex: 1;
  height: 0;
}

.list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.item-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  overflow: hidden;
}

.item-top {
  display: flex;
  align-items: center;
  padding: 28rpx;
  gap: 20rpx;
  border-bottom: 0.5px solid var(--bg);
}

/* border-radius / background stay page-local: venue-list uses a rounded
   square logo tile, promoters + staff use circles. */
.item-avatar {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* colour stays page-local (#185FA5 on venue-list/promoters,
   var(--text) on staff). */
.item-avatar-text {
  font-size: 34rpx;
  font-weight: 700;
}

/* venue-list + promoters add `overflow: hidden` locally. */
.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

/* venue-list adds ellipsis truncation locally. */
.item-sub {
  font-size: 28rpx;
  color: var(--text-2);
}

/* Empty states ─────────────────────────────────────────────── */
/* NOTE: .empty-state itself is deliberately NOT unified — the eight
   pages that use it disagree on padding, gap, direction and text
   colour. Only the genuinely identical pieces live here. */

/* calendar keeps a local 64rpx override. */
.empty-icon { font-size: 80rpx; }

/* ── House CTA geometry ──────────────────────────────────────────
   Every rectangular action button in this app is 76rpx tall, a full
   999rpx pill, with a 28rpx/600 label. Height comes from `height`
   plus flex centring — never from vertical padding — so labels stay
   optically centred at any font size.
   ──────────────────────────────────────────────────────────────── */

/* was duplicated in: calendar, promoters, venue-list */
.empty-btn {
  margin-top: 8rpx;
  height: 76rpx;
  padding: 0 40rpx;
  background: var(--blue);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-btn:active { opacity: 0.8; }

.empty-btn-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* Form field rows ──────────────────────────────────────────── */
/* was duplicated in: event-edit, promoters, staff, venue-edit.
   .field-input is intentionally left page-local — the four pages
   disagree on text alignment, and event-edit's line-height/padding
   are hand-tuned so the Title input and Description field share a
   baseline. Don't hoist it. */

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  min-height: 88rpx;
  border-bottom: 0.5px solid var(--bg);
}

.field-row:last-child { border-bottom: none; }

/* min-width stays page-local (160–200rpx depending on label length). */
.field-label {
  font-size: 28rpx;
  color: var(--text);
}

.field-placeholder { color: var(--text-3); }

/* venue-edit adds `flex: 1` locally. */
.field-picker {
  font-size: 28rpx;
  color: var(--blue);
  text-align: right;
}

/* was duplicated in: event-edit, venue-edit */
.save-btn {
  background: var(--blue);
  border-radius: 999rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
}

.save-btn:active { opacity: 0.8; }
.save-btn--dim { opacity: 0.5; }
.save-btn-text { font-size: 28rpx; color: #FFFFFF; font-weight: 600; }

/* Sheet / modal contents ───────────────────────────────────── */
/* The overlay + sheet shell now live in packageAdmin/components/bottom-sheet.
   These are the *contents* placed in its <slot>, which is rendered
   in the host page's scope, so they must be global (or page) styles. */

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 20rpx;
}

.modal-title { font-size: 32rpx; font-weight: 700; color: var(--text); }
.modal-close { font-size: 28rpx; color: var(--text-2); padding: 8rpx 16rpx; }

.modal-body {
  background: var(--bg-card);
  margin: 0 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
}

/* promoters keeps its own .modal-cancel/.modal-save (text-align based
   rather than flex based) so its rendering is bit-for-bit unchanged. */
.modal-cancel {
  flex: 1;
  background: var(--bg-card);
  border-radius: 999rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-2);
  font-weight: 600;
}

.modal-save {
  flex: 2;
  background: var(--blue);
  border-radius: 999rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.modal-save:active { opacity: 0.8; }

/* Guest rows (event-guests / guests / counter/work) ─────────── */

/* counter/work overrides `gap` to 20rpx. */
.guest-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  gap: 16rpx;
  border-bottom: 0.5px solid var(--bg);
}

.guest-row:last-child { border-bottom: none; }

/* guests/ overrides font-size + adds flex:1. */
.guest-name { font-size: 30rpx; font-weight: 500; color: var(--text); }

.guest-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.guest-sub { font-size: 22rpx; color: var(--text-2); }
.arrival-time { font-size: 26rpx; color: var(--text-2); flex-shrink: 0; }

/* was duplicated in: guests, counter/work */
.search-input {
  height: 72rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text);
  width: 100%;
  box-sizing: border-box;
}

/* was duplicated in: event-guests, guests */
.internal-badge { flex-shrink: 0; }

/* Tier badge box — colours stay page-local, they genuinely differ. */
.tier-badge {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

/* was duplicated in: event-guests, counter/work */
.arrived-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx 8rpx;
  background: var(--bg);
  border-radius: 16rpx 16rpx 0 0;
  margin-top: 16rpx;
}

.arrived-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-2);
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

.arrived-section-count {
  font-size: 24rpx;
  color: var(--text-2);
}

.arrived-section-card {
  border-radius: 0 0 20rpx 20rpx;
}

/* Buttons ──────────────────────────────────────────────────── */

/* NOTE: counter/work is the only page with .primary-btn markup and it
   defines its own .primary-btn + .primary-btn-text locally, so this rule
   is currently shadowed. Kept (and brought to house geometry) so the next
   page that reaches for the name gets the right shape by default. */
.primary-btn {
  background: var(--blue);
  border-radius: 999rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  width: 100%;
}

.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: var(--text-2);
  font-size: 28rpx;
}

.badge {
  font-size: 22rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* Only .badge-blue / .badge-orange are referenced (guests + event-guests
   internal-role pills). The green/red/gray variants were unused. */
.badge-blue {
  background: #E8F0FB;
  color: #185FA5;
}

.badge-orange {
  background: #FFF3E0;
  color: #E65100;
}
