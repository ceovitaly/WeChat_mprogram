.container {
  background: #f8f9fa;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-top: env(safe-area-inset-top);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

/* ===== HEADER ===== */
.header {
  position: fixed;
  top: env(safe-area-inset-top);
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  z-index: 100;
  border-bottom: 1rpx solid #f0f0f0;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.back-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  border-radius: 44rpx;
  box-sizing: border-box;
}

.back-icon {
  font-size: 48rpx;
  color: #1c1c1e;
  line-height: 1;
}

.back-text {
  font-size: 30rpx;
  color: #1c1c1e;
  font-weight: 500;
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.placeholder {
  width: 88rpx;
}

.content-wrapper {
  flex: 1;
  padding: 120rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
}

/* ===== LOADING ===== */
.loading-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  text-align: center;
  margin-top: 24rpx;
  box-sizing: border-box;
}

.loading-text {
  color: #8e8e93;
  font-size: 28rpx;
}

/* ===== PROFILE SECTION ===== */
.profile-section {
  margin-bottom: 24rpx;
}

/* ===== PROFILE CARD ===== */
.profile-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.05);
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-sizing: border-box;
  margin-top: 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  flex-shrink: 0;
  background: #f0f0f0;
  flex-shrink: 0;
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: #34c759;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-letter {
  font-size: 52rpx;
  color: #fff;
  font-weight: bold;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #1c1c1e;
}

.user-sub {
  font-size: 24rpx;
  color: #8e8e93;
}

/* ===== MENU ===== */
.menu-list {
  margin: 24rpx 0 0;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.05);
  overflow: hidden;
  box-sizing: border-box;
}

.menu-item {
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f5f5f5;
  background: #fff;
  min-height: 88rpx;
  box-sizing: border-box;
}

.menu-item:active {
  background: #f9f9f9;
}

.menu-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #1c1c1e;
}

.logout-text {
  color: #ff3b30;
}

.arrow {
  font-size: 40rpx;
  color: #c7c7cc;
}

/* ===== PROMO DISPLAY CARD (Approved Promoter) ===== */
.promo-display-card {
  padding: 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #f5f5f5;
  box-sizing: border-box;
}

.promo-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.promo-label {
  font-size: 24rpx;
  color: #8e8e93;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.status-tag.approved {
  background: #eafff0;
  color: #34c759;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 100rpx;
  font-weight: bold;
}

.promo-body {
  background: #f8f9fa;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #e0e0e0;
  box-sizing: border-box;
}

.promo-body:active {
  background: #f0f0f0;
}

.promo-value {
  font-size: 56rpx;
  font-weight: 800;
  color: #1c1c1e;
  letter-spacing: 6rpx;
}

.copy-hint {
  font-size: 22rpx;
  color: #34c759;
  margin-top: 12rpx;
  font-weight: 500;
}

/* ===== DISABLED STATES (Pending / Rejected) ===== */
.disabled-item {
  background: #fafafa !important;
  pointer-events: none; /* Отключает нажатия */
}

.pending-text {
  color: #ff9500;
  font-weight: 500;
}

.rejected-text {
  color: #ff3b30;
  font-weight: 500;
}

/* ===== MODAL ===== */
.auth-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(10px);
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-content {
  background: #fff;
  width: 85%;
  max-width: 600rpx;
  padding: 48rpx 32rpx;
  border-radius: 40rpx;
  text-align: center;
  box-sizing: border-box;
}

.modal-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1c1c1e;
  display: block;
  margin-bottom: 16rpx;
}

.modal-sub {
  font-size: 26rpx;
  color: #8e8e93;
  display: block;
  margin-bottom: 32rpx;
}

.nick-input {
  background: #f5f5f5;
  height: 88rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #1c1c1e;
  text-align: left;
  box-sizing: border-box;
}

.confirm-btn {
  background: #34c759;
  color: #fff;
  width: 100% !important;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  margin-top: 16rpx;
  box-sizing: border-box;
}

.cancel-btn {
  flex: 1;
  background: #f2f2f7;
  color: #1c1c1e;
  border-radius: 44rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  box-sizing: border-box;
}

/* ===== PROMO CODE INPUT SECTION ===== */
.promo-code-section {
  padding: 32rpx;
  box-sizing: border-box;
}

.promo-code-title {
  font-size: 26rpx;
  color: #8e8e93;
  display: block;
  margin-bottom: 20rpx;
}

.promo-code-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.promo-code-input {
  flex: 1;
  background: #f5f5f5;
  height: 88rpx;
  border-radius: 24rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}

.promo-code-btn {
  background: #1c1c1e;
  color: #fff;
  font-size: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
}

/* ===== AUTH CARD ===== */
.auth-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.05);
  margin-top: 24rpx;
  box-sizing: border-box;
}

.auth-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1c1c1e;
  display: block;
  margin-bottom: 16rpx;
}

.auth-sub {
  font-size: 26rpx;
  color: #8e8e93;
  display: block;
  margin-bottom: 32rpx;
}

.login-btn {
  background: #34c759;
  color: #fff;
  width: 100% !important;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  box-sizing: border-box;
}