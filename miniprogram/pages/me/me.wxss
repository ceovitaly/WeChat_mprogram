page {
  height: 100%;
  overflow: hidden;
  background: var(--bg);
}

.page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* Loading */
.loading-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Signed-out state (mirrors the empty-state + sign-in CTA conventions
   from mytickets/feed) */
.signed-out-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx calc(120rpx + env(safe-area-inset-bottom));
  gap: 16rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.empty-sub {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.5;
}

.signin-btn {
  margin-top: 8rpx;
  height: 76rpx;
  background: linear-gradient(135deg, #FF8F5E 0%, #FF6B35 100%);
  border-radius: 999rpx;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.signin-btn:active { opacity: 0.8; }

.signin-btn-text {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}

/* Scroll */
.scroll {
  flex: 1;
  height: 0;
}

.content {
  padding: 32rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.profile-progress {
  padding: 28rpx;
  border: 1rpx solid rgba(255, 107, 53, 0.28);
  border-radius: 24rpx;
  background: rgba(255, 107, 53, 0.08);
}

.profile-progress--complete {
  border-color: rgba(52, 199, 89, 0.28);
  background: rgba(52, 199, 89, 0.08);
}

.profile-progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.profile-progress-title {
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 700;
}

.profile-progress-count {
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 700;
}

.profile-progress--complete .profile-progress-count { color: #34C759; }

.profile-progress-track {
  height: 10rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--bg-inset);
}

.profile-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--accent);
  transition: width 0.25s ease;
}

.profile-progress--complete .profile-progress-fill { background: #34C759; }

.profile-progress-sub {
  display: block;
  margin-top: 16rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.45;
}

/* Info list */
.info-list {
  background: var(--bg-elevated);
  border-radius: 24rpx;
  overflow: hidden;
}

.info-row {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
}

.info-row--missing {
  background: rgba(255, 107, 53, 0.07);
}

.info-row--missing .info-label,
.info-row--missing .info-value--empty {
  color: var(--accent);
}
.info-row::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 0;
  height: 0.5px;
  background: var(--bg-inset);
}

.info-row:last-child::after {
  display: none;
}

.info-label {
  font-size: 30rpx;
  color: var(--text-secondary);
}

.info-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.info-row-value-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* Unset value reads as a placeholder, not as data */
.info-value--empty {
  color: var(--text-secondary);
  font-weight: 400;
}

/* <picker> is a block child of the flex row — let it take the free space
   so its value group still sits flush right like the tappable rows. */
.info-row-picker {
  flex: 1;
}
.info-row-picker .info-row-value-group {
  justify-content: flex-end;
}

.safe-bottom {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

/* Logout bar */
.logout-bar {
  position: relative;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-elevated);
  flex-shrink: 0;
}
.logout-bar::after {
  content: '';
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 0;
  height: 0.5px;
  background: var(--border);
}

.logout-btn {
  height: 76rpx;
  background: #FF3B30;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-btn:active {
  opacity: 0.8;
}

.logout-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.edit-pencil {
  width: 26rpx;
  height: 26rpx;
  background-color: var(--blue);
}

/* Name edit sheet — mask/shell now provided by <bottom-sheet>; this stays
   page-specific card styling for the name-edit sheet's contents. */
.name-sheet {
  width: 100%;
  box-sizing: border-box;
  background: var(--bg-elevated);
  border-radius: 24rpx 24rpx 0 0;
  padding: 12rpx 24rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.name-sheet-handle {
  width: 36rpx;
  height: 8rpx;
  background: var(--border);
  border-radius: 4rpx;
  align-self: center;
  margin-bottom: 8rpx;
}

.name-sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  display: block;
}

.name-input {
  height: 96rpx;
  background: var(--bg-inset);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  width: 100%;
}

.name-input-ph {
  color: #C7C7CC;
}

/* Music multi-select chips (music sheet) */
.genre-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 0 16rpx;
}

.genre-chip {
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  background: var(--bg-inset);
  border: 1px solid transparent;
}

.genre-chip--on {
  background: var(--accent);
  border-color: var(--accent);
}

.genre-chip-txt {
  font-size: 28rpx;
  color: var(--text-primary);
}

/* Selection reads by weight too, never color alone */
.genre-chip--on .genre-chip-txt {
  color: #FFFFFF;
  font-weight: 600;
}

/* Settings-level utility action (not a funnel CTA) — stays on --blue */
.name-save-btn {
  height: 96rpx;
  background: var(--blue);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.name-save-btn:active { opacity: 0.8; }

.name-save-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.name-cancel-btn {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.name-cancel-text {
  font-size: 30rpx;
  color: var(--text-secondary);
}

/* ===== DARK MODE ===== */
/* Most colors flip automatically via the tokens above. Only genuinely
   page-local shades (out of the token palette, or diverging from the
   token's dark value) are overridden below. */
@media (prefers-color-scheme: dark) {
  .page { background: var(--bg); }

  .logout-btn { background: #FF453A; }
  .profile-progress { background: rgba(255, 107, 53, 0.13); }
  .profile-progress--complete { background: rgba(52, 199, 89, 0.13); }
  .info-row--missing { background: rgba(255, 107, 53, 0.1); }

  /* Handle bar reads slightly lighter than --border against the dark
     sheet background — matches the equivalent handle in event-detail's
     ticket-modal */
  .name-sheet-handle { background: #3A3A3C; }
  .name-input-ph { color: rgba(255,255,255,0.25); }
}
