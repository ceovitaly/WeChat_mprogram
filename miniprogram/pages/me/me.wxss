page {
  height: 100%;
  overflow: hidden;
  background: var(--bg);
}

.page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* Loading */
.loading-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Header */
.header {
  background: var(--bg-elevated);
  padding-top: calc(44rpx + env(safe-area-inset-top));
  padding-bottom: 24rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  border-bottom: 0.5px solid var(--border);
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

/* Scroll */
.scroll {
  flex: 1;
  height: 0;
}

.content {
  padding: 32rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* Profile card */
.profile-card {
  background: var(--bg-elevated);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.avatar-wrap {
  flex-shrink: 0;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--border);
}

.avatar-placeholder {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--blue);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-letter {
  font-size: 56rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.user-info-wrap {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nickname {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.user-sub-hint {
  font-size: 24rpx;
  color: #C7C7CC;
}

.user-phone {
  font-size: 26rpx;
  color: var(--text-secondary);
  letter-spacing: 0.5rpx;
}

/* Info list */
.info-list {
  background: var(--bg-elevated);
  border-radius: 24rpx;
  overflow: hidden;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 0.5px solid var(--bg-inset);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 30rpx;
  color: var(--text-secondary);
}

.info-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.safe-bottom {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

/* Logout bar */
.logout-bar {
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-elevated);
  border-top: 0.5px solid var(--border);
  flex-shrink: 0;
}

.logout-btn {
  height: 96rpx;
  background: #FF3B30;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-btn:active {
  opacity: 0.8;
}

.logout-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* Nickname row */
.nickname-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.edit-pencil {
  font-size: 28rpx;
  color: var(--blue);
  font-weight: 400;
}

/* Name edit sheet — mask/shell now provided by <bottom-sheet>; this stays
   page-specific card styling for the name-edit sheet's contents. */
.name-sheet {
  width: 100%;
  background: var(--bg-elevated);
  border-radius: 24rpx 24rpx 0 0;
  padding: 12rpx 24rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.name-sheet-handle {
  width: 36rpx;
  height: 8rpx;
  background: var(--border);
  border-radius: 4rpx;
  align-self: center;
  margin-bottom: 8rpx;
}

.name-sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  display: block;
}

.name-input {
  height: 96rpx;
  background: var(--bg-inset);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  width: 100%;
}

.name-input-ph {
  color: #C7C7CC;
}

/* Settings-level utility action (not a funnel CTA) — stays on --blue */
.name-save-btn {
  height: 96rpx;
  background: var(--blue);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.name-save-btn:active { opacity: 0.8; }

.name-save-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.name-cancel-btn {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.name-cancel-text {
  font-size: 30rpx;
  color: var(--text-secondary);
}

/* ===== DARK MODE ===== */
/* Most colors flip automatically via the tokens above. Only genuinely
   page-local shades (out of the token palette, or diverging from the
   token's dark value) are overridden below. */
@media (prefers-color-scheme: dark) {
  .page { background: var(--bg); }

  .user-sub-hint { color: #636366; }

  .logout-btn { background: #FF453A; }

  /* Handle bar reads slightly lighter than --border against the dark
     sheet background — matches the equivalent handle in event-detail's
     ticket-modal */
  .name-sheet-handle { background: #3A3A3C; }
  .name-input-ph { color: rgba(255,255,255,0.25); }
}
