.container {
  background: #f8f9fa;
  min-height: 100vh;
  display: block;
  padding-bottom: 60rpx;
}

.profile-section {
  padding: 60rpx 30rpx 30rpx;
}

/* ===== LOADING ===== */
.loading-card {
  background: #fff;
  border-radius: 40rpx;
  padding: 60rpx;
  text-align: center;
}

.loading-text {
  color: #8e8e93;
  font-size: 28rpx;
}

/* ===== PROFILE CARD ===== */
.profile-card {
  background: #fff;
  border-radius: 40rpx;
  padding: 50rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.05);
  display: flex;
  align-items: center;
  gap: 30rpx;
  box-sizing: border-box;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 70rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.avatar-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 70rpx;
  background: #34c759;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-letter {
  font-size: 60rpx;
  color: #fff;
  font-weight: bold;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.nickname {
  font-size: 40rpx;
  font-weight: bold;
  color: #1c1c1e;
}

.user-sub {
  font-size: 24rpx;
  color: #8e8e93;
}

/* ===== MENU ===== */
.menu-list {
  margin: 30rpx 30rpx 0;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.05);
  overflow: hidden;
}

.menu-item {
  padding: 45rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f5f5f5;
  background: #fff;
}

.menu-item:active {
  background: #f9f9f9;
}

.menu-text {
  font-size: 34rpx;
  font-weight: 500;
  color: #1c1c1e;
}

.logout-text {
  color: #ff3b30;
}

.arrow {
  font-size: 40rpx;
  color: #c7c7cc;
}

/* ===== PROMO DISPLAY CARD (Approved Promoter) ===== */
.promo-display-card {
  padding: 40rpx;
  background: #fff;
  border-bottom: 1rpx solid #f5f5f5;
}

.promo-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.promo-label {
  font-size: 24rpx;
  color: #8e8e93;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.status-tag.approved {
  background: #eafff0;
  color: #34c759;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 100rpx;
  font-weight: bold;
}

.promo-body {
  background: #f8f9fa;
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #e0e0e0;
}

.promo-body:active {
  background: #f0f0f0;
}

.promo-value {
  font-size: 56rpx;
  font-weight: 800;
  color: #1c1c1e;
  letter-spacing: 6rpx;
}

.copy-hint {
  font-size: 22rpx;
  color: #34c759;
  margin-top: 12rpx;
  font-weight: 500;
}

/* ===== DISABLED STATES (Pending / Rejected) ===== */
.disabled-item {
  background: #fafafa !important;
  pointer-events: none; /* Отключает нажатия */
}

.pending-text {
  color: #ff9500;
  font-weight: 500;
}

.rejected-text {
  color: #ff3b30;
  font-weight: 500;
}

/* ===== MODAL ===== */
.auth-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(10px);
}

.modal-content {
  background: #fff;
  width: 85%;
  padding: 60rpx 50rpx;
  border-radius: 40rpx;
  text-align: center;
  box-sizing: border-box;
}

.modal-title {
  font-size: 42rpx;
  font-weight: bold;
  color: #1c1c1e;
  display: block;
  margin-bottom: 16rpx;
}

.modal-sub {
  font-size: 26rpx;
  color: #8e8e93;
  display: block;
  margin-bottom: 40rpx;
}

.nick-input {
  background: #f5f5f5;
  height: 100rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  padding: 0 30rpx;
  font-size: 32rpx;
  color: #1c1c1e;
  text-align: left;
}

.confirm-btn {
  background: #34c759;
  color: #fff;
  width: 100% !important;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: bold;
  border: none;
  margin-top: 20rpx;
}

.cancel-btn {
  flex: 1;
  background: #f2f2f7;
  color: #1c1c1e;
  border-radius: 50rpx;
  font-size: 30rpx;
  height: 100rpx;
  line-height: 100rpx;
}

/* ===== PROMO CODE INPUT SECTION ===== */
.promo-code-section {
  padding: 40rpx;
}

.promo-code-title {
  font-size: 26rpx;
  color: #8e8e93;
  display: block;
  margin-bottom: 20rpx;
}

.promo-code-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.promo-code-input {
  flex: 1;
  background: #f5f5f5;
  height: 100rpx;
  border-radius: 24rpx;
  padding: 0 30rpx;
  font-size: 32rpx;
}

.promo-code-btn {
  background: #1c1c1e;
  color: #fff;
  font-size: 28rpx;
  height: 100rpx;
  line-height: 100rpx;
  padding: 0 45rpx;
  border-radius: 24rpx;
}

/* ===== AUTH CARD ===== */
.auth-card {
  background: #fff;
  border-radius: 40rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.05);
}

.auth-title {
  font-size: 42rpx;
  font-weight: bold;
  color: #1c1c1e;
  display: block;
  margin-bottom: 16rpx;
}

.auth-sub {
  font-size: 26rpx;
  color: #8e8e93;
  display: block;
  margin-bottom: 40rpx;
}

.login-btn {
  background: #34c759;
  color: #fff;
  width: 100% !important;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: bold;
  border: none;
}