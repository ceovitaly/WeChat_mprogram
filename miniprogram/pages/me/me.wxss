/* Page-specific styles for me */

/* ===== LOADING ===== */
.loading-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.loading-text {
  color: #8e8e93;
  font-size: 28rpx;
}

/* ===== PROFILE CARD ===== */
.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: #34c759;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-letter {
  font-size: 52rpx;
  color: #fff;
  font-weight: bold;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #1c1c1e;
}

.user-sub {
  font-size: 24rpx;
  color: #8e8e93;
}

/* ===== AUTH CARD ===== */
.auth-card {
  text-align: center;
}

.auth-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1c1c1e;
  display: block;
  margin-bottom: 16rpx;
}

.auth-sub {
  font-size: 26rpx;
  color: #8e8e93;
  display: block;
  margin-bottom: 32rpx;
}

/* ===== PROMO DISPLAY CARD ===== */
.promo-display-card {
  padding: 32rpx;
}

.promo-code-title {
  font-size: 26rpx;
  color: #8e8e93;
  display: block;
  margin-bottom: 20rpx;
}

.promo-code-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
}

/* ===== MENU LIST ===== */
.menu-list {
  overflow: hidden;
}

.menu-item {
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f5f5f5;
  background: #fff;
  min-height: 88rpx;
  box-sizing: border-box;
}

.menu-item:active {
  background: #f9f9f9;
}

.menu-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #1c1c1e;
}

.logout-text {
  color: #ff3b30;
}

.arrow {
  font-size: 40rpx;
  color: #c7c7cc;
}

/* ===== MODAL ===== */
.auth-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(10px);
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-content {
  background: #fff;
  width: 85%;
  max-width: 600rpx;
  padding: 48rpx 32rpx;
  border-radius: 40rpx;
  text-align: center;
  box-sizing: border-box;
}

.modal-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1c1c1e;
  display: block;
  margin-bottom: 16rpx;
}

.modal-sub {
  font-size: 26rpx;
  color: #8e8e93;
  display: block;
  margin-bottom: 32rpx;
}

.nick-input {
  background: #f5f5f5;
  height: 88rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #1c1c1e;
  text-align: left;
  box-sizing: border-box;
}

.confirm-btn {
  background: #34c759;
  color: #fff;
  width: 100% !important;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  margin-top: 16rpx;
  box-sizing: border-box;
}

.cancel-btn {
  flex: 1;
  background: #f2f2f7;
  color: #1c1c1e;
  border-radius: 44rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  box-sizing: border-box;
}

/* ===== PROMO CODE INPUT SECTION ===== */
.promo-code-section {
  padding: 32rpx;
  box-sizing: border-box;
}

.promo-code-title {
  font-size: 26rpx;
  color: #8e8e93;
  display: block;
  margin-bottom: 20rpx;
}

.promo-code-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.promo-code-input {
  flex: 1;
  background: #f5f5f5;
  height: 88rpx;
  border-radius: 24rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}

.promo-code-btn {
  background: #1c1c1e;
  color: #fff;
  font-size: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
}