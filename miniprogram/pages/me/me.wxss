page {
  height: 100%;
  overflow: hidden;
  background: #F2F2F7;
}

.page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* Loading */
.loading-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 6rpx solid #E5E5EA;
  border-top-color: #007AFF;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Header */
.header {
  background: #FFFFFF;
  padding-top: calc(44rpx + env(safe-area-inset-top));
  padding-bottom: 24rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  border-bottom: 0.5px solid #E5E5EA;
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.header-title {
  flex: 1;
  font-size: 48rpx;
  font-weight: 800;
  color: #1C1C1E;
  text-align: center;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
}

.back-icon {
  font-size: 56rpx;
  color: #1C1C1E;
  line-height: 1;
}

.header-placeholder {
  width: 64rpx;
}

/* Scroll */
.scroll {
  flex: 1;
  height: 0;
}

.content {
  padding: 32rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* Profile card */
.profile-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.avatar-wrap {
  flex-shrink: 0;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #E5E5EA;
}

.avatar-placeholder {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #007AFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-letter {
  font-size: 56rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.user-info-wrap {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nickname {
  font-size: 40rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.user-sub-hint {
  font-size: 24rpx;
  color: #C7C7CC;
}

.user-phone {
  font-size: 26rpx;
  color: #8E8E93;
  letter-spacing: 0.5rpx;
}

/* Info list */
.info-list {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 0.5px solid #F2F2F7;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 30rpx;
  color: #8E8E93;
}

.info-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.safe-bottom {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

/* Logout bar */
.logout-bar {
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 0.5px solid #E5E5EA;
  flex-shrink: 0;
}

.logout-btn {
  height: 96rpx;
  background: #FF3B30;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-btn:active {
  opacity: 0.8;
}

.logout-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* Nickname row */
.nickname-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.edit-pencil {
  font-size: 28rpx;
  color: #007AFF;
  font-weight: 400;
}

/* Name edit sheet */
.name-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.name-sheet {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 12rpx 24rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.name-sheet-handle {
  width: 36rpx;
  height: 8rpx;
  background: #E5E5EA;
  border-radius: 4rpx;
  align-self: center;
  margin-bottom: 8rpx;
}

.name-sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1C1C1E;
  text-align: center;
  display: block;
}

.name-input {
  height: 96rpx;
  background: #F2F2F7;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #1C1C1E;
  box-sizing: border-box;
  width: 100%;
}

.name-input-ph {
  color: #C7C7CC;
}

.name-save-btn {
  height: 96rpx;
  background: #007AFF;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.name-save-btn:active { opacity: 0.8; }

.name-save-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.name-cancel-btn {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.name-cancel-text {
  font-size: 30rpx;
  color: #8E8E93;
}

/* ===== DARK MODE ===== */
@media (prefers-color-scheme: dark) {
  page { background: #000000; }
  .page { background: #000000; }

  .header { background: #1C1C1E; border-bottom-color: #38383A; }
  .header-title { color: #FFFFFF; }
  .back-icon { color: #FFFFFF; }

  .profile-card { background: #1C1C1E; }
  .nickname { color: #FFFFFF; }
  .user-phone { color: #8E8E93; }
  .user-sub-hint { color: #636366; }
  .edit-pencil { color: #0A84FF; }
  .avatar-placeholder { background: #0A84FF; }

  .info-list { background: #1C1C1E; }
  .info-row { border-bottom-color: #2C2C2E; }
  .info-label { color: #8E8E93; }
  .info-value { color: #FFFFFF; }

  .logout-bar { background: #1C1C1E; border-top-color: #38383A; }
  .logout-btn { background: #FF453A; }

  .name-overlay { background: rgba(0,0,0,0.65); }
  .name-sheet { background: #1C1C1E; }
  .name-sheet-handle { background: #3A3A3C; }
  .name-sheet-title { color: #FFFFFF; }
  .name-input { background: #2C2C2E; color: #FFFFFF; }
  .name-input-ph { color: rgba(255,255,255,0.25); }
  .name-save-btn { background: #0A84FF; }
  .name-cancel-text { color: #8E8E93; }
}
