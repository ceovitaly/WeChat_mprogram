<!--pages/me/me.wxml-->
<view class="page">

  <!-- Loading -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
  </view>

  <!-- Profile -->
  <block wx:elif="{{userInfo}}">
    <view class="header">
      <view class="back-btn" bindtap="goBack">
        <text class="back-icon">‹</text>
      </view>
      <text class="header-title">Profile</text>
      <view class="header-placeholder"></view>
    </view>

    <scroll-view class="scroll" scroll-y>
      <view class="content">

        <view class="profile-card">
          <view class="avatar-wrap">
            <image wx:if="{{userInfo.avatarUrl}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
            <view wx:else class="avatar-placeholder">
              <text class="avatar-letter">{{avatarLetter}}</text>
            </view>
          </view>
          <view class="user-info-wrap">
            <view class="user-info" bindtap="openNameEdit">
              <view class="nickname-row">
                <text class="nickname">{{userInfo.nickName || userInfo.name || 'Set name'}}</text>
                <text class="edit-pencil">✎</text>
              </view>
              <text class="user-sub-hint">Tap to edit</text>
            </view>
            <text wx:if="{{userInfo.phone}}" class="user-phone">{{userInfo.phone}}</text>
          </view>
        </view>

        <view class="info-list">
          <view class="info-row" wx:if="{{userInfo.promoCode}}">
            <text class="info-label">Promo code</text>
            <text class="info-value">{{userInfo.promoCode}}</text>
          </view>
        </view>

        <view class="safe-bottom"></view>
      </view>
    </scroll-view>

    <view class="logout-bar">
      <view class="logout-btn" bindtap="logout">
        <text class="logout-text">Log Out</text>
      </view>
    </view>
  </block>

  <!-- Name edit sheet -->
  <view wx:if="{{showNameEdit}}" class="name-overlay" bindtap="closeNameEdit">
    <view class="name-sheet" catchtap="noop">
      <view class="name-sheet-handle"></view>
      <text class="name-sheet-title">Edit Name</text>
      <input
        class="name-input"
        value="{{editingName}}"
        bindinput="onNameInput"
        placeholder="Your name"
        placeholder-class="name-input-ph"
        focus="{{true}}"
        maxlength="30"
        confirm-type="done"
        bindconfirm="saveNameEdit"
      />
      <view class="name-save-btn" bindtap="saveNameEdit">
        <text class="name-save-text">Save</text>
      </view>
      <view class="name-cancel-btn" bindtap="closeNameEdit">
        <text class="name-cancel-text">Cancel</text>
      </view>
    </view>
  </view>

</view>
