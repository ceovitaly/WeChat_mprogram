<view class="container">

<view class="profile-section">
  <block wx:if="{{hasUserInfo}}">
    <view class="profile-card">
      <block wx:if="{{userInfo.avatarUrl}}">
        <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      </block>
      <block wx:else>
        <view class="avatar-placeholder">
          <text class="avatar-letter">{{userInfo.nickName[0]}}</text>
        </view>
      </block>
      <view class="user-info">
        <text class="nickname">{{userInfo.nickName}}</text>
        <text class="user-sub">{{applicationStatus === 'approved' ? 'Promoter Account' : 'Guest Account'}}</text>
      </view>
    </view>
  </block>
  <block wx:else>
    <view class="loading-card">
      <text class="loading-text">Loading...</text>
    </view>
  </block>
</view>

<view class="menu-list" wx:if="{{hasUserInfo}}">
  <view class="menu-item" bindtap="goToTickets">
    <text class="menu-text">My Tickets</text>
    <text class="arrow">›</text>
  </view>
  <view class="menu-item" bindtap="scanQR">
    <text class="menu-text">Scan QR</text>
    <text class="arrow">›</text>
  </view>
  <view class="menu-item" bindtap="logout">
    <text class="menu-text logout-text">Log Out</text>
    <text class="arrow">›</text>
  </view>
</view>

<view class="menu-list" wx:if="{{hasUserInfo && userInfo.promoterId}}">
  <view class="promo-code-section">
    <text class="promo-code-title">Your Promoter</text>
    <text class="promo-code-value">🌟 {{userInfo.promoterName}}</text>
  </view>
</view>

<view class="auth-modal" wx:if="{{showModal}}">
  <view class="modal-content">
    <text class="modal-title">Welcome to Yue 🎉</text>
    <text class="modal-sub">Tell us your name to get started</text>
    <button class="avatar-wrapper" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="modal-avatar" src="{{tempAvatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
      <text class="edit-hint">Change photo</text>
    </button>
    <form bindsubmit="saveProfile">
      <input type="nickname" name="nickName" class="nick-input" placeholder="Your name *" />
      <button form-type="submit" class="confirm-btn">Let's Go →</button>
    </form>
  </view>
</view>

</view>