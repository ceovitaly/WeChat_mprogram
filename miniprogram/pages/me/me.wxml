<!--pages/me/me.wxml-->
<view class="page-container">
  <!-- Unified Header -->
  <view class="common-header">
    <view class="back-btn" bindtap="goBack">
      <svg class="back-icon" viewBox="0 0 48 48">
        <path d="M28 16L16 24l12 8V16z"/>
      </svg>
    </view>
    <text class="header-title">Profile</text>
  </view>

  <scroll-view class="scroll-content" scroll-y enhanced show-scrollbar="false">
    <view class="section">
      <!-- Profile Section -->
      <view class="card profile-card" wx:if="{{hasUserInfo}}">
        <block wx:if="{{userInfo.avatarUrl}}">
          <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
        </block>
        <block wx:else>
          <view class="avatar-placeholder">
            <text class="avatar-letter">{{userInfo.nickName[0]}}</text>
          </view>
        </block>
        <view class="user-info">
          <text class="nickname">{{userInfo.nickName}}</text>
          <text class="user-sub">{{applicationStatus === 'approved' ? 'Promoter Account' : 'Guest Account'}}</text>
        </view>
      </view>

      <!-- Auth Card -->
      <view class="card auth-card" wx:elif="{{showAuthButton}}">
        <text class="auth-title">Welcome to Yue 🎉</text>
        <text class="auth-sub">Sign in to access your profile and tickets</text>
        <button class="btn-full btn-primary" bindtap="onLogin">Sign In with WeChat</button>
      </view>

      <!-- Loading State -->
      <view class="card loading-card" wx:else>
        <text class="loading-text">Loading...</text>
      </view>
    </view>

    <!-- Promoter Info -->
    <view class="section" wx:if="{{hasUserInfo && userInfo.promoterId}}">
      <view class="card promo-display-card">
        <text class="promo-code-title">Your Promoter</text>
        <text class="promo-code-value">🌟 {{userInfo.promoterName}}</text>
      </view>
    </view>

    <!-- Menu List -->
    <view class="section" wx:if="{{hasUserInfo}}">
      <view class="card menu-list">
        <view class="menu-item" bindtap="logout">
          <text class="menu-text logout-text">Log Out</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </view>

    <!-- Logout Button at Bottom -->
    <view class="section" wx:if="{{hasUserInfo}}">
      <button class="btn-full btn-danger" bindtap="logout">Log Out</button>
    </view>
  </scroll-view>
</view>