<view class="page-container">
  <!-- Header -->
  <view class="header">
    <text class="header-title">My Tickets</text>
  </view>
  
  <view class="back-btn" bindtap="goBack">
    <svg class="back-icon" viewBox="0 0 48 48">
      <path d="M28 16L16 24l12 8V16z"/>
    </svg>
  </view>

  <scroll-view class="scroll-content" scroll-y enhanced show-scrollbar="false">
    <!-- Past Events Section -->
    <view class="section" style="margin-top: 40rpx;">
      <view class="card past-events-card" bindtap="goToPastEvents">
        <view class="past-events-header">
          <text class="past-events-title">Past Events</text>
          <text class="past-events-arrow">›</text>
        </view>
        <text class="past-events-sub">View your event history</text>
      </view>
    </view>

    <view wx:if="{{isLoading}}" class="loading">
      <text>Loading...</text>
    </view>
    
    <view wx:elif="{{tickets.length === 0}}" class="empty-state">
      <text class="empty-icon">🎫</text>
      <text class="empty-text">No tickets yet</text>
      <text class="empty-sub">Register for an event to see your tickets here</text>
    </view>
    
    <view wx:else class="tickets-list">
      <view
        wx:for="{{tickets}}"
        wx:key="_id"
        class="ticket-card card"
      >
        <view class="ticket-info">
          <text class="ticket-title">{{item.eventTitle}}</text>
          <view class="ticket-meta">
            <view class="dot"></view>
            <text class="ticket-venue">{{item.eventDate}}</text>
            <text class="ticket-time">{{item.ticketType === 'free' ? 'Free' : 'Paid'}}</text>
          </view>
        </view>
        <view class="ticket-actions">
          <view class="status-badge {{item.arrivedAt ? 'badge-arrived' : 'badge-confirmed'}}">
            <text>{{item.arrivedAt ? '✓' : '•'}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>