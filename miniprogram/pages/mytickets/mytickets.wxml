<!--pages/mytickets/mytickets.wxml-->
<view class="page">

  <app-tabs active-tab="wallet" />

  <view class="tabs">
    <view class="tab {{activeTab === 'active' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="active">
      <text class="tab-text">Active</text>
    </view>
    <view class="tab {{activeTab === 'past' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="past">
      <text class="tab-text">Past</text>
    </view>
  </view>

  <scroll-view class="scroll" scroll-y>
    <view wx:if="{{isLoading}}" class="loading-wrap">
      <loading-state label="Loading tickets" />
    </view>

    <view wx:elif="{{isAnonymous}}" class="empty-state">
      <view class="icon icon--list icon-empty"></view>
      <text class="empty-title">Sign in to see your tickets</text>
      <text class="empty-sub">Your issued tickets and free invitations will appear here once you sign in</text>
      <view class="signin-btn" bindtap="goSignIn">
        <text class="signin-btn-text">Sign In</text>
      </view>
    </view>

    <!-- Both tabs share one card for paid tickets and confirmed free invitations. -->
    <block wx:else>
      <view wx:if="{{visibleTickets.length === 0}}" class="empty-state">
        <view class="icon {{activeTab === 'past' ? 'icon--calendar' : 'icon--list'}} icon-empty"></view>
        <text class="empty-title">{{activeTab === 'past' ? 'No past tickets' : 'No active tickets'}}</text>
        <text class="empty-sub">{{activeTab === 'past' ? 'Tickets move here after the event ends' : 'Issued tickets and free invitations for upcoming events will appear here'}}</text>
        <view class="main-return-btn pressable" hover-class="pressed-soft" hover-start-time="20" hover-stay-time="80" bindtap="goToFeed">
          <text class="main-return-btn-text">View Main</text>
        </view>
      </view>
      <view wx:else class="tickets-list">
        <view
          wx:for="{{visibleTickets}}"
          wx:key="_id"
          class="ticket-card {{item.isPast ? 'ticket-card-past' : ''}} pressable"
          hover-class="pressed"
          hover-start-time="20"
          hover-stay-time="80"
          bindtap="openTicketDetail"
          data-index="{{index}}"
        >
          <view class="ticket-info">
            <view class="ticket-meta">
              <view class="dot {{item.isPast ? 'dot-past' : ''}}"></view>
              <text class="ticket-date">{{item.eventDate}}</text>
              <text class="ticket-type {{item.isPast ? 'ticket-type-past' : ''}}">{{item.ticketKindLabel}}</text>
            </view>
            <text class="ticket-title ticket-title--meta-above {{item.isPast ? 'ticket-title-past' : ''}}">{{item.eventTitle}}</text>
            <text wx:if="{{item.venueName}}" class="ticket-venue">{{item.venueName}}</text>
            <view class="ticket-detail">
              <text class="ticket-detail-name">{{item.ticketName}}</text>
              <text wx:if="{{item.ticketDesc}}" class="ticket-detail-desc">{{item.ticketDesc}}</text>
              <text class="ticket-detail-price">{{item.priceText}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view class="list-bottom-pad"></view>
  </scroll-view>

  <!-- Past tickets keep the same details, without an expired check-in action. -->
  <view wx:if="{{detailTicket}}" class="td-mask" bindtap="closeTicketDetail">
    <view class="td-window" catchtap="stopPropagation">
      <view class="td-head">
        <text class="td-title">{{detailTicket.eventTitle}}</text>
        <text class="td-sub">{{detailTicket.venueName || 'Venue'}} · {{detailTicket.eventDate}}</text>
      </view>
      <view class="td-ticket">
        <text class="td-ticket-name">{{detailTicket.ticketKindLabel}} · {{detailTicket.ticketName}}</text>
        <text wx:if="{{detailTicket.ticketDesc}}" class="td-ticket-desc">{{detailTicket.ticketDesc}}</text>
        <text class="td-ticket-price">{{detailTicket.priceText}}</text>
        <text wx:if="{{detailTicket.promoterName}}" class="td-ticket-promoter">by {{detailTicket.promoterName}}</text>
      </view>
      <view class="td-actions">
        <view wx:if="{{!detailTicket.isPast}}" class="td-btn td-btn--scan" hover-class="pressed" hover-start-time="20" hover-stay-time="80" bindtap="scanFromDetail">
          <text class="td-btn-text td-btn-text--scan">Scan QR</text>
        </view>
        <view class="td-btn td-btn--cancel" hover-class="pressed" hover-start-time="20" hover-stay-time="80" bindtap="closeTicketDetail">
          <text class="td-btn-text">Close</text>
        </view>
      </view>
    </view>
  </view>

</view>
