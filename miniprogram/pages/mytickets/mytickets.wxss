@import '/miniprogram/app.wxss';

/* Page-specific styles for mytickets */

/* ===== PAST EVENTS CARD ===== */
.past-events-card {
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.past-events-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.past-events-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

.past-events-arrow {
  font-size: 44rpx;
  color: rgba(255,255,255,0.9);
}

.past-events-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: var(--text-secondary);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 10rpx;
}

.empty-sub {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
}

.tickets-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 32rpx;
}

.ticket-card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 16rpx var(--shadow-color);
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
}

.ticket-info {
  flex: 1;
}

.ticket-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.ticket-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #34c759;
  flex-shrink: 0;
}

.ticket-venue {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.ticket-time {
  font-size: 26rpx;
  font-weight: 600;
  color: #34c759;
  margin-left: 16rpx;
}

.ticket-actions {
  flex-shrink: 0;
}

.status-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.badge-arrived {
  background-color: rgba(52, 199, 89, 0.12);
  color: #34c759;
}

.badge-confirmed {
  background-color: var(--text-secondary);
  opacity: 0.15;
  color: var(--text-primary);
}
