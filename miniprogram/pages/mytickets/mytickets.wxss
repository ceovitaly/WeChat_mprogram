page {
  height: 100%;
  overflow: hidden;
  background: var(--bg);
}

.page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* Tabs */
.tabs {
  position: relative;
  display: flex;
  background: var(--bg-elevated);
  padding: 0 32rpx;
  flex-shrink: 0;
}

.tabs::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 0;
  height: 0.5px;
  background: var(--border);
}

.tab {
  position: relative;
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab:active { opacity: 0.7; }

.tab-active::after {
  content: '';
  position: absolute;
  left: 22%;
  right: 22%;
  bottom: 0;
  height: 5rpx;
  border-radius: 999rpx 999rpx 0 0;
  background: var(--accent);
  z-index: 1;
}

.tab-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.tab-active .tab-text {
  color: var(--accent);
  font-weight: 700;
}

/* Scroll */
.scroll {
  flex: 1;
  height: 0;
}

/* Loading */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  gap: 16rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.empty-sub {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.5;
}

/* Sign-in CTA in the signed-out empty state (same shape as feed's
   .empty-clear-btn) */
.signin-btn {
  margin-top: 8rpx;
  background: linear-gradient(135deg, #FF8F5E 0%, #FF6B35 100%);
  border-radius: 999rpx;
  height: 76rpx;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.signin-btn:active { opacity: 0.8; }

.signin-btn-text {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-action-btn {
  margin-top: 8rpx;
  height: 72rpx;
  padding: 0 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 107, 53, 0.35);
  border-radius: 999rpx;
  background: rgba(255, 107, 53, 0.08);
}

.empty-action-btn:active { opacity: 0.7; }

.empty-action-text {
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 700;
}

/* Tickets List */
.tickets-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx 24rpx 0;
}

.ticket-card {
  background: var(--bg-elevated);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
}

.ticket-card-past { opacity: 1; }

.ticket-info { flex: 1; min-width: 0; }

.ticket-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.ticket-title-past { color: var(--text-secondary); }

/* Both tabs use the same card geometry and ticket details. */
.ticket-title--meta-above { margin-top: 12rpx; }

.ticket-venue {
  display: block;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--text-secondary);
}

.ticket-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #34C759;
  flex-shrink: 0;
}

.dot-past { background: var(--text-secondary); }

.ticket-date {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.ticket-type {
  font-size: 26rpx;
  font-weight: 600;
  color: #34C759;
}

.ticket-type-past { color: var(--text-secondary); }

/* Ticket detail block — name / what's included / price, under the base rows */
.ticket-detail {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ticket-detail-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.ticket-detail-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

.ticket-detail-price {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent, #FF6B35);
}

/* Status Badge */
.status-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.badge-icon { font-size: 32rpx; }

.badge-arrived {
  background: rgba(52, 199, 89, 0.12);
  color: #34C759;
}

.badge-confirmed {
  background: rgba(0, 0, 0, 0.06);
  color: var(--text-secondary);
}

.badge-past {
  background: rgba(0, 0, 0, 0.06);
  color: var(--text-secondary);
}

.list-bottom-pad {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

/* ===== DARK MODE ===== */
/* Most colors flip automatically via the tokens above. Only genuinely
   page-local shades (out of the token palette, or diverging from the
   token's dark value) are overridden below. */
@media (prefers-color-scheme: dark) {
  .page { background: var(--bg); }

  .badge-confirmed { background: rgba(255,255,255,0.08); }
  .badge-past { background: rgba(255,255,255,0.06); }

}

/* ─── Door check-in scanner ─── */
/* Prominent CTA right under the tabs — the page's loudest action on purpose:
   at the door this is what the guest opens. Brand accent, scanner-frame icon. */
.scan-btn {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 20rpx 32rpx 8rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #FF8F5E 0%, #FF6B35 100%);
  border-radius: 24rpx;
  flex-shrink: 0;
}

.scan-btn:active { opacity: 0.85; }

.scan-btn-icon {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.scan-btn-corner {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-color: #FFFFFF;
  border-style: solid;
  border-width: 0;
}

.scan-btn-corner--tl { top: 0; left: 0; border-top-width: 4rpx; border-left-width: 4rpx; border-top-left-radius: 8rpx; }
.scan-btn-corner--tr { top: 0; right: 0; border-top-width: 4rpx; border-right-width: 4rpx; border-top-right-radius: 8rpx; }
.scan-btn-corner--bl { bottom: 0; left: 0; border-bottom-width: 4rpx; border-left-width: 4rpx; border-bottom-left-radius: 8rpx; }
.scan-btn-corner--br { bottom: 0; right: 0; border-bottom-width: 4rpx; border-right-width: 4rpx; border-bottom-right-radius: 8rpx; }

.scan-btn-line {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  top: 50%;
  height: 4rpx;
  margin-top: -2rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.9);
}

.scan-btn-texts {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.scan-btn-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.scan-btn-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}


/* ─── Ticket detail popup ──────────────────────────────────────────────── */
/* Full-screen dim backdrop; the window sits centered with generous side
   margins, square-rounded (24rpx) like the rest of the app. */
.td-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.td-window {
  width: 100%;
  background: var(--bg-elevated);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  box-sizing: border-box;
}

.td-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.td-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.td-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.td-ticket {
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.td-ticket-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.td-ticket-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

.td-ticket-price {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent);
}

.td-ticket-promoter {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* Shared ticket actions: Scan QR for active events and Close (neutral),
   square-rounded 76rpx like the rest of the app. */
.td-actions {
  display: flex;
  gap: 16rpx;
}

.td-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.td-btn--scan {
  background: var(--accent);
}

.td-btn--cancel {
  background: var(--bg-inset);
}

.td-btn-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.td-btn-text--scan {
  color: #FFFFFF;
}
