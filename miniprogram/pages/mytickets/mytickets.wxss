.container {
  background: #f8f9fa;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-top: env(safe-area-inset-top);
  box-sizing: border-box;
}

/* ===== HEADER ===== */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: calc(88rpx + env(safe-area-inset-top));
  padding-top: env(safe-area-inset-top);
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  z-index: 100;
  border-bottom: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.back-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  border-radius: 44rpx;
  box-sizing: border-box;
}

.back-icon {
  font-size: 48rpx;
  color: #1c1c1e;
  line-height: 1;
}

.back-text {
  font-size: 30rpx;
  color: #1c1c1e;
  font-weight: 500;
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.placeholder {
  width: 88rpx;
}

.content-wrapper {
  flex: 1;
  padding-top: calc(88rpx + env(safe-area-inset-top) + 32rpx);
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.bottom-spacer {
  height: calc(32rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: #999;
}

/* ===== PAST EVENTS CARD ===== */
.past-events-card {
  padding: 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.past-events-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.past-events-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.past-events-arrow {
  font-size: 40rpx;
  color: rgba(255,255,255,0.8);
}

.past-events-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.empty-sub {
  font-size: 28rpx;
  color: #999;
  text-align: center;
}

.tickets-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 32rpx;
}

.ticket-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.05);
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
}

.ticket-info {
  flex: 1;
}

.ticket-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
  display: block;
  margin-bottom: 12rpx;
}

.ticket-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #34c759;
  flex-shrink: 0;
}

.ticket-venue {
  font-size: 26rpx;
  color: #8e8e93;
  font-weight: 500;
}

.ticket-time {
  font-size: 26rpx;
  font-weight: 600;
  color: #34c759;
  margin-left: 16rpx;
}

.ticket-actions {
  flex-shrink: 0;
}

.status-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.badge-arrived {
  background: #f0fff4;
  color: #34c759;
}

.badge-confirmed {
  background: #f2f2f7;
  color: #c7c7cc;
}