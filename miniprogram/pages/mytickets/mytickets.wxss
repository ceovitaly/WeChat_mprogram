.page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: var(--page-bg);
}

/* ===== HEADER ===== */
.common-header {
  position: relative;
  height: calc(88rpx + env(safe-area-inset-top));
  padding-top: env(safe-area-inset-top);
  background-color: var(--page-bg);
  z-index: 100;
  flex-shrink: 0;
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  text-align: center;
  line-height: 88rpx;
  height: 88rpx;
}

.back-btn {
  position: absolute;
  left: 32rpx;
  bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  z-index: 101;
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
  fill: var(--text-primary);
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: var(--text-secondary);
}

/* ===== PAST EVENTS CARD ===== */
.past-events-card {
  padding: 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.past-events-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.past-events-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.past-events-arrow {
  font-size: 40rpx;
  color: rgba(255,255,255,0.8);
}

.past-events-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 10rpx;
}

.empty-sub {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
}

.tickets-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 32rpx;
}

.ticket-card {
  background: var(--card-bg);
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.05);
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
}

.ticket-info {
  flex: 1;
}

.ticket-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.ticket-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #34c759;
  flex-shrink: 0;
}

.ticket-venue {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.ticket-time {
  font-size: 26rpx;
  font-weight: 600;
  color: #34c759;
  margin-left: 16rpx;
}

.ticket-actions {
  flex-shrink: 0;
}

.status-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.badge-arrived {
  background: #f0fff4;
  color: #34c759;
}

.badge-confirmed {
  background: #f2f2f7;
  color: #c7c7cc;
}

.scroll-content {
  flex: 1;
  padding: 0 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}