.container {
  display: block;
  padding: 30rpx;
  padding-bottom: 60rpx;
  background: #f8f9fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  margin-bottom: 40rpx;
  padding: 20rpx 10rpx;
}

.header-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #1c1c1e;
  display: block;
}

.header-sub {
  font-size: 26rpx;
  color: #8e8e93;
  margin-top: 6rpx;
  display: block;
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.empty-sub {
  font-size: 28rpx;
  color: #999;
  text-align: center;
}

.tickets-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.ticket-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.05);
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
}

.ticket-info {
  flex: 1;
}

.ticket-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #1d1d1f;
  display: block;
  margin-bottom: 12rpx;
}

.ticket-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #34c759;
  flex-shrink: 0;
}

.ticket-venue {
  font-size: 26rpx;
  color: #8e8e93;
  font-weight: 500;
}

.ticket-time {
  font-size: 26rpx;
  font-weight: 600;
  color: #34c759;
  margin-left: 16rpx;
}

.ticket-actions {
  flex-shrink: 0;
}

.status-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.badge-arrived {
  background: #f0fff4;
  color: #34c759;
}

.badge-confirmed {
  background: #f2f2f7;
  color: #c7c7cc;
}