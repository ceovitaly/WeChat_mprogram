page {
  height: 100%;
  overflow: hidden;
  background: var(--bg);
}

.page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* Fixed Header */
.header {
  background: var(--bg-elevated);
  padding-top: calc(44rpx + env(safe-area-inset-top));
  padding-bottom: 0;
  border-bottom: 0.5px solid var(--border);
  flex-shrink: 0;
}

.header-top {
  display: flex;
  align-items: center;
  gap: 0;
  padding: 0 24rpx 20rpx;
}

/* Tabs */
.tabs {
  display: flex;
  padding: 0 32rpx 16rpx;
  gap: 8rpx;
}

.tab {
  height: 72rpx;
  padding: 0 32rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab:active { opacity: 0.7; }

/* Inverted high-contrast pill (black-on-white / white-on-black) — a
   one-off design distinct from the standard token pairs, left un-tokenized */
.tab-active {
  background: #1C1C1E;
}

.tab-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.tab-active .tab-text {
  color: #FFFFFF;
}

/* Scroll */
.scroll {
  flex: 1;
  height: 0;
}

/* Loading */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  gap: 16rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.empty-sub {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.5;
}

/* Sign-in CTA in the signed-out empty state (same shape as feed's
   .empty-clear-btn) */
.signin-btn {
  margin-top: 8rpx;
  background: var(--blue);
  border-radius: 14rpx;
  padding: 16rpx 40rpx;
}

.signin-btn:active { opacity: 0.8; }

.signin-btn-text {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}

/* Tickets List */
.tickets-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx 24rpx 0;
}

.ticket-card {
  background: var(--bg-elevated);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
}

.ticket-card-past { opacity: 0.55; }

.ticket-info { flex: 1; }

.ticket-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.ticket-title-past { color: var(--text-secondary); }

.ticket-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #34C759;
  flex-shrink: 0;
}

.dot-past { background: var(--text-secondary); }

.ticket-date {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.ticket-type {
  font-size: 26rpx;
  font-weight: 600;
  color: #34C759;
}

.ticket-type-past { color: var(--text-secondary); }

/* Status Badge */
.status-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.badge-icon { font-size: 32rpx; }

.badge-arrived {
  background: rgba(52, 199, 89, 0.12);
  color: #34C759;
}

.badge-confirmed {
  background: rgba(0, 0, 0, 0.06);
  color: var(--text-secondary);
}

.badge-past {
  background: rgba(0, 0, 0, 0.06);
  color: var(--text-secondary);
}

.list-bottom-pad {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

.ticket-remove-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 59, 48, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 20rpx;
  align-self: center;
}

.ticket-remove-btn:active { opacity: 0.6; }

.ticket-remove-icon {
  width: 28rpx;
  height: 28rpx;
  background-color: #FF3B30;
}

/* ===== DARK MODE ===== */
/* Most colors flip automatically via the tokens above. Only genuinely
   page-local shades (out of the token palette, or diverging from the
   token's dark value) are overridden below. */
@media (prefers-color-scheme: dark) {
  .page { background: var(--bg); }

  .tab { background: transparent; }
  .tab-active { background: #FFFFFF; }
  /* tab-text uses a dimmer gray than --text-secondary specifically in
     dark mode here, rather than the usual theme-invariant value */
  .tab-text { color: #636366; }
  .tab-active .tab-text { color: #1C1C1E; }

  .badge-confirmed { background: rgba(255,255,255,0.08); }
  .badge-past { background: rgba(255,255,255,0.06); }

  .ticket-remove-btn { background: rgba(255, 69, 58, 0.15); }
  .ticket-remove-icon { background-color: #FF453A; }
}
