page {
  height: 100%;
  overflow: hidden;
  background: #F2F2F7;
}

.page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* Fixed Header */
.header {
  background: #FFFFFF;
  padding-top: calc(44rpx + env(safe-area-inset-top));
  padding-bottom: 0;
  border-bottom: 0.5px solid #E5E5EA;
  flex-shrink: 0;
}

.header-top {
  display: flex;
  align-items: center;
  gap: 0;
  padding: 0 24rpx 20rpx;
}

/* Tabs */
.tabs {
  display: flex;
  padding: 0 32rpx 16rpx;
  gap: 8rpx;
}

.tab {
  height: 72rpx;
  padding: 0 32rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab:active { opacity: 0.7; }

.tab-active {
  background: #1C1C1E;
}

.tab-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #8E8E93;
}

.tab-active .tab-text {
  color: #FFFFFF;
}

/* Scroll */
.scroll {
  flex: 1;
  height: 0;
}

/* Loading */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  gap: 16rpx;
}

.empty-icon { font-size: 80rpx; }

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.empty-sub {
  font-size: 28rpx;
  color: #8E8E93;
  text-align: center;
  line-height: 1.5;
}

/* Tickets List */
.tickets-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx 24rpx 0;
}

.ticket-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
}

.ticket-card:active { opacity: 0.9; }

.ticket-card-past { opacity: 0.55; }

.ticket-info { flex: 1; }

.ticket-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1C1E;
  display: block;
  margin-bottom: 12rpx;
}

.ticket-title-past { color: #8E8E93; }

.ticket-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #34C759;
  flex-shrink: 0;
}

.dot-past { background: #8E8E93; }

.ticket-date {
  font-size: 26rpx;
  color: #8E8E93;
  font-weight: 500;
}

.ticket-type {
  font-size: 26rpx;
  font-weight: 600;
  color: #34C759;
}

.ticket-type-past { color: #8E8E93; }

/* Status Badge */
.status-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.badge-icon { font-size: 32rpx; }

.badge-arrived {
  background: rgba(52, 199, 89, 0.12);
  color: #34C759;
}

.badge-confirmed {
  background: rgba(0, 0, 0, 0.06);
  color: #8E8E93;
}

.badge-past {
  background: rgba(0, 0, 0, 0.06);
  color: #8E8E93;
}

.list-bottom-pad {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

.ticket-remove-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 59, 48, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 20rpx;
  align-self: center;
}

.ticket-remove-btn:active { opacity: 0.6; }

.ticket-remove-icon {
  font-size: 44rpx;
  color: #FF3B30;
  line-height: 1;
  font-weight: 300;
  margin-top: -4rpx;
}

/* ===== DARK MODE ===== */
@media (prefers-color-scheme: dark) {
  page { background: #000000; }
  .page { background: #000000; }

  .header { background: #1C1C1E; border-bottom-color: #38383A; }

  .tab { background: transparent; }
  .tab-active { background: #FFFFFF; }
  .tab-text { color: #636366; }
  .tab-active .tab-text { color: #1C1C1E; }

  .ticket-card { background: #1C1C1E; }
  .ticket-title { color: #FFFFFF; }
  .ticket-date { color: #8E8E93; }
  .badge-confirmed { background: rgba(255,255,255,0.08); }
  .badge-past { background: rgba(255,255,255,0.06); }

  .empty-title { color: #FFFFFF; }
  .ticket-remove-btn { background: rgba(255, 69, 58, 0.15); }
}
