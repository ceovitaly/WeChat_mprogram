.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.gallery-scroll {
  flex: 1;
  min-height: 0;
}

/* Two per row: space-between instead of gap (some base-library versions
   mis-handle gap in wrapped flex, collapsing to one tile per row). */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 24rpx 24rpx 0;
}

/* ─── Venue tiles ─── */
.tile {
  width: 48.5%;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--bg-inset);
  transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tile--pressed {
  transform: scale(0.97);
}

.tile-logo {
  width: 100%;
  height: 300rpx;
  display: block;
}

.tile-placeholder {
  width: 100%;
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tile-letter {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.tile-cap {
  padding: 16rpx 20rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.tile-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.tile-count {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* ─── Photos ─── */
.cell {
  width: 48.5%;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--bg-inset);
}

.cell-img {
  width: 100%;
  height: 440rpx;
  display: block;
}

.empty {
  padding: 160rpx 48rpx;
  display: flex;
  justify-content: center;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.bottom-pad {
  height: 48rpx;
}
