/* pages/register/index.wxss */

.page {
  height: 100%;
  background: #050505;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  overflow: hidden;
}

/* ─── Фон ─── */
.bg-gradient {
  position: fixed;
  top: -100px;
  left: -100px;
  right: -100px;
  height: 600px;
  background: radial-gradient(
    ellipse at 50% 20%,
    rgba(0, 122, 255, 0.18) 0%,
    rgba(0, 0, 0, 0) 70%
  );
  z-index: 0;
  pointer-events: none;
}

/* ─── Спиннер ─── */
.checking-wrap {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #050505;
  z-index: 10;
}

.spinner {
  width: 30px;
  height: 30px;
  border: 2.5px solid rgba(255, 255, 255, 0.12);
  border-top-color: #FFFFFF;
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ─── Логотип ─── */
.logo-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
  padding-top: 60px;
}

.logo-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}

.logo-main {
  font-size: 56px;
  font-weight: 900;
  color: #FFFFFF;
  letter-spacing: -1px;
  line-height: 1;
}

/* ─── Карточка ─── */
.card {
  position: relative;
  z-index: 1;
  width: 100%;
  background: rgba(28, 28, 30, 0.85);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-left: none;
  border-right: none;
  border-bottom: none;
  border-radius: 22px 22px 0 0;
  padding: 28px 22px 0;
  padding-bottom: calc(24px + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 0;
}

.card-title {
  font-size: 20px;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
  margin-bottom: 2px;
}

.card-desc {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.4);
  text-align: center;
  line-height: 1.55;
  margin-bottom: 18px;
}

/* ─── Кнопка входа ─── */
.btn-login {
  width: 100%;
  height: 52px;
  background: #007AFF;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

.btn-login::after { border: none; }

.btn-login-text {
  font-size: 16px;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 0.2px;
}

/* ─── Phone button wrapper ─── */
.btn-phone-wrap {
  width: 100%;
  margin: 0;
  padding: 0;
}
.btn-phone {
  width: 100%;
  min-height: 52px;
  background: #007AFF;
  border-radius: 14px;
  color: #ffffff;
  font-size: 15px;
  font-weight: 600;
  text-align: center;
  line-height: 1.35;
  margin: 0;
  padding: 14px 12px;
  box-sizing: border-box;
  display: block;
}
.btn-phone::after { border: none; }

/* ─── Слоган ─── */
.footer {
  position: relative;
  z-index: 1;
  padding: 16px 0 20px;
  margin-top: auto;
}

.footer-text {
  font-size: 11px;
  color: rgba(255, 255, 255, 0.15);
  letter-spacing: 1.5px;
}

/* ═══════════════════════════════════════════ */
/* ─── Маска + модалка ─── */
/* ═══════════════════════════════════════════ */

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #1C1C1E;
  border-radius: 22px 22px 0 0;
  padding: 12px 22px 32px;
  padding-bottom: calc(32px + constant(safe-area-inset-bottom));
  padding-bottom: calc(32px + env(safe-area-inset-bottom));
}

.sheet-handle {
  width: 36px;
  height: 4px;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 2px;
  margin: 0 auto 20px;
}

.sheet-title {
  display: block;
  font-size: 17px;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
  margin-bottom: 16px;
}

.sheet-body {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 22px;
}

.sheet-body-heading {
  font-size: 13px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.85);
}

.sheet-body-text {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.45);
  line-height: 1.65;
}

.sheet-actions {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.btn-agree {
  height: 52px;
  background: #FFFFFF;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-agree-text {
  font-size: 16px;
  font-weight: 600;
  color: #000000;
}

.btn-disagree {
  height: 52px;
  background: rgba(255, 255, 255, 0.07);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-disagree-text {
  font-size: 16px;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.5);
}

@media (prefers-color-scheme: dark) {
  .card {
    background: rgba(28, 28, 30, 0.95);
    border-color: rgba(255,255,255,0.1);
  }
  .sheet { background: #1C1C1E; }
  .sheet-body { background: rgba(255,255,255,0.06); }
}