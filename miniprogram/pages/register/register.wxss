page {
  height: 100%;
  background: #050505;
  overflow-y: auto;
}

.container {
  min-height: 100%;
  background: #050505;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ── Gradient ── */

.bg-gradient {
  position: fixed;
  top: -100px;
  left: -100px;
  right: -100px;
  height: 600px;
  background: radial-gradient(
    ellipse at 50% 20%,
    rgba(0, 122, 255, 0.18) 0%,
    rgba(0, 0, 0, 0) 70%
  );
  z-index: 0;
  pointer-events: none;
}

/* ── Logo ── */

.logo-wrap {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 80rpx;
  padding-bottom: 48rpx;
}

.logo-main {
  font-size: 96rpx;
  font-weight: 900;
  color: #FFFFFF;
  letter-spacing: -2rpx;
  line-height: 1;
}

/* ── Card ── */

.card {
  position: relative;
  z-index: 1;
  width: calc(100% - 64rpx);
  background: rgba(28, 28, 30, 0.85);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 44rpx;
  padding: 56rpx 44rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 0;
}

.card-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
}

.card-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.35);
  text-align: center;
  line-height: 1.55;
}

/* ── Inputs ── */

.input-group {
  display: flex;
  flex-direction: column;
}

.ios-input {
  height: 96rpx;
  background: rgba(255, 255, 255, 0.07);
  border-radius: 28rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  color: #FFFFFF;
  width: 100%;
  box-sizing: border-box;
}

.placeholder {
  color: rgba(255, 255, 255, 0.2);
  font-size: 30rpx;
}

/* ── Button ── */

/* House CTA geometry (76rpx / 999rpx pill / 28rpx / 600) — see app.wxss.
   This is a native <button> whose label is its own text node, so the
   label is centred with line-height rather than flexbox. Colour is the
   literal blue, not var(--blue): this screen is always dark. */
/* A plain view (see the WXML note) — same width/height/radius math as
   .ios-input, centred with flexbox. No own margins: the card's uniform
   24rpx gap handles the rhythm (title → description → inputs → button). */
.login-btn {
  height: 96rpx;
  background: #007AFF;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  width: 100%;
  box-sizing: border-box;
}

.login-btn--hover { opacity: 0.8; }

.login-btn--loading { opacity: 0.6; }

/* ── Footer ── */

/* margin-top:auto pins the block to the bottom of the full-height flex
   container — the credentials card stays centered near the top, the version
   always sits at the screen's foot. */
.footer {
  position: relative;
  z-index: 1;
  margin-top: auto;
  padding: 32rpx 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.version {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.15);
  letter-spacing: 3rpx;
  text-align: center;
}

.version--num {
  letter-spacing: 2rpx;
}
