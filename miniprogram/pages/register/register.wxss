/* pages/register/index.wxss */

/* Spacing rhythm (all vertical gaps are multiples of 8rpx): step head -> 40rpx
   to content, between field blocks 28rpx, CTA top gap 32rpx, quiet links
   28-36rpx. One orange CTA per screen; everything secondary is a text row. */

page {
  height: 100%;
  overflow-y: auto;
}

.page {
  min-height: 100%;
  background: #050505;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

/* ─── Фон ─── */
.bg-gradient {
  position: fixed;
  top: -100px;
  left: -100px;
  right: -100px;
  height: 600px;
  background: radial-gradient(
    ellipse at 50% 20%,
    rgba(0, 122, 255, 0.18) 0%,
    rgba(0, 0, 0, 0) 70%
  );
  z-index: 0;
  pointer-events: none;
}

/* ─── Спиннер ─── */
.checking-wrap {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #050505;
  z-index: 10;
}

.spinner {
  width: 30px;
  height: 30px;
  border: 2.5px solid rgba(255, 255, 255, 0.12);
  border-top-color: #FFFFFF;
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
}

/* @keyframes spin is defined once in app.wxss and shared app-wide */

/* ─── Логотип ─── */
.logo-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
  padding-top: 96rpx;
  min-height: 200rpx;
}

.logo-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}

.logo-main {
  font-size: 96rpx;
  font-weight: 900;
  color: #FFFFFF;
  letter-spacing: -1px;
  line-height: 1;
}

/* ─── Карточка ─── */
.card {
  position: relative;
  z-index: 1;
  width: 100%;
  background: rgba(28, 28, 30, 0.85);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-left: none;
  border-right: none;
  border-bottom: none;
  border-radius: 22px 22px 0 0;
  padding: 48rpx 32rpx 0;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ─── Прогресс (шаг 1 из 2 / 2 из 2) ─── */
/* Minimal 2-dot indicator: filled+widened dot marks the active step,
   filled dim dot marks a completed step, hollow dot marks an upcoming step. */
.progress-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 40rpx;
}

.progress-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.15);
  transition: background-color 0.25s ease, width 0.25s ease, opacity 0.25s ease;
}

.progress-dot-active {
  width: 28rpx;
  background: var(--accent);
}

.progress-dot-done {
  background: var(--accent);
  opacity: 0.5;
}

/* ─── Переход между шагами / режимами ─── */
/* Content swap fades + slides up with the same spring/overshoot easing used
   by the bottom-sheet component — fires for the step change AND for the
   wechat/manual sign-in mode switch inside step 1. */
.step-content {
  display: flex;
  flex-direction: column;
  animation: stepEnter 0.42s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes stepEnter {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ─── Заголовок шага ─── */
.step-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.card-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
  line-height: 1.2;
}

.card-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
  text-align: center;
  line-height: 1.55;
  margin-top: 12rpx;
}

/* ─── Главная кнопка (единственная оранжевая на экране) ─── */
.btn-primary {
  width: 100% !important;
  height: 88rpx;
  background: linear-gradient(135deg, #FF8F5E 0%, #FF6B35 100%);
  border-radius: 999rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 24rpx 0 0 !important;
  padding: 0 !important;
  box-sizing: border-box;
  line-height: 1;
}
.btn-primary::after { border: none; }

.btn-primary[disabled] {
  opacity: 0.4;
}

/* ─── Тихая строка-переключатель под CTA ─── */
/* Mode switch (wechat <-> manual): hint + accent link on one centered line,
   weight clearly below the CTA so the two never compete. */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 28rpx;
  padding: 8rpx 0;
}

.switch-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
}

.switch-link {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--accent);
  text-decoration: underline;
}

/* ─── Выход без входа ─── */
/* Demoted from a full-width button to a quiet link: it's an escape hatch,
   not an action we want to advertise with button chrome. */
.skip-link {
  display: flex;
  justify-content: center;
  margin-top: 36rpx;
  padding: 8rpx 0;
}

.skip-link-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
}

/* ─── Согласие на конфиденциальность ───
   Explicit opt-in row above the CTA: a tappable checkbox + caption, read
   before you agree rather than an implied "by continuing" notice. The whole
   row toggles the checkbox (bindtap on .consent-row); the two links use
   catchtap so tapping them navigates to the legal page without also flipping
   the checkbox via bubbling. */
.consent-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  box-sizing: border-box;
}

.consent-checkbox {
  flex-shrink: 0;
  width: 42rpx;
  height: 42rpx;
  margin-top: 2rpx;
  border: 2rpx solid var(--border);
  border-radius: 8rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: background-color 0.15s ease, border-color 0.15s ease;
}

.consent-checkbox--checked {
  background: var(--accent);
  border-color: var(--accent);
}

.consent-checkbox-mark {
  font-size: 26rpx;
  line-height: 1;
  color: #FFFFFF;
  font-weight: 700;
}

.consent-caption {
  flex: 1;
  text-align: left;
  line-height: 1.6;
}

.consent-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.consent-link {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent);
}

/* ─── Поля (шаг 2 и ручной ввод телефона) ─── */
.field-block {
  margin-bottom: 28rpx;
}

.field-label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.35);
  margin: 0 8rpx 12rpx;
}

.field-wrap {
  background: rgba(255, 255, 255, 0.07);
  border-radius: 24rpx;
  padding: 0 32rpx;
  height: 96rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.field-valid {
  border-color: #34C759;
  background: rgba(52, 199, 89, 0.08);
}

.field-input {
  flex: 1;
  font-size: 32rpx;
  font-weight: 500;
  color: #FFFFFF;
  height: 96rpx;
}

.field-placeholder {
  color: rgba(255, 255, 255, 0.25);
  font-weight: 400;
}

/* ─── Статус-текст под полем ─── */
/* Left-aligned with its field (not centered): the message refers to the
   input directly above it. */
.error-text {
  display: block;
  font-size: 24rpx;
  color: #FF453A;
  text-align: left;
  line-height: 1.5;
}

.success-text {
  display: block;
  font-size: 24rpx;
  color: #34C759;
  text-align: left;
  line-height: 1.5;
}

.field-status {
  margin: 12rpx 8rpx 0;
}

/* ─── Слоган ─── */
.footer {
  padding: 40rpx 0 8rpx;
  margin-top: auto;
  text-align: center;
}

.footer-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.15);
  letter-spacing: 3rpx;
}

@media (prefers-color-scheme: dark) {
  .card {
    background: rgba(28, 28, 30, 0.95);
    border-color: rgba(255,255,255,0.1);
  }
}

/* ─── Privacy-authorization sheet ───
   Content for the mandatory consent gate (see app.js
   onNeedPrivacyAuthorization / register.js showPrivacyModal). This is a
   standard bottom-sheet overlay, so unlike the page's own always-dark
   Welcome card above, it follows the same adaptive tokens (--bg-elevated,
   --text-primary, --border) as every other sheet in the app
   (event-detail's ticket-modal, me's name-sheet) for visual consistency. */
.privacy-modal {
  width: 100%;
  background: var(--bg-elevated);
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.modal-handle {
  width: 80rpx;
  height: 8rpx;
  background: var(--border);
  border-radius: 4rpx;
  margin: 0 auto 32rpx;
}

.privacy-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 16rpx;
}

.privacy-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.privacy-btn-outline {
  width: 100%;
  height: 76rpx;
  line-height: 72rpx;
  background: transparent;
  color: var(--accent);
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  border: 2rpx solid var(--accent);
  text-align: center;
  margin: 0 0 16rpx;
  padding: 0;
  box-sizing: border-box;
}
.privacy-btn-outline::after { border: none; }

.privacy-btn-primary {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  background: linear-gradient(135deg, #FF8F5E 0%, #FF6B35 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 999rpx;
  border: none;
  text-align: center;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
.privacy-btn-primary::after { border: none; }

.privacy-not-now {
  text-align: center;
  padding: 28rpx 0 4rpx;
}

.privacy-not-now text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

@media (prefers-color-scheme: dark) {
  .modal-handle { background: #3A3A3C; }
}
