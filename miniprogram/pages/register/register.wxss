page {
  height: 100%;
  background: #050505;
}

.container {
  height: 100%;
  background: #050505;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ── Gradient ── */

.bg-gradient {
  position: fixed;
  top: -100px;
  left: -100px;
  right: -100px;
  height: 600px;
  background: radial-gradient(
    ellipse at 50% 20%,
    rgba(0, 122, 255, 0.18) 0%,
    rgba(0, 0, 0, 0) 70%
  );
  z-index: 0;
  pointer-events: none;
}

/* ── Logo ── */

.logo-wrap {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 52px;
  padding-bottom: 28px;
}

.logo-main {
  font-size: 56px;
  font-weight: 900;
  color: #FFFFFF;
  letter-spacing: -1px;
  line-height: 1;
}

/* ── Card ── */

.card {
  position: relative;
  z-index: 1;
  width: calc(100% - 32px);
  background: rgba(28, 28, 30, 0.85);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 22px;
  padding: 28px 22px 24px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 0;
}

.card-title {
  font-size: 20px;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
}

.card-desc {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.35);
  text-align: center;
  line-height: 1.55;
  margin-bottom: 6px;
}

/* ── Inputs ── */

.input-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.input-label {
  font-size: 11px;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.35);
  letter-spacing: 1px;
  padding-left: 2px;
}

.ios-input {
  height: 52px;
  background: rgba(255, 255, 255, 0.07);
  border-radius: 14px;
  padding: 0 16px;
  font-size: 15px;
  color: #FFFFFF;
  width: 100%;
  box-sizing: border-box;
}

.placeholder {
  color: rgba(255, 255, 255, 0.2);
  font-size: 15px;
}

/* ── Button ── */

.login-btn {
  height: 52px;
  line-height: 52px;
  background: #007AFF;
  border-radius: 14px;
  text-align: center;
  color: #FFFFFF;
  font-size: 16px;
  font-weight: 600;
  border: none;
  margin: 4px 0 0;
  padding: 0;
  width: 100%;
  box-sizing: border-box;
}

.login-btn::after { border: none; }

.login-btn--loading { opacity: 0.6; }

/* ── Footer ── */

.footer {
  position: relative;
  z-index: 1;
  padding: 16px 0 20px;
}

.version {
  font-size: 11px;
  color: rgba(255, 255, 255, 0.15);
  letter-spacing: 1.5px;
}
