/* pages/register/index.wxss */

page {
  height: 100%;
  overflow-y: auto;
}

.page {
  min-height: 100%;
  background: #050505;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

/* ─── Фон ─── */
.bg-gradient {
  position: fixed;
  top: -100px;
  left: -100px;
  right: -100px;
  height: 600px;
  background: radial-gradient(
    ellipse at 50% 20%,
    rgba(0, 122, 255, 0.18) 0%,
    rgba(0, 0, 0, 0) 70%
  );
  z-index: 0;
  pointer-events: none;
}

/* ─── Спиннер ─── */
.checking-wrap {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #050505;
  z-index: 10;
}

.spinner {
  width: 30px;
  height: 30px;
  border: 2.5px solid rgba(255, 255, 255, 0.12);
  border-top-color: #FFFFFF;
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
}

/* @keyframes spin is defined once in app.wxss and shared app-wide */

/* ─── Логотип ─── */
.logo-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
  padding-top: 120rpx;
}

.logo-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}

.logo-main {
  font-size: 112rpx;
  font-weight: 900;
  color: #FFFFFF;
  letter-spacing: -1px;
  line-height: 1;
}

/* ─── Карточка ─── */
.card {
  position: relative;
  z-index: 1;
  width: 100%;
  background: rgba(28, 28, 30, 0.85);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-left: none;
  border-right: none;
  border-bottom: none;
  border-radius: 22px 22px 0 0;
  padding: 28px 22px 0;
  padding-bottom: calc(24px + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.card-title {
  font-size: 20px;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
  margin-bottom: 2px;
}

.card-desc {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.4);
  text-align: center;
  line-height: 1.55;
  margin-bottom: 18px;
}

/* ─── Главная кнопка ─── */
/* Primary onboarding CTA — brand emphasis, promoted from --blue to --accent */
.btn-phone-main {
  width: 100% !important;
  height: 96rpx;
  background: var(--accent);
  border-radius: 28rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 !important;
  padding: 0 !important;
  box-sizing: border-box;
}
.btn-phone-main::after { border: none; }

/* ─── Skip / Back ─── */
.btn-skip {
  width: 100%;
  height: 96rpx;
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 28rpx;
  border: 1px solid rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-skip-text {
  font-size: 32rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.75);
}

/* ─── Слоган ─── */
.footer {
  padding: 20px 0 4px;
  margin-top: auto;
  text-align: center;
}

.footer-text {
  font-size: 11px;
  color: rgba(255, 255, 255, 0.15);
  letter-spacing: 1.5px;
}

@media (prefers-color-scheme: dark) {
  .card {
    background: rgba(28, 28, 30, 0.95);
    border-color: rgba(255,255,255,0.1);
  }
}
