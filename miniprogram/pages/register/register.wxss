page {
  background: #F2F2F7;
}

.container {
  min-height: 100vh;
  background: #F2F2F7;
  display: flex;
  flex-direction: column;
  padding-top: 120rpx;
}

/* ── Header ── */

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx 60rpx;
}

.logo-wrap {
  width: 120rpx;
  height: 120rpx;
  background: #007AFF;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.logo-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.title {
  font-size: 52rpx;
  font-weight: 700;
  color: #000000;
  letter-spacing: -1rpx;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #8E8E93;
  text-align: center;
  line-height: 1.5;
}

/* ── Form ── */

.form {
  padding: 0 48rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.input-group {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.input-label {
  font-size: 22rpx;
  font-weight: 500;
  color: #8E8E93;
  letter-spacing: 1rpx;
  padding-left: 4rpx;
}

.ios-input {
  height: 96rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  color: #000000;
  width: 100%;
  box-sizing: border-box;
}

.placeholder {
  color: #C7C7CC;
  font-size: 30rpx;
}

.login-btn {
  height: 96rpx;
  line-height: 96rpx;
  background: #007AFF;
  border-radius: 16rpx;
  text-align: center;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-top: 16rpx;
  padding: 0;
  width: 100%;
  box-sizing: border-box;
}

.login-btn--loading {
  opacity: 0.7;
}

/* ── Footer ── */

.footer {
  padding: 48rpx 0 24rpx;
  display: flex;
  justify-content: center;
}

.version {
  font-size: 24rpx;
  color: #C7C7CC;
}

.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}