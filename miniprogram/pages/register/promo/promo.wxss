/* pages/register/promo/promo.wxss */
page {
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.page {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.bg-gradient {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  z-index: -1;
}

.logo-wrap {
  padding: 80rpx 40rpx 40rpx;
  display: flex;
  justify-content: center;
}

.logo-box {
  text-align: center;
}

.logo-main {
  display: block;
  font-size: 64rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 4rpx;
}

.logo-sub {
  display: block;
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 8rpx;
}

.card {
  margin: 40rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
}

.card-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1c1c1e;
  text-align: center;
  margin-bottom: 16rpx;
}

.card-desc {
  display: block;
  font-size: 26rpx;
  color: #8e8e93;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.promo-input-wrap {
  background: #f2f2f7;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.input-valid {
  border-color: #34c759;
  background: #f0faf4;
}

.promo-input {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  color: #1c1c1e;
  text-transform: uppercase;
}

.error-text {
  display: block;
  font-size: 26rpx;
  color: #ff3b30;
  text-align: center;
  margin-bottom: 20rpx;
}

.success-text {
  display: block;
  font-size: 26rpx;
  color: #34c759;
  text-align: center;
  margin-bottom: 20rpx;
}

.btn-submit {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #1c1c1e;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 48rpx;
  border: none;
  text-align: center;
  margin-top: 20rpx;
}

button[disabled] {
  background: #c7c7cc !important;
  color: #8e8e93 !important;
}

button::after {
  border: none;
}

.footer {
  margin-top: auto;
  padding: 40rpx;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}
