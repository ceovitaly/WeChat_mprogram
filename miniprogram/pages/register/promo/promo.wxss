/* pages/register/promo/promo.wxss */

page {
  height: 100%;
  overflow-y: auto;
}

.page {
  min-height: 100%;
  background: #050505;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

/* ─── Background glow ─── */
.bg-gradient {
  position: fixed;
  top: -100px;
  left: -100px;
  right: -100px;
  height: 600px;
  background: radial-gradient(
    ellipse at 50% 20%,
    rgba(0, 122, 255, 0.18) 0%,
    rgba(0, 0, 0, 0) 70%
  );
  z-index: 0;
  pointer-events: none;
}

/* ─── Logo ─── */
.logo-wrap {
  padding: 112rpx 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.logo-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.logo-main {
  font-size: 88rpx;
  font-weight: 900;
  color: #FFFFFF;
  letter-spacing: -1px;
  line-height: 1;
}

/* ─── Card ─── */
.card {
  position: relative;
  z-index: 1;
  width: calc(100% - 32px);
  background: rgba(28, 28, 30, 0.85);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 22px;
  padding: 28px 22px 24px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 20px;
}

.card-title {
  font-size: 20px;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
  margin-bottom: 2px;
}

.card-desc {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.4);
  text-align: center;
  line-height: 1.55;
  margin-bottom: 18px;
}

/* ─── Promo input ─── */
.promo-input-wrap {
  background: rgba(255, 255, 255, 0.07);
  border-radius: 28rpx;
  padding: 0 32rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.input-valid {
  border-color: #34C759;
  background: rgba(52, 199, 89, 0.08);
}

.promo-input {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: #FFFFFF;
  text-transform: uppercase;
}

.input-placeholder {
  color: rgba(255, 255, 255, 0.25);
  font-weight: 400;
  letter-spacing: 0;
}

/* ─── Status text ─── */
.error-text {
  display: block;
  font-size: 13px;
  color: #FF453A;
  text-align: center;
  margin-bottom: 4px;
}

.success-text {
  display: block;
  font-size: 13px;
  color: #34C759;
  text-align: center;
  margin-bottom: 4px;
}

/* ─── Submit button ─── */
/* Registration submit button — the explicit "primary CTA" example from the
   token task; promoted from --blue to --accent */
.btn-submit {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--accent);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 28rpx;
  border: none;
  margin-top: 16rpx;
  text-align: center;
  box-sizing: border-box;
  padding: 0;
  display: block;
}

button[disabled].btn-submit {
  background: rgba(255, 255, 255, 0.12) !important;
  color: rgba(255, 255, 255, 0.25) !important;
}

button::after {
  border: none;
}

/* ─── Footer ─── */
.footer {
  position: relative;
  z-index: 1;
  padding: 16px 0 20px;
}

.footer-text {
  font-size: 11px;
  color: rgba(255, 255, 255, 0.15);
  letter-spacing: 1.5px;
}

/* Fields */
.field-wrap {
  background: rgba(255, 255, 255, 0.07);
  border-radius: 28rpx;
  padding: 0 32rpx;
  height: 96rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.field-valid {
  border-color: #34C759;
  background: rgba(52, 199, 89, 0.08);
}

.field-input {
  flex: 1;
  font-size: 32rpx;
  font-weight: 500;
  color: #FFFFFF;
  height: 96rpx;
}

.field-placeholder {
  color: rgba(255, 255, 255, 0.25);
  font-weight: 400;
}
