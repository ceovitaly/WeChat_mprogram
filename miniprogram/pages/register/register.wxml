<view class="container">

<view class="bg-gradient" />

<view class="logo-wrap">
  <text class="logo-main">THE LIST</text>
</view>

<view class="card">
  <text class="card-title">Sign In</text>
  <text class="card-desc">Enter credentials provided by your administrator</text>

  <view class="input-group">
    <input
      class="ios-input"
      placeholder="Login"
      placeholder-class="placeholder"
      bindinput="onInputUser"
      value="{{username}}"
      confirm-type="next"
    />
  </view>

  <view class="input-group">
    <input
      class="ios-input"
      placeholder="Password"
      placeholder-class="placeholder"
      password
      bindinput="onInputPass"
      value="{{password}}"
      confirm-type="done"
      bindconfirm="handleLogin"
    />
  </view>

  <!-- Plain view, not a native <button>: the button component carries built-in
       WeChat UA margins that made it render narrower than the input rows no
       matter the overrides. A view shares the inputs' block geometry exactly;
       the JS loading guard replaces `disabled`. -->
  <view
    class="login-btn {{loading ? 'login-btn--loading' : ''}}"
    hover-class="login-btn--hover"
    bindtap="handleLogin"
  >{{loading ? 'Connecting...' : 'Sign In'}}</view>
</view>

<view class="footer">
  <text class="version">THE LIST | 2026</text>
  <text class="version version--num">v. 4.1</text>
</view>

</view>