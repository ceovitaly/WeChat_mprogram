<!-- pages/register/index.wxml -->
<view class="page">

<view class="bg-gradient" />

<!-- Spinner while checking session -->
<view wx:if="{{checking}}" class="checking-wrap">
  <view class="spinner" />
</view>

<block wx:else>

  <!-- Logo -->
  <view class="logo-wrap">
    <view class="logo-box">
      <text class="logo-main">THE LIST</text>
    </view>
  </view>

  <!-- Onboarding card: phone sign-in, then profile — one in-page step at a time -->
  <view class="card">

    <view class="progress-dots">
      <view class="progress-dot {{step === 'phone' ? 'progress-dot-active' : 'progress-dot-done'}}" />
      <view class="progress-dot {{step === 'profile' ? 'progress-dot-active' : ''}}" />
    </view>

    <block wx:if="{{step === 'phone'}}">
      <view class="step-content">
        <text class="card-title">Welcome</text>

        <view class="consent-row" bindtap="toggleConsent">
          <view class="consent-checkbox {{consentChecked ? 'consent-checkbox--checked' : ''}}">
            <text wx:if="{{consentChecked}}" class="consent-checkbox-mark">✓</text>
          </view>
          <view class="consent-caption">
            <text class="consent-text">I agree to the </text><text class="consent-link" catchtap="openPrivacyPolicy">Privacy Policy</text><text class="consent-text"> and </text><text class="consent-link" catchtap="openTermsOfService">Terms of Service</text>
          </view>
        </view>

        <button
          class="btn-phone-main"
          open-type="getPhoneNumber"
          bindgetphonenumber="onGetPhoneNumber"
          disabled="{{!consentChecked}}"
        >Sign In</button>

        <view class="btn-skip" bind:tap="goBack">
          <text class="btn-skip-text">Browse without signing in</text>
        </view>
      </view>
    </block>

    <block wx:elif="{{step === 'profile'}}">
      <view class="step-content">
        <text class="card-title">Your Profile</text>
        <text class="card-desc">Set your photo and name, then enter who invited you</text>

        <!-- Nickname -->
        <view class="field-wrap">
          <input
            class="field-input"
            type="nickname"
            value="{{nickName}}"
            bindinput="onNickNameInput"
            placeholder="Your name"
            placeholder-class="field-placeholder"
            maxlength="30"
          />
        </view>

        <!-- Promo code -->
        <view class="field-wrap {{promoValid ? 'field-valid' : ''}}">
          <input
            class="field-input"
            placeholder="Invite by"
            placeholder-class="field-placeholder"
            value="{{promoInput}}"
            bindinput="onPromoInput"
            maxlength="20"
            auto-capitalize="characters"
          />
        </view>

        <text wx:if="{{promoError}}" class="error-text">{{promoError}}</text>
        <text wx:if="{{promoValid}}" class="success-text">✓ Code accepted</text>

        <button
          class="btn-submit"
          bindtap="onSubmit"
          disabled="{{!promoInput || !nickName || submitting}}"
        >
          {{submitting ? 'Saving...' : promoValid ? 'Continue' : 'Verify & Join'}}
        </button>
      </view>
    </block>

    <view class="footer">
      <text class="footer-text">THE LIST · 2026</text>
    </view>

  </view>

</block>

</view>

<!-- Privacy-authorization sheet: WeChat's mandatory consent gate shown
     before getPhoneNumber fires (see app.js onNeedPrivacyAuthorization).
     Mask tap counts as "Not now" / disagree, same as every other sheet. -->
<bottom-sheet show="{{showPrivacyModal}}" bind:close="onDisagreePrivacyAuthorization">
  <view class="privacy-modal">
    <view class="modal-handle"></view>
    <text class="privacy-title">Your Privacy</text>
    <text class="privacy-desc">The List needs your phone number to verify your identity and complete registration. Please review our Privacy Policy before continuing.</text>
    <button
      class="privacy-btn-outline pressable"
      hover-class="pressed-soft"
      hover-start-time="20"
      hover-stay-time="80"
      open-type="openPrivacyContract"
    >View Privacy Policy</button>
    <button
      class="privacy-btn-primary pressable"
      hover-class="pressed"
      hover-start-time="20"
      hover-stay-time="80"
      open-type="agreePrivacyAuthorization"
      bindagreeprivacyauthorization="onAgreePrivacyAuthorization"
    >Agree and Continue</button>
    <view class="privacy-not-now pressable" hover-class="pressed-soft" hover-start-time="20" hover-stay-time="80" bindtap="onDisagreePrivacyAuthorization">
      <text>Not now</text>
    </view>
  </view>
</bottom-sheet>
