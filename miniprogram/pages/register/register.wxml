<!-- pages/register/index.wxml -->
<view class="page">

<view class="bg-gradient" />

<!-- Spinner while checking session -->
<view wx:if="{{checking}}" class="checking-wrap">
  <view class="spinner" />
</view>

<block wx:else>

  <!-- Logo -->
  <view class="logo-wrap">
    <view class="logo-box">
      <text class="logo-main">THE LIST</text>
    </view>
  </view>

  <!-- Login card -->
  <view class="card">
    <text class="card-title">Welcome</text>
    <text class="card-desc">Sign in to access events and tickets</text>

    <!-- Step 1: show Privacy button -->
    <view
      wx:if="{{!privacyAgreed}}"
      class="btn-login"
      bind:tap="onLoginTap"
    >
      <text class="btn-login-text">Sign in with WeChat</text>
    </view>

    <!-- Step 2: after agree — phone number button -->
    <button
      wx:else
      class="btn-phone"
      style="width:100%;margin:0;"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
    >Allow access to phone number</button>

  </view>

  <view class="footer">
    <text class="footer-text">THE LIST · 2026</text>
  </view>

</block>

<!-- Privacy Notice sheet -->
<view
  wx:if="{{showPrivacy}}"
  class="mask"
  bind:tap="onDisagree"
>
  <view class="sheet" catch:tap="noop">

    <view class="sheet-handle" />

    <text class="sheet-title">Privacy Notice</text>

    <view class="sheet-body">
      <text class="sheet-body-heading">Privacy Policy{{'\n\n'}}</text>
      <text class="sheet-body-text">Before using The List, please review our privacy policy. We use your data exclusively to provide the service — browsing events and getting tickets. By tapping "Accept" you agree to the terms.</text>
    </view>

    <view class="sheet-actions">
      <view class="btn-agree" bind:tap="onAgree">
        <text class="btn-agree-text">Accept</text>
      </view>
      <view class="btn-disagree" bind:tap="onDisagree">
        <text class="btn-disagree-text">Decline</text>
      </view>
    </view>

  </view>
</view>

</view>
