<view class="container">

<view class="bg-gradient" />

<view class="logo-wrap">
  <text class="logo-main">THE LIST</text>
</view>

<view class="card">
  <text class="card-title">Sign In</text>
  <text class="card-desc">Enter credentials provided by your administrator</text>

  <view class="input-group">
    <text class="input-label">LOGIN</text>
    <input
      class="ios-input"
      placeholder="Username"
      placeholder-class="placeholder"
      bindinput="onInputUser"
      value="{{username}}"
      confirm-type="next"
    />
  </view>

  <view class="input-group">
    <text class="input-label">PASSWORD</text>
    <input
      class="ios-input"
      placeholder="Password"
      placeholder-class="placeholder"
      password
      bindinput="onInputPass"
      value="{{password}}"
      confirm-type="done"
      bindconfirm="handleLogin"
    />
  </view>

  <button
    class="login-btn {{loading ? 'login-btn--loading' : ''}}"
    bindtap="handleLogin"
    disabled="{{loading}}"
  >{{loading ? 'Connecting...' : 'Sign In'}}</button>
</view>

<view class="footer">
  <text class="version">THE LIST · Admin · v2.0</text>
</view>

</view>