/* ===== FEED PAGE ===== */

page {
  height: 100%;
  overflow: hidden;
  background: var(--bg);
}

.page-container {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* ===== NAV BAR ===== */
/* Content-first redesign: the old avatar/search/calendar/my-list header
   row is gone entirely, freeing that vertical space for cards. What's
   left is a slim icon strip (Profile, Search, Tickets — each a direct
   one-tap nav button, no drawer), left-aligned clear of the WeChat
   capsule (top-right corner). A plain flex sibling ABOVE the
   scroll-view (feed.wxml), not nested inside it — .page-container is flex
   column, .feed-scroll is flex:1, so the nav-bar just takes its natural
   height in its own slot above the scrollable area. Always fully visible:
   no hide/reveal, no worklet, and it can't be dragged by pull-to-refresh
   since that only affects the scroll-view's own content. padding-top is
   set inline from feed.js (clears the WeChat capsule) — same mechanism
   the old .header used. No position/z-index needed — a normal flex item
   already stays put above the scroll-view; flex-shrink: 0 keeps it from
   being squeezed. Only box-shadow (the `scrolled` flag, a plain setData
   flip — see onFeedScroll) is transitioned here. */
.feed-nav {
  flex-shrink: 0;
  background: var(--bg-elevated);
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--border);
  transition: box-shadow 0.25s ease;
}

/* Subtle lift once the list is scrolled at all (scrolled flag) */
.feed-nav--scrolled {
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.08);
}

/* Segmented-control row: ONE unified pill outline around all three
   segments (Profile/Search/Lists), mimicking WeChat's own system capsule
   (the "..."/"o" pill, top-right). explicit height (navBarHeight, feed.js)
   equal to the WeChat capsule's own height, so the control lands in the
   same vertical band as the capsule (shares .feed-nav's padding-top).
   align-items is `stretch` (not `center`) so the divider borders added to
   each segment span the control's full height edge-to-edge; each
   segment centers its OWN label internally instead. border-radius:999rpx
   auto-clamps to a perfect pill regardless of height — no half-height
   math needed. overflow:hidden clips the flat-edged segments inside to
   the pill's rounded ends. background is deliberately omitted (falls
   through to .feed-nav's own var(--bg-elevated)) — no distinct fill,
   just the outline, per the WeChat capsule's own transparent look. */
.nav-seg-row {
  display: flex;
  align-items: stretch;
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  overflow: hidden;
}

/* Segments (Profile, Search, Lists) — text labels instead of the old
   per-button icon pills. No more individual background/border/radius;
   that all moved to .nav-seg-row above so the three segments read as
   ONE bar. Each segment centers its own label and gets a thin divider
   on the right EXCEPT the last one (border, not border-around, so it
   never doubles up with the outer pill's own border). flex:1 (not
   flex-shrink:0) so the three segments grow equally to fill the row's
   new bound width (navSegRowWidth, feed.js) — the row now stretches to
   fill the space between .feed-nav's left padding and the WeChat
   capsule's left edge (minus a small buffer), rather than sizing to its
   own text. Horizontal padding trimmed (0 12rpx) since equal-width
   segments no longer need generous padding to avoid a lopsided look
   between "Profile" and "Lists"; text-align: center on the label backs up
   the segment's own justify-content: center regardless of word length. */
.nav-seg {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  flex: 1;
}

.nav-seg:not(:last-child) {
  border-right: 1rpx solid var(--border);
}

.nav-seg-label {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--text-primary);
  white-space: nowrap;
  text-align: center;
}

/* ===== SEARCH PANEL ===== */
/* Expands DOWN from the nav-bar in place (not a separate page/route).
   Always rendered (never wx:if-removed) so max-height + opacity can
   actually transition — wx:if add/remove collapses instantly with no
   animation. `.search-panel--collapsed` is the resting (hidden) state;
   feed.js toggleSearchPanel() flips `showSearchPanel`, which removes that
   class in the WXML. NEEDS A VISUAL CHECK: the open max-height (160rpx) is
   sized to comfortably fit .search-bar's 80rpx height plus the panel's own
   padding — adjust if it clips or leaves too much empty space. */
.search-panel {
  flex-shrink: 0;
  overflow: hidden;
  max-height: 160rpx;
  opacity: 1;
  transition: max-height 0.28s ease, opacity 0.2s ease;
  background: var(--bg-elevated);
  border-bottom: 1rpx solid var(--border);
}

.search-panel--collapsed {
  max-height: 0;
  opacity: 0;
  border-bottom-width: 0;
}

.search-panel-inner {
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

/* Calendar Button — compact day+month mini-block */
.calendar-btn {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: var(--bg-inset);
  border: 1rpx solid var(--border);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

/* Active date filter — brand emphasis, not a system action */
.calendar-btn-active {
  background: var(--accent);
  border-color: var(--accent);
}

.calendar-btn-active .calendar-day-num,
.calendar-btn-active .calendar-label {
  color: #ffffff;
}

.calendar-day-num {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1;
}

.calendar-label {
  font-size: 18rpx;
  font-weight: 500;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

/* Search Bar */
.search-bar {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  background: var(--bg-inset);
  border-radius: 20rpx;
  border: 1rpx solid var(--border);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 12rpx;
}

.search-icon {
  width: 34rpx;
  height: 34rpx;
  background-color: var(--text-secondary);
}

.search-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
  background: transparent;
}

.search-placeholder {
  color: #C7C7CC;
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #C7C7CC;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.search-clear-icon {
  width: 26rpx;
  height: 26rpx;
  background-color: #ffffff;
}

/* Active Filter Pill — same "date filter active" state as .calendar-btn-active */
.filter-row {
  padding: 16rpx 24rpx 0;
}

.filter-pill {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 107, 53, 0.12);
  border: 1rpx solid var(--accent);
  border-radius: 32rpx;
  padding: 8rpx 20rpx;
}

.filter-pill-icon {
  width: 26rpx;
  height: 26rpx;
  background-color: var(--accent);
}

.filter-pill-txt {
  font-size: 26rpx;
  color: var(--accent);
  font-weight: 500;
}

.filter-pill-remove {
  width: 24rpx;
  height: 24rpx;
  background-color: var(--accent);
  margin-left: 4rpx;
}

/* ===== FEED SCROLL ===== */
.feed-scroll {
  flex: 1;
  height: 0;
}

/* Custom pull-to-refresh area (slot="refresher"): the scroll-view now
   starts BELOW the fixed header (a flex sibling above it, not inside it
   — see feed.wxml/.header), so this spinner area renders under the
   header rather than at the physical top of the screen. Still
   bottom-aligned inside a status-bar-tall area per refresherThreshold
   (feed.js) — worth a visual check in DevTools now that its position
   relative to the notch/header has shifted. Height comes inline from
   refresherThreshold (feed.js). */
.feed-refresher {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  box-sizing: border-box;
  padding-bottom: 16rpx;
}

.feed-refresher-spinner {
  width: 48rpx;
  height: 48rpx;
  border-width: 5rpx;
}

.event-list-container {
  padding: 24rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.list-bottom-pad {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

/* ===== EVENT CARD ===== */
.event-card {
  background: var(--bg-elevated);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid var(--bg-inset);
  /* Stagger entrance: per-card delay comes from item.animDelay (feed.js),
     computed alongside the other display fields on each event object.
     `backwards` (not `both`): a forwards fill would keep the keyframe's
     transform applied forever and override the hover-class press scale. */
  animation: cardIn 0.4s ease-out backwards;
}

@keyframes cardIn {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* Media — portrait ratio, height set dynamically via JS */
.card-media-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #1a1a1a;
}

.card-swiper {
  width: 100%;
  height: 100%;
}

/* Images fade in over the dark media-wrap placeholder once loaded
   (imgLoaded flag set by bindload in feed.js) instead of popping in */
.card-img {
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.card-img--loaded {
  opacity: 1;
}

/* Bottom vignette on the card image so the white venue chip text stays
   legible over bright photos (fixed dark rgba — works in both themes) */
.card-media-gradient {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 35%;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.45) 100%);
}

/* Date chip — top-left over the image. Plain translucent fill, no
   backdrop blur (inconsistent on Android in the classic engine). */
.card-date-chip {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  min-width: 84rpx;
  padding: 10rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  box-sizing: border-box;
}

.chip-day {
  font-size: 34rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1;
}

.chip-month {
  font-size: 18rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 1.5rpx;
  line-height: 1;
}

/* Venue chip — bottom-left over the gradient */
.card-venue-chip {
  position: absolute;
  left: 16rpx;
  bottom: 16rpx;
  max-width: calc(100% - 32rpx);
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(0, 0, 0, 0.35);
  border-radius: 32rpx;
  padding: 10rpx 20rpx 10rpx 14rpx;
  box-sizing: border-box;
}

.venue-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--accent);
  flex-shrink: 0;
}

.card-venue-chip-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 0.3rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.img-count-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 20rpx;
  padding: 6rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.img-count-txt {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 600;
}

.img-count-icon {
  width: 24rpx;
  height: 24rpx;
  background-color: #ffffff;
}

/* Card info — title only; date/venue moved onto the image chips */
.card-info {
  padding: 24rpx 32rpx 4rpx;
}

.card-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.25;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Get Ticket Button — primary brand CTA, full width under the title */
.card-btn-wrap {
  padding: 20rpx 32rpx 32rpx;
  display: flex;
  align-items: center;
}

.get-ticket-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
  background: var(--accent);
  color: #ffffff;
  border: none;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  letter-spacing: 0.5rpx;
}

/* Leading icon inside the CTA — tinted by the button's white text color */
.btn-list-icon {
  width: 30rpx;
  height: 30rpx;
}

.get-ticket-btn::after {
  border: none;
  display: none;
}

/* ===== SKELETON LOADING ===== */
.skeleton-card {
  background: var(--bg-elevated);
  border-radius: 24rpx;
  overflow: hidden;
}

.skeleton-img {
  width: 100%;
  height: 640rpx;
  background: linear-gradient(90deg, var(--bg-inset) 25%, var(--border) 50%, var(--bg-inset) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
}

.skeleton-body {
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, var(--bg-inset) 25%, var(--border) 50%, var(--bg-inset) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
}

.skeleton-line-lg {
  width: 75%;
  height: 40rpx;
}

.skeleton-btn {
  height: 88rpx;
  border-radius: 18rpx;
  background: linear-gradient(90deg, var(--bg-inset) 25%, var(--border) 50%, var(--bg-inset) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
  margin-top: 4rpx;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ===== EMPTY STATE ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx;
  gap: 20rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.empty-sub {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.5;
}

.empty-clear-btn {
  margin-top: 8rpx;
  background: var(--blue);
  border-radius: 14rpx;
  padding: 16rpx 40rpx;
}

.empty-clear-txt {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

/* ===== CALENDAR MODAL ===== */
/* Mask + slide-up/fade-in shell now provided by <bottom-sheet position="center">;
   this stays page-specific card styling for the calendar dialog's contents. */
.calendar-modal {
  width: 640rpx;
  background: var(--bg-elevated);
  border-radius: 32rpx;
  padding: 40rpx 32rpx 32rpx;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.18);
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.calendar-month-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.cal-nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg-inset);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-nav-btn:active {
  background: var(--border);
}

.cal-nav-txt {
  font-size: 40rpx;
  color: var(--blue);
  font-weight: 700;
  line-height: 1;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 32rpx;
}

/* 7 equal columns per row: 7 * flex-basis + 6 * gap = 100% */
.calendar-weekday {
  flex: 0 0 calc((100% - 48rpx) / 7);
  box-sizing: border-box;
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
  padding: 12rpx 0;
}

.calendar-day {
  flex: 0 0 calc((100% - 48rpx) / 7);
  box-sizing: border-box;
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  gap: 4rpx;
}

.calendar-day:active {
  background: var(--border);
  transform: scale(0.9);
}

.cal-day-num {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.cal-empty {
  visibility: hidden;
}

/* "Today" marker — a system fact, not a user selection; stays on --blue */
.cal-today {
  background: var(--blue);
}

.cal-today .cal-day-num {
  color: #ffffff;
  font-weight: 700;
}

/* User-picked date — same "active date" state as .calendar-btn-active/.filter-pill */
.cal-selected:not(.cal-today) {
  background: rgba(255, 107, 53, 0.12);
  border: 1rpx solid var(--accent);
}

.cal-selected:not(.cal-today) .cal-day-num {
  color: var(--accent);
  font-weight: 700;
}

.event-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--blue);
}

.cal-today .event-dot {
  background: rgba(255, 255, 255, 0.8);
}

/* Calendar actions */
.calendar-actions {
  display: flex;
  gap: 16rpx;
}

.cal-action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-action-btn:active {
  opacity: 0.75;
}

.cal-action-clear {
  background: var(--bg-inset);
}

.cal-action-done {
  background: var(--blue);
}

.cal-action-txt {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.cal-action-done-txt {
  color: #ffffff;
}

/* ===== REGISTERED BADGE ===== */
.registered-badge {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 4rpx;
}

.registered-badge-txt {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 0.3rpx;
}

/* ===== DARK MODE ===== */
/* Most colors flip automatically via the tokens above. Only genuinely
   page-local shades (out of the token palette, or diverging from the
   token's dark value) are overridden below. */
@media (prefers-color-scheme: dark) {
  /* Shadows don't read on a black page; the --border bottom line stays
     as the nav-bar's divider */
  .feed-nav--scrolled { box-shadow: none; }

  .search-placeholder { color: rgba(255,255,255,0.25); }
  .search-clear { background: #48484A; }

  /* Accent tint background needs its own dark-appropriate opacity */
  .filter-pill { background: rgba(255, 107, 53, 0.18); }

  .event-card { box-shadow: none; }

  .skeleton-img,
  .skeleton-line,
  .skeleton-btn {
    background: linear-gradient(90deg, #2C2C2E 25%, #3A3A3C 50%, #2C2C2E 75%);
    background-size: 200% 100%;
  }

  .calendar-modal { box-shadow: none; }
  .cal-selected:not(.cal-today) { background: rgba(255, 107, 53, 0.18); }
}
