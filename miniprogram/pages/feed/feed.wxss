/* ===== FEED PAGE ===== */

page {
  height: 100%;
  overflow: hidden;
  background: var(--bg);
}

.page-container {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* ===== HEADER ===== */
.header {
  background: var(--bg-elevated);
  padding-top: calc(44rpx + env(safe-area-inset-top));
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border);
  flex-shrink: 0;
  z-index: 100;
}

.header-top {
  padding: 0 32rpx 20rpx;
}

/* Nav Pills */
.header-nav-pills {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.nav-pill {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  background: var(--bg-inset);
  border-radius: 48rpx;
  padding: 10rpx 24rpx 10rpx 10rpx;
  border: 1rpx solid var(--border);
}

.nav-pill:active {
  background: var(--border);
  transform: scale(0.97);
}

.pill-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--border);
}

.pill-avatar-placeholder {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--blue);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pill-avatar-text {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}

.pill-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pill-icon {
  font-size: 30rpx;
  line-height: 1;
}

.pill-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* Search + Calendar Row */
.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 32rpx;
}

/* Calendar Button */
.calendar-btn {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: var(--bg-inset);
  border: 1rpx solid var(--border);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.calendar-btn:active {
  background: var(--border);
  transform: scale(0.95);
}

/* Active date filter — brand emphasis, not a system action */
.calendar-btn-active {
  background: var(--accent);
  border-color: var(--accent);
}

.calendar-btn-active .calendar-day-num,
.calendar-btn-active .calendar-label {
  color: #ffffff;
}

.calendar-day-num {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1;
}

.calendar-label {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

/* Search Bar */
.search-bar {
  flex: 1;
  height: 96rpx;
  background: var(--bg-inset);
  border-radius: 20rpx;
  border: 1rpx solid var(--border);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 12rpx;
}

.search-icon-txt {
  font-size: 34rpx;
  opacity: 0.5;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
  background: transparent;
}

.search-placeholder {
  color: #C7C7CC;
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #C7C7CC;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.search-clear-txt {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 700;
}

/* Active Filter Pill — same "date filter active" state as .calendar-btn-active */
.filter-row {
  padding: 16rpx 32rpx 0;
}

.filter-pill {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 107, 53, 0.12);
  border: 1rpx solid var(--accent);
  border-radius: 32rpx;
  padding: 8rpx 20rpx;
}

.filter-pill-txt {
  font-size: 26rpx;
  color: var(--accent);
  font-weight: 500;
}

.filter-pill-remove {
  font-size: 22rpx;
  color: var(--accent);
  font-weight: 700;
}

/* ===== FEED SCROLL ===== */
.feed-scroll {
  flex: 1;
  height: 0;
}

.event-list-container {
  padding: 24rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.list-bottom-pad {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

/* ===== EVENT CARD ===== */
.event-card {
  background: var(--bg-elevated);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid var(--bg-inset);
}

.event-card:active {
  transform: scale(0.99);
  opacity: 0.95;
}

/* Venue bar */
.card-venue-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 28rpx;
  background: var(--bg-inset);
  border-bottom: 1rpx solid var(--bg-inset);
}

.venue-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--accent);
  flex-shrink: 0;
}

.card-venue-bar-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #3A3A3C;
  letter-spacing: 0.3rpx;
}

/* Media — portrait ratio, height set dynamically via JS */
.card-media-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #1a1a1a;
}

.card-swiper {
  width: 100%;
  height: 100%;
}

.card-img {
  width: 100%;
  height: 100%;
  display: block;
}

.img-count-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 20rpx;
  padding: 6rpx 16rpx;
}

.img-count-txt {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 600;
}

/* Card info */
.card-info {
  padding: 28rpx 32rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card-datetime {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-secondary);
  letter-spacing: 0.3rpx;
}

.card-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.3;
}

/* Get Ticket Button — primary brand CTA */
.card-btn-wrap {
  padding: 0 32rpx 32rpx;
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.get-ticket-btn {
  flex: 1;
  display: block;
  height: 88rpx;
  background: var(--accent);
  color: #ffffff;
  border: none;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  line-height: 88rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  letter-spacing: 0.5rpx;
}

.get-ticket-btn::after {
  border: none;
  display: none;
}

.more-btn {
  flex-shrink: 0;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 32rpx;
  background: var(--bg-inset);
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 18rpx;
  border: none;
  text-align: center;
  margin: 0;
}

.more-btn::after {
  border: none;
}

/* ===== SKELETON LOADING ===== */
.skeleton-card {
  background: var(--bg-elevated);
  border-radius: 24rpx;
  overflow: hidden;
}

.skeleton-img {
  width: 100%;
  height: 640rpx;
  background: linear-gradient(90deg, var(--bg-inset) 25%, var(--border) 50%, var(--bg-inset) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
}

.skeleton-body {
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, var(--bg-inset) 25%, var(--border) 50%, var(--bg-inset) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
}

.skeleton-line-sm {
  width: 40%;
}

.skeleton-line-lg {
  width: 75%;
  height: 36rpx;
}

.skeleton-line-md {
  width: 55%;
}

.skeleton-btn {
  height: 88rpx;
  border-radius: 18rpx;
  background: linear-gradient(90deg, var(--bg-inset) 25%, var(--border) 50%, var(--bg-inset) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
  margin-top: 4rpx;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ===== EMPTY STATE ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx;
  gap: 20rpx;
}

.empty-icon {
  font-size: 96rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.empty-sub {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.5;
}

.empty-clear-btn {
  margin-top: 8rpx;
  background: var(--blue);
  border-radius: 14rpx;
  padding: 16rpx 40rpx;
}

.empty-clear-txt {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

/* ===== CALENDAR MODAL ===== */
/* Mask + slide-up/fade-in shell now provided by <bottom-sheet position="center">;
   this stays page-specific card styling for the calendar dialog's contents. */
.calendar-modal {
  width: 640rpx;
  background: var(--bg-elevated);
  border-radius: 32rpx;
  padding: 40rpx 32rpx 32rpx;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.18);
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.calendar-month-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.cal-nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg-inset);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-nav-btn:active {
  background: var(--border);
}

.cal-nav-txt {
  font-size: 40rpx;
  color: var(--blue);
  font-weight: 700;
  line-height: 1;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 32rpx;
}

/* 7 equal columns per row: 7 * flex-basis + 6 * gap = 100% */
.calendar-weekday {
  flex: 0 0 calc((100% - 48rpx) / 7);
  box-sizing: border-box;
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
  padding: 12rpx 0;
}

.calendar-day {
  flex: 0 0 calc((100% - 48rpx) / 7);
  box-sizing: border-box;
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  gap: 4rpx;
}

.calendar-day:active {
  background: var(--border);
  transform: scale(0.9);
}

.cal-day-num {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.cal-empty {
  visibility: hidden;
}

/* "Today" marker — a system fact, not a user selection; stays on --blue */
.cal-today {
  background: var(--blue);
}

.cal-today .cal-day-num {
  color: #ffffff;
  font-weight: 700;
}

/* User-picked date — same "active date" state as .calendar-btn-active/.filter-pill */
.cal-selected:not(.cal-today) {
  background: rgba(255, 107, 53, 0.12);
  border: 1rpx solid var(--accent);
}

.cal-selected:not(.cal-today) .cal-day-num {
  color: var(--accent);
  font-weight: 700;
}

.event-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--blue);
}

.cal-today .event-dot {
  background: rgba(255, 255, 255, 0.8);
}

/* Calendar actions */
.calendar-actions {
  display: flex;
  gap: 16rpx;
}

.cal-action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-action-btn:active {
  opacity: 0.75;
}

.cal-action-clear {
  background: var(--bg-inset);
}

.cal-action-done {
  background: var(--blue);
}

.cal-action-txt {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.cal-action-done-txt {
  color: #ffffff;
}

/* ===== REGISTERED BADGE ===== */
.registered-badge {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 4rpx;
}

.registered-badge-txt {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 0.3rpx;
}

/* ===== DARK MODE ===== */
/* Most colors flip automatically via the tokens above. Only genuinely
   page-local shades (out of the token palette, or diverging from the
   token's dark value) are overridden below. */
@media (prefers-color-scheme: dark) {
  .search-placeholder { color: rgba(255,255,255,0.25); }
  .search-clear { background: #48484A; }

  /* Accent tint background needs its own dark-appropriate opacity */
  .filter-pill { background: rgba(255, 107, 53, 0.18); }

  .event-card { box-shadow: none; }
  /* card-venue-bar's border reads as a real divider in dark mode (--border),
     not the barely-there bg-inset blend it uses in light mode */
  .card-venue-bar { border-bottom-color: var(--border); }

  .skeleton-img,
  .skeleton-line,
  .skeleton-btn {
    background: linear-gradient(90deg, #2C2C2E 25%, #3A3A3C 50%, #2C2C2E 75%);
    background-size: 200% 100%;
  }

  .calendar-modal { box-shadow: none; }
  .cal-selected:not(.cal-today) { background: rgba(255, 107, 53, 0.18); }
}
