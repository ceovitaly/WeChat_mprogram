/* Page-specific styles for feed */

/* Section Card with Gradient Background */
.section-card {
  margin: 0 32rpx 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  box-sizing: border-box;
}

.featured-card {
  padding: 24rpx;
}

.filter-card {
  padding: 24rpx;
}

.events-card {
  padding: 24rpx;
}

/* Section Title - Moved higher */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1c1c1e;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

/* Featured Slider */
.featured-swiper {
  width: 100%;
  height: 320rpx;
  box-sizing: border-box;
}

.slide-card {
  width: 100%;
  height: 100%;
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
}

.slide-image {
  width: 100%;
  height: 100%;
}

.slide-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 30rpx 30rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.slide-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.slide-date {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
}

.empty-state {
  text-align: center;
  color: #999;
  padding: 50rpx;
}

/* Compact Filter Section */
.filter-row {
  display: flex;
  gap: 16rpx;
}

.calendar-trigger {
  flex: 0 0 calc(50% - 8rpx);
}

.filter-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-sizing: border-box;
  min-height: 72rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}

.filter-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1c1e;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.filter-arrow {
  font-size: 24rpx;
  color: #c7c7cc;
  flex-shrink: 0;
  margin-left: 8rpx;
}

/* Search Input */
.search-input-wrapper {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
}

.search-input {
  width: 100%;
  height: 72rpx;
  padding: 0 72rpx 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1c1c1e;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}

.search-placeholder {
  color: #c7c7cc;
}

.search-icon {
  position: absolute;
  right: 24rpx;
  font-size: 32rpx;
  color: #c7c7cc;
  pointer-events: none;
}

/* Expandable Filter Panels */
.filter-panel {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  background: #fff;
  border-radius: 16rpx;
  margin-top: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.filter-panel.active {
  max-height: 500rpx;
  padding: 16rpx;
}

.option-item {
  padding: 20rpx 16rpx;
  font-size: 28rpx;
  color: #1c1c1e;
  border-radius: 12rpx;
  transition: background 0.2s;
}

.option-item.selected {
  background: #eafff0;
  color: #34c759;
  font-weight: 600;
}

.option-item:active {
  background: #f5f5f5;
}

/* Event List */
.event-list {
  /* Content flows naturally */
}

.event-card {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  box-sizing: border-box;
}

.event-card:last-child {
  margin-bottom: 0;
}

.event-img {
  width: 280rpx;
  height: 280rpx;
  flex-shrink: 0;
}

.event-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
}

.event-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.event-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 16rpx;
}

.event-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.buy-btn {
  background: #07c160;
  color: #fff;
  padding: 12rpx 30rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.event-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #1c1c1e;
}

.empty-list {
  text-align: center;
  color: #999;
  padding: 100rpx 32rpx;
}

.loading-mask {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0,0,0,0.7);
  color: #fff;
  padding: 20rpx 40rpx;
  border-radius: 10rpx;
  z-index: 2000;
}
