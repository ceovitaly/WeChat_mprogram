.container { 
  background: #f5f5f5; 
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-top: env(safe-area-inset-top);
  box-sizing: border-box;
}

/* Section Title */
.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  padding: 24rpx 32rpx 16rpx;
}

/* Featured Slider */
.featured-section {
  margin-bottom: 24rpx;
}

.featured-swiper {
  width: 100%;
  height: 320rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.slide-card {
  width: 100%;
  height: 100%;
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
}

.slide-image {
  width: 100%;
  height: 100%;
}

.slide-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 30rpx 30rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.slide-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.slide-date {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
}

.empty-state {
  text-align: center;
  color: #999;
  padding: 50rpx;
}

/* Compact Filter Section */
.filter-section {
  background: #fff;
  padding: 16rpx 32rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.filter-row {
  display: flex;
  gap: 12rpx;
}

.filter-trigger {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  gap: 8rpx;
  box-sizing: border-box;
  min-height: 72rpx;
}

.filter-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.filter-text {
  flex: 1;
  font-size: 24rpx;
  font-weight: 600;
  color: #1c1c1e;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.filter-arrow {
  font-size: 24rpx;
  color: #c7c7cc;
  flex-shrink: 0;
}

/* Expandable Filter Panels */
.filter-panel {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  background: #f8f9fa;
  border-radius: 16rpx;
  margin-top: 12rpx;
}

.filter-panel.active {
  max-height: 400rpx;
  padding: 16rpx;
}

.filter-options {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.filter-option {
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #1c1c1e;
  box-sizing: border-box;
}

.filter-option.selected {
  background: #eafff0;
  color: #34c759;
  font-weight: 600;
}

.filter-actions {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.filter-actions.visible {
  max-height: 100rpx;
  margin-top: 16rpx;
}

.filter-clear-btn {
  text-align: center;
  padding: 16rpx;
  background: #fff3f3;
  border-radius: 12rpx;
  color: #ff3b30;
  font-size: 26rpx;
  font-weight: 600;
}

/* Event List */
.event-list-section {
  padding: 0 32rpx;
  padding-bottom: 32rpx;
  box-sizing: border-box;
}

.event-list {
  /* Content flows naturally */
}

.event-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  box-sizing: border-box;
}

.event-img {
  width: 280rpx;
  height: 280rpx;
  flex-shrink: 0;
}

.event-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
}

.event-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.event-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 16rpx;
}

.event-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.buy-btn {
  background: #07c160;
  color: #fff;
  padding: 12rpx 30rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.event-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #1c1c1e;
}

.empty-list {
  text-align: center;
  color: #999;
  padding: 100rpx 32rpx;
}

.loading-mask {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0,0,0,0.7);
  color: #fff;
  padding: 20rpx 40rpx;
  border-radius: 10rpx;
  z-index: 2000;
}

/* Main Scroll View */
.main-scroll {
  flex: 1;
  padding-top: calc(env(safe-area-inset-top) + 32rpx);
  padding-bottom: 0;
  box-sizing: border-box;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

/* Bottom Spacer for Navigation Bar */
.bottom-spacer {
  height: calc(140rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

/* Bottom Navigation Bar */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  z-index: 1000;
  box-sizing: border-box;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.nav-icon-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #f8f9fa;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.nav-avatar {
  width: 100%;
  height: 100%;
}

.nav-icon-placeholder {
  font-size: 32rpx;
  color: #999;
}

.nav-ticket-icon {
  width: 44rpx;
  height: 44rpx;
}

.nav-label {
  font-size: 22rpx;
  color: #8e8e93;
  font-weight: 500;
}

/* Modal Styles */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-content {
  background: #fff;
  width: 85%;
  max-width: 600rpx;
  max-height: 70vh;
  border-radius: 32rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1c1c1e;
}

.modal-close {
  font-size: 40rpx;
  color: #8e8e93;
  padding: 10rpx;
}

.date-options,
.location-options,
.price-options {
  padding: 16rpx 0;
  overflow-y: auto;
  flex: 1;
}

.date-option,
.location-option,
.price-option {
  padding: 24rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f5f5f5;
  box-sizing: border-box;
}

.date-option:active,
.location-option:active,
.price-option:active {
  background: #f8f9fa;
}

.date-option.active,
.location-option.active,
.price-option.active {
  background: #eafff0;
}

.date-option.active text,
.location-option.active text,
.price-option.active text {
  color: #34c759;
  font-weight: 600;
}

.date-option text,
.location-option text,
.price-option text {
  font-size: 30rpx;
  color: #1c1c1e;
}
