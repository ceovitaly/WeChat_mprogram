/* ===== FEED PAGE ===== */

page {
  height: 100%;
  overflow: hidden;
  background: var(--bg);
}

.page-container {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* ===== NAV BAR ===== */
/* Content-first redesign: the old avatar/search/calendar/my-list header
   row is gone entirely, freeing that vertical space for cards. What's
   left is a slim icon strip (Profile, Search, Tickets — each a direct
   one-tap nav button, no drawer), left-aligned clear of the WeChat
   capsule (top-right corner). A plain flex sibling ABOVE the
   scroll-view (feed.wxml), not nested inside it — .page-container is flex
   column, .feed-scroll is flex:1, so the nav-bar just takes its natural
   height in its own slot above the scrollable area. Always fully visible:
   no hide/reveal, no worklet, and it can't be dragged by pull-to-refresh
   since that only affects the scroll-view's own content. padding-top is
   set inline from feed.js (clears the WeChat capsule) — same mechanism
   the old .header used. No position/z-index needed — a normal flex item
   already stays put above the scroll-view; flex-shrink: 0 keeps it from
   being squeezed. Only box-shadow (the `scrolled` flag, a plain setData
   flip — see onFeedScroll) is transitioned here. */
.feed-nav {
  position: relative;
  flex-shrink: 0;
  background: var(--bg-elevated);
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 12rpx;
  transition: box-shadow 0.25s ease;
}
.feed-nav::after {
  content: '';
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  height: 1rpx;
  background: var(--border);
}

/* Subtle lift once the list is scrolled at all (scrolled flag) */
.feed-nav--scrolled {
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.08);
}

/* Segmented-control row: ONE unified pill outline around all three
   segments (Profile/Search/Lists), mimicking WeChat's own system capsule
   (the "..."/"o" pill, top-right). explicit height (navBarHeight, feed.js)
   equal to the WeChat capsule's own height, so the control lands in the
   same vertical band as the capsule (shares .feed-nav's padding-top).
   align-items is `stretch` (not `center`) so the divider borders added to
   each segment span the control's full height edge-to-edge; each
   segment centers its OWN label internally instead. border-radius:999rpx
   auto-clamps to a perfect pill regardless of height — no half-height
   math needed. overflow:hidden clips the flat-edged segments inside to
   the pill's rounded ends. background is deliberately omitted (falls
   through to .feed-nav's own var(--bg-elevated)) — no distinct fill,
   just the outline, per the WeChat capsule's own transparent look. */
.nav-seg-row {
  display: flex;
  align-items: stretch;
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  overflow: hidden;
}

/* Segments (Profile, Search, Lists) — text labels instead of the old
   per-button icon pills. No more individual background/border/radius;
   that all moved to .nav-seg-row above so the three segments read as
   ONE bar. Each segment centers its own label and gets a thin divider
   on the right EXCEPT the last one (border, not border-around, so it
   never doubles up with the outer pill's own border). flex:1 (not
   flex-shrink:0) so the three segments grow equally to fill the row's
   new bound width (navSegRowWidth, feed.js) — the row now stretches to
   fill the space between .feed-nav's left padding and the WeChat
   capsule's left edge (minus a small buffer), rather than sizing to its
   own text. Horizontal padding trimmed (0 12rpx) since equal-width
   segments no longer need generous padding to avoid a lopsided look
   between "Profile" and "Lists"; text-align: center on the label backs up
   the segment's own justify-content: center regardless of word length. */
.nav-seg {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 0 12rpx;
  flex: 1;
}

/* Inset divider (not full-height border): a short, vertically-centered
   line via ::after instead of border-right, so it reads as a subtle
   in-between-segments hint rather than a hard edge-to-edge rule touching
   the pill's own top/bottom curve. */
.nav-seg:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 20%;
  bottom: 20%;
  width: 1rpx;
  background: var(--border);
}

/* Icon reinstated next to the label (see icon--user/--search/--list in
   app.wxss). Sized modestly below the label's font-size, since the
   segment's width is fixed by JS (navSegRowWidth / 3) and now has to fit
   icon + gap + text with no room to grow. */
.nav-seg-icon {
  width: 28rpx;
  height: 28rpx;
  background-color: var(--text-primary);
  flex-shrink: 0;
}

/* font-size trimmed 30rpx -> 28rpx: adding a 28rpx icon + 6rpx gap eats
   ~34rpx out of each already-fixed-width third, and "Profile"/"Search"
   were already the tightest-fitting labels at 30rpx. Dropping a touch
   keeps them comfortable next to the icon and the segment's own divider
   on narrower phone screens without needing to touch the width math in
   feed.js. */
.nav-seg-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  text-align: center;
}

/* ===== SEARCH PANEL ===== */
/* Expands DOWN from the nav-bar in place (not a separate page/route).
   Always rendered (never wx:if-removed) so max-height + opacity can
   actually transition — wx:if add/remove collapses instantly with no
   animation. `.search-panel--collapsed` is the resting (hidden) state;
   feed.js toggleSearchPanel() flips `showSearchPanel`, which removes that
   class in the WXML. Open max-height (120rpx) is tightened to real content
   height: .search-bar is 80rpx + .search-panel-inner's 16rpx top/bottom
   padding = 112rpx, plus a small ~8rpx buffer — a prior 160rpx value left a
   48rpx gap past the real content height, which made the max-height reveal
   finish well before the transition's duration elapsed (fast pop-in, then
   a lingering no-op "settle"), reading as jerky/uneven. Both transitioned
   properties now share duration + easing so they resolve in lockstep. */
.search-panel {
  position: relative;
  flex-shrink: 0;
  overflow: hidden;
  max-height: 120rpx;
  opacity: 1;
  transition: max-height 0.22s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.22s cubic-bezier(0.4, 0, 0.2, 1);
  background: var(--bg-elevated);
}
.search-panel::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 0;
  height: 1rpx;
  background: var(--border);
}

.search-panel--collapsed {
  max-height: 0;
  opacity: 0;
}
.search-panel--collapsed::after {
  opacity: 0;
}

.search-panel-inner {
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

/* Calendar Button — compact day+month mini-block */
.calendar-btn {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: var(--bg-inset);
  border: 1rpx solid var(--border);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

/* Active date filter — brand emphasis, not a system action */
.calendar-btn-active {
  background: var(--accent);
  border-color: var(--accent);
}

.calendar-btn-active .calendar-day-num,
.calendar-btn-active .calendar-label {
  color: #ffffff;
}

.calendar-day-num {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1;
}

.calendar-label {
  font-size: 18rpx;
  font-weight: 500;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

/* Search Bar */
.search-bar {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  background: var(--bg-inset);
  border-radius: 20rpx;
  border: 1rpx solid var(--border);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 12rpx;
}

.search-icon {
  width: 34rpx;
  height: 34rpx;
  background-color: var(--text-secondary);
}

.search-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
  background: transparent;
}

.search-placeholder {
  color: #C7C7CC;
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #C7C7CC;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.search-clear-icon {
  width: 26rpx;
  height: 26rpx;
  background-color: #ffffff;
}

/* Active Filter Pill — same "date filter active" state as .calendar-btn-active */
.filter-row {
  padding: 16rpx 24rpx 0;
}

.filter-pill {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 107, 53, 0.12);
  border: 1rpx solid var(--accent);
  border-radius: 32rpx;
  padding: 8rpx 20rpx;
}

.filter-pill-icon {
  width: 26rpx;
  height: 26rpx;
  background-color: var(--accent);
}

.filter-pill-txt {
  font-size: 26rpx;
  color: var(--accent);
  font-weight: 500;
}

.filter-pill-remove {
  width: 24rpx;
  height: 24rpx;
  background-color: var(--accent);
  margin-left: 4rpx;
}

/* ===== FEED SCROLL ===== */
.feed-scroll {
  flex: 1;
  height: 0;
}

/* Custom pull-to-refresh area (slot="refresher"): the scroll-view now
   starts BELOW the fixed header (a flex sibling above it, not inside it
   — see feed.wxml/.header), so this spinner area renders under the
   header rather than at the physical top of the screen. Still
   bottom-aligned inside a status-bar-tall area per refresherThreshold
   (feed.js) — worth a visual check in DevTools now that its position
   relative to the notch/header has shifted. Height comes inline from
   refresherThreshold (feed.js). */
.feed-refresher {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
}

/* Three-dot sequential-bounce refresh indicator, replacing the ring spinner.
   Pre-trigger state (pulling, refresher-triggered false): each dot's
   transform/opacity comes from an inline style driven by dotStyles
   (feed.js, computed continuously in onRefresherPulling from the pull
   distance) so the dots grow from small/faint to full-size as the user
   pulls. Once refresher-triggered flips true, .refresh-dot-active below
   takes over via the existing @keyframes refresh-dot-bounce — CSS
   animations take priority over a plain inline style while running, so
   this handoff is automatic with no JS coordination needed. */
.refresh-dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.refresh-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--accent);
  /* Baseline pre-pull look (progress 0): small/faint. Overridden per-dot by
     the inline style below while pulling, then superseded entirely by
     .refresh-dot-active's animation once triggered. */
  transform: scale(0.4);
  opacity: 0.25;
}

.refresh-dot-active {
  animation: refresh-dot-bounce 1.2s ease-in-out infinite;
}

.refresh-dot-active:nth-child(2) { animation-delay: 0.15s; }
.refresh-dot-active:nth-child(3) { animation-delay: 0.3s; }

@keyframes refresh-dot-bounce {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.5; }
  40% { transform: translateY(-12rpx); opacity: 1; }
}

.event-list-container {
  padding: 24rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.list-bottom-pad {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

/* ===== EVENT CARD ===== */
.event-card {
  background: var(--bg-elevated);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid var(--bg-inset);
  /* Stagger entrance: per-card delay comes from item.animDelay (feed.js),
     computed alongside the other display fields on each event object.
     `backwards` (not `both`): a forwards fill would keep the keyframe's
     transform applied forever and override the press-state transform.
     Easing is the same overshoot bezier used app-wide for the bottom-sheet
     and register-page consent-sheet springs (components/bottom-sheet/
     index.wxss, pages/register/register.wxss) — swapped in from ease-out
     for a springier "pop" on entrance. Pure CSS, zero new API surface. */
  animation: cardIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
  /* Card-specific press mechanism (replaces hover-class="pressed" on this
     element specifically — see feed.wxml/onCardTouchStart/onCardTouchEnd,
     feed.js). Rather than the shared .pressed's flat 0.16s ease transition
     (which has no overshoot and would double up awkwardly if stacked with
     a spring release), the card owns its own transform transition: fast/
     flat going down (.event-card--pressed below), but a trusted overshoot
     bezier — same curve used app-wide for the bottom-sheet/register
     consent-sheet springs (components/bottom-sheet/index.wxss,
     pages/register/register.wxss) — coming back up, so releasing the card
     visibly overshoots past scale(1) before settling. Pure CSS
     class-toggle via plain setData, no worklet. */
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* Touch-down state: quick, flat scale-down (no overshoot on the way in —
   only the release should spring). Magnitude (0.97) matches the shared
   .pressed class's 0.98 closely so it doesn't read as a jarringly
   different press depth from every other pressable element in the app. */
.event-card--pressed {
  transition: transform 0.12s ease;
  transform: scale(0.97);
}

@keyframes cardIn {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* Header row — venue (left) + date (right), plain text on the card's own
   background, sitting above the photo. Replaces the old overlaid
   date-chip/venue-chip and the gradient scrim that existed only to keep
   the venue-chip's white text legible over the photo. Horizontal padding
   (32rpx) matches .card-info's own horizontal inset so the header and
   the title below it stay aligned. */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 32rpx 18rpx;
}

.card-header-venue {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex-shrink: 1;
  min-width: 0;
}

.card-header-date {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent);
  flex-shrink: 0;
  white-space: nowrap;
}

/* Media — height set dynamically via JS as a min-height placeholder;
   mode="widthFix" (feed.wxml) derives the real height from each photo's
   own aspect ratio so nothing gets cropped. The title+CTA overlay
   (.card-poster-overlay) is absolutely positioned, so it doesn't add to
   this wrap's own document-flow height — the wrap's height is still driven
   purely by the <image>'s widthFix-computed size (or this min-height
   placeholder before it loads, currently 600rpx in feed.js — comfortably
   taller than the overlay's own content, ~270rpx, so overflow:hidden below
   never clips it pre-load). */
.card-media-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #1a1a1a;
}

.card-swiper {
  width: 100%;
  height: 100%;
}

/* Images fade in over the dark media-wrap placeholder once loaded
   (imgLoaded flag set by bindload in feed.js) instead of popping in */
.card-img {
  width: 100%;
  display: block;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.card-img--loaded {
  opacity: 1;
}

.img-count-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 20rpx;
  padding: 6rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.img-count-txt {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 600;
}

.img-count-icon {
  width: 24rpx;
  height: 24rpx;
  background-color: #ffffff;
}

/* Bottom scrim behind the title+CTA overlay — sized to cover the whole
   overlay area (not just a thin strip), since a two-line title AND a
   full-width button both need to stay legible over a bright/busy photo.
   Darkest at the very bottom where the button sits (solid dark is more
   forgiving behind text/button fills than a light gradient), fading to
   transparent well above the title so it doesn't visibly clip the photo. */
.card-poster-scrim {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 55%;
  background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0) 0%,
    rgba(0, 0, 0, 0.25) 40%,
    rgba(0, 0, 0, 0.55) 70%,
    rgba(0, 0, 0, 0.8) 100%
  );
  pointer-events: none;
}

/* Title + CTA overlay — absolutely positioned over the bottom of the photo
   (.card-media-wrap is already position:relative). Horizontal inset
   (32rpx) matches .card-header's own inset above the photo so everything
   stays aligned down the card. */
.card-poster-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
}

/* Card info — title only; date/venue live in .card-header above the photo.
   Now sits inside the photo overlay, so top padding just separates it from
   the top of the scrim rather than from the card's own background. */
.card-info {
  padding: 16rpx 32rpx 0;
}

/* Fixed white (not var(--text-primary)) — this text is always over the dark
   scrim now, not the card's own theme-following surface, so it must not
   flip with dark/light mode. Mirrors the old venue-chip precedent for
   over-photo text before the header-row restructure. */
.card-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.25;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Divider under the title, over the photo scrim — semi-transparent white
   (not var(--border), which is a light/dark surface token that would be
   invisible or wrong against a dark photo gradient). Sits inside
   .card-info's own 32rpx horizontal padding, so it's already inset
   relative to the card's outer edges without extra margin. */
.card-title-divider {
  width: 100%;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.25);
  margin-top: 24rpx;
}

/* Get Ticket Button — primary brand CTA, full width, last thing before the
   photo's bottom edge. Padding re-tuned from the old below-photo layout:
   less top padding (title sits closer above it now, tighter over the
   scrim) but bottom padding keeps real breathing room from the photo edge
   plus the card's rounded corner. */
.card-btn-wrap {
  padding: 24rpx 32rpx 28rpx;
  display: flex;
  align-items: center;
}

.get-ticket-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 76rpx;
  background: linear-gradient(135deg, #FF8F5E 0%, #FF6B35 100%);
  color: #ffffff;
  border: none;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  letter-spacing: 0.5rpx;
}

/* Leading icon inside the CTA — tinted by the button's white text color */
.btn-list-icon {
  width: 26rpx;
  height: 26rpx;
}

.get-ticket-btn::after {
  border: none;
  display: none;
}

/* ===== SKELETON LOADING ===== */
.skeleton-card {
  background: var(--bg-elevated);
  border-radius: 24rpx;
  overflow: hidden;
}

.skeleton-img {
  width: 100%;
  height: 640rpx;
  background: linear-gradient(90deg, var(--bg-inset) 25%, var(--border) 50%, var(--bg-inset) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
}

.skeleton-body {
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, var(--bg-inset) 25%, var(--border) 50%, var(--bg-inset) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
}

.skeleton-line-lg {
  width: 75%;
  height: 40rpx;
}

.skeleton-btn {
  height: 88rpx;
  border-radius: 18rpx;
  background: linear-gradient(90deg, var(--bg-inset) 25%, var(--border) 50%, var(--bg-inset) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
  margin-top: 4rpx;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ===== EMPTY STATE ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx;
  gap: 20rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.empty-sub {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.5;
}

.empty-clear-btn {
  margin-top: 8rpx;
  background: var(--blue);
  border-radius: 14rpx;
  padding: 16rpx 40rpx;
}

.empty-clear-txt {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

/* ===== CALENDAR MODAL ===== */
/* Mask + slide-up/fade-in shell now provided by <bottom-sheet position="center">;
   this stays page-specific card styling for the calendar dialog's contents. */
.calendar-modal {
  width: 640rpx;
  background: var(--bg-elevated);
  border-radius: 32rpx;
  padding: 40rpx 32rpx 32rpx;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.18);
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.calendar-month-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.cal-nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg-inset);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-nav-btn:active {
  background: var(--border);
}

.cal-nav-txt {
  font-size: 40rpx;
  color: var(--blue);
  font-weight: 700;
  line-height: 1;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 32rpx;
}

/* 7 equal columns per row: 7 * flex-basis + 6 * gap = 100% */
.calendar-weekday {
  flex: 0 0 calc((100% - 48rpx) / 7);
  box-sizing: border-box;
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
  padding: 12rpx 0;
}

.calendar-day {
  flex: 0 0 calc((100% - 48rpx) / 7);
  box-sizing: border-box;
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  gap: 4rpx;
}

.calendar-day:active {
  background: var(--border);
  transform: scale(0.9);
}

.cal-day-num {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.cal-empty {
  visibility: hidden;
}

/* "Today" marker — a system fact, not a user selection; stays on --blue */
.cal-today {
  background: var(--blue);
}

.cal-today .cal-day-num {
  color: #ffffff;
  font-weight: 700;
}

/* User-picked date — same "active date" state as .calendar-btn-active/.filter-pill */
.cal-selected:not(.cal-today) {
  background: rgba(255, 107, 53, 0.12);
  border: 1rpx solid var(--accent);
}

.cal-selected:not(.cal-today) .cal-day-num {
  color: var(--accent);
  font-weight: 700;
}

.event-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--blue);
}

.cal-today .event-dot {
  background: rgba(255, 255, 255, 0.8);
}

/* Calendar actions */
.calendar-actions {
  display: flex;
  gap: 16rpx;
}

.cal-action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-action-btn:active {
  opacity: 0.75;
}

.cal-action-clear {
  background: var(--bg-inset);
}

.cal-action-done {
  background: var(--blue);
}

.cal-action-txt {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.cal-action-done-txt {
  color: #ffffff;
}

/* ===== REGISTERED BADGE ===== */
.registered-badge {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 4rpx;
}

/* Fixed white/near-white (not var(--text-primary)) — plain text with a
   checkmark, no button fill of its own, now sitting over the photo+scrim
   like .card-title; must not flip with dark/light mode. */
.registered-badge-txt {
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  letter-spacing: 0.3rpx;
}

/* ===== DARK MODE ===== */
/* Most colors flip automatically via the tokens above. Only genuinely
   page-local shades (out of the token palette, or diverging from the
   token's dark value) are overridden below. */
@media (prefers-color-scheme: dark) {
  /* Shadows don't read on a black page; the --border bottom line stays
     as the nav-bar's divider */
  .feed-nav--scrolled { box-shadow: none; }

  .search-placeholder { color: rgba(255,255,255,0.25); }
  .search-clear { background: #48484A; }

  /* Accent tint background needs its own dark-appropriate opacity */
  .filter-pill { background: rgba(255, 107, 53, 0.18); }

  .event-card { box-shadow: none; }

  .skeleton-img,
  .skeleton-line,
  .skeleton-btn {
    background: linear-gradient(90deg, #2C2C2E 25%, #3A3A3C 50%, #2C2C2E 75%);
    background-size: 200% 100%;
  }

  .calendar-modal { box-shadow: none; }
  .cal-selected:not(.cal-today) { background: rgba(255, 107, 53, 0.18); }
}
