.container { 
  padding-bottom: 30rpx; 
  background: #f5f5f5; 
  min-height: 100vh; 
}

/* Custom Header with Avatar and Tickets */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-left, .header-right {
  display: flex;
  align-items: center;
}

.icon-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-img {
  width: 40rpx;
  height: 40rpx;
}

.avatar-wrapper {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f0f0f0;
}

.avatar {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #999;
}

/* Section Title */
.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  padding: 30rpx 30rpx 20rpx;
}

/* Featured Slider */
.featured-swiper {
  width: 100%;
  height: 400rpx;
  margin-bottom: 30rpx;
}

.slide-card {
  width: 100%;
  height: 100%;
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
}

.slide-image {
  width: 100%;
  height: 100%;
}

.slide-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 30rpx 30rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.slide-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.slide-date {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
}

.empty-state {
  text-align: center;
  color: #999;
  padding: 50rpx;
}

/* Date Strip */
.date-strip-container {
  background: #fff;
  padding: 20rpx 0;
  margin-bottom: 30rpx;
}

.date-strip {
  white-space: nowrap;
  padding: 0 30rpx;
}

.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  padding: 20rpx;
  margin-right: 20rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.date-item.active {
  background: #07c160;
  color: #fff;
}

.day-name {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.date-item.active .day-name {
  color: rgba(255,255,255,0.9);
}

.day-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.date-item.active .day-num {
  color: #fff;
}

/* Event List */
.event-list {
  padding: 0 30rpx;
}

.event-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.event-img {
  width: 280rpx;
  height: 280rpx;
  flex-shrink: 0;
}

.event-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.event-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.event-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 16rpx;
}

.event-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.buy-btn {
  background: #07c160;
  color: #fff;
  padding: 12rpx 30rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.empty-list {
  text-align: center;
  color: #999;
  padding: 100rpx 30rpx;
}

.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255,255,255,0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
