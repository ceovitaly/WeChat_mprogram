/* Page-specific styles for feed */

/* Fixed Header with Calendar and Search */
.feed-header {
  position: fixed;
  top: var(--safe-top);
  left: 0;
  right: 0;
  height: calc(88rpx + var(--safe-top));
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
  background-color: var(--header-bg);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  z-index: 100;
}

.header-left {
  display: flex;
  align-items: center;
}

.calendar-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--input-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx var(--shadow-color);
  transition: transform 0.2s;
}

.calendar-btn:active {
  transform: scale(0.95);
}

.calendar-icon {
  font-size: 40rpx;
}

.header-right {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  align-items: center;
}

.search-bar {
  flex: 1;
  height: 88rpx;
  background: var(--input-bg);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx var(--shadow-color);
}

.search-icon-inner {
  font-size: 36rpx;
  margin-right: 16rpx;
  color: var(--text-secondary);
}

.search-input-header {
  flex: 1;
  height: 100%;
  background: transparent;
  border: none;
  font-size: 30rpx;
  color: var(--text-primary);
}

.search-placeholder {
  color: var(--text-secondary);
}

/* Calendar Dropdown */
.calendar-dropdown {
  position: fixed;
  top: calc(88rpx + var(--safe-top) + 16rpx);
  left: 32rpx;
  right: 32rpx;
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 0;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease, padding 0.3s ease;
  box-shadow: 0 8rpx 32rpx var(--shadow-color);
  z-index: 99;
}

.calendar-dropdown.active {
  max-height: 600rpx;
  padding: 24rpx;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 12rpx;
}

.calendar-day {
  aspect-ratio: 1;
  background: var(--input-bg);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.calendar-day.selected {
  background: var(--primary-color);
}

.calendar-day.selected .calendar-day-num,
.calendar-day.selected .calendar-day-name {
  color: #fff;
}

.calendar-day-num {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.calendar-day-name {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* Scrollable Content Area */
.feed-scroll {
  flex: 1;
  padding-top: calc(88rpx + var(--safe-top) + 32rpx);
  padding-bottom: calc(160rpx + var(--safe-bottom));
  box-sizing: border-box;
  overflow: hidden;
  -webkit-overflow-scrolling: touch;
}

/* Event List Container */
.event-list-container {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* Premium Event Card */
.event-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx var(--shadow-color);
  transition: transform 0.2s;
}

.event-card:active {
  transform: scale(0.98);
}

.event-img {
  width: 100%;
  height: 400rpx;
  display: block;
}

.event-info {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.event-club-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.event-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.3;
}

.event-date-time {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-secondary);
}

.get-ticket-btn {
  width: 100%;
  height: 88rpx;
  background: var(--primary-color);
  color: #fff;
  border: none;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
  box-sizing: border-box;
}

.get-ticket-btn::after {
  border: none;
}

/* Empty State */
.empty-state-feed {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx;
  gap: 24rpx;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.empty-sub {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* Loading State */
.loading-feed {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
}
