/* Page-specific styles for feed */

/* Scrollable Content Area */
.feed-scroll {
  flex: 1;
  padding-top: calc(var(--safe-top) + 8rpx);
  padding-bottom: calc(160rpx + var(--safe-bottom));
  box-sizing: border-box;
  overflow: hidden;
  -webkit-overflow-scrolling: touch;
}

/* Event List Container */
.event-list-container {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* Premium Event Card */
.event-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx var(--shadow-color);
  transition: transform 0.2s;
}

.event-card:active {
  transform: scale(0.98);
}

.event-img {
  width: 100%;
  height: 400rpx;
  display: block;
}

.event-info {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.event-club-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.event-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.3;
}

.event-date-time {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-secondary);
}

.get-ticket-btn {
  width: 100%;
  height: 88rpx;
  background: var(--primary-color);
  color: #fff;
  border: none;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
  box-sizing: border-box;
}

.get-ticket-btn::after {
  border: none;
}

/* Empty State */
.empty-state-feed {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx;
  gap: 24rpx;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.empty-sub {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* Loading State */
.loading-feed {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
}
