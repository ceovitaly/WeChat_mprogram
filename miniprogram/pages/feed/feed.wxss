.container { 
  padding-bottom: 30rpx; 
  background: #ffffff; 
  min-height: 100vh; 
}

.header { 
  padding: 40rpx 30rpx 20rpx;
  font-size: 52rpx; 
  font-weight: 800; 
  color: #000; 
}

.event-wrapper {
  width: 100%;
  margin-bottom: 40rpx;
  background: #fff;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.image-box {
  width: 100%;
  height: 500rpx;
  overflow: hidden;
  border-radius: 30rpx;
}

.full-cover {
  width: 100%;
  height: 100%;
}

.cover-placeholder { 
  width: 100%; 
  height: 100%; 
  background: #f0f0f0; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  color: #ccc; 
}

.info-box {
  padding: 30rpx 10rpx 0;
}

.event-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  margin-bottom: 15rpx;
}

.event-meta {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  font-size: 28rpx;
  color: #888;
}

.loader, .empty { 
  text-align: center; 
  color: #999; 
  padding-top: 100rpx; 
}