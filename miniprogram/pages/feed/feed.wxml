<!--pages/feed/feed.wxml-->
<view class="page-container">

<!-- Nav bar: content-first redesign — the old avatar/search/calendar/my-list
     row is gone. This is now a single WeChat-capsule-style segmented control
     (Profile, Search, Lists text labels sharing one pill outline),
     left-aligned clear of the WeChat capsule (top-right), so cards start
     much higher on screen. A normal flex sibling ABOVE the scroll-view
     (not inside it), so it stays fully visible and fixed in place;
     pull-to-refresh only ever touches the scroll-view's own content.
     padding-top (navPadTop, feed.js) clears down to where the capsule
     starts; the inner .nav-seg-row gets an explicit height (navBarHeight)
     equal to the capsule's own height, so the segments land in exactly
     the same vertical band as the capsule instead of below it.
     `scrolled` (box-shadow only) is a plain setData class flip; see
     onFeedScroll. Profile and Tickets navigate directly
     (goToProfile/goToTickets, feed.js) — no drawer/intermediate step. -->
<view
  class="feed-nav {{scrolled ? 'feed-nav--scrolled' : ''}}"
  style="padding-top:{{navPadTop}}px"
>
  <view class="nav-seg-row" style="height:{{navBarHeight}}px; width:{{navSegRowWidth}}px">
    <view class="nav-seg pressable" hover-class="pressed" hover-start-time="20" hover-stay-time="80" bindtap="goToProfile">
      <view class="icon icon--user nav-seg-icon"></view>
      <text class="nav-seg-label">Profile</text>
    </view>
    <view class="nav-seg pressable" hover-class="pressed" hover-start-time="20" hover-stay-time="80" bindtap="toggleSearchPanel">
      <view class="icon icon--search nav-seg-icon"></view>
      <text class="nav-seg-label">Search</text>
    </view>
    <view class="nav-seg pressable" hover-class="pressed" hover-start-time="20" hover-stay-time="80" bindtap="goToTickets">
      <view class="icon icon--list nav-seg-icon"></view>
      <text class="nav-seg-label">Lists</text>
    </view>
  </view>
</view>

<!-- Search panel: expands DOWN from the nav-bar in place (not a separate
     page). Always rendered (not wx:if-removed) so the height/opacity
     transition below can actually animate instead of popping instantly;
     `search-panel--collapsed` is the resting (0-height) state. NEEDS A
     VISUAL CHECK in DevTools to confirm the max-height reveal feels
     smooth — the max-height value below is a generous guess covering the
     search-bar's rendered height plus its padding. -->
<view class="search-panel {{showSearchPanel ? '' : 'search-panel--collapsed'}}">
  <view class="search-panel-inner">
    <view class="search-bar">
      <view class="icon icon--search search-icon"></view>
      <input
        class="search-input"
        placeholder="Search events..."
        placeholder-class="search-placeholder"
        confirm-type="search"
        focus="{{showSearchPanel}}"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
        value="{{searchKeyword}}"
      />
      <view wx:if="{{searchKeyword}}" class="search-clear" bindtap="clearSearch">
        <view class="icon icon--close search-clear-icon"></view>
      </view>
    </view>
  </view>
</view>

<!-- Active filter pill — the calendar trigger button that used to set
     selectedDate has been removed from view (see feed.js/toggleCalendar),
     but selectedDate/selectedDateNum/selectedDateMonth/clearDateFilter and
     this pill all stay fully intact per the project owner's plan to wire
     up a new entry point later. Unreachable for now, harmless to leave
     rendered here (wx:if guards it, same as before). -->
  <view wx:if="{{selectedDate}}" class="filter-row">
    <view class="filter-pill pressable" hover-class="pressed" hover-start-time="20" hover-stay-time="80" bindtap="clearDateFilter">
      <view class="icon icon--calendar filter-pill-icon"></view>
      <text class="filter-pill-txt">{{selectedDate}}</text>
      <view class="icon icon--close filter-pill-remove"></view>
    </view>
  </view>

<!-- Scrollable Feed. -->
<scroll-view
  class="feed-scroll"
  scroll-y
  enhanced
  show-scrollbar="false"
  bindscroll="onFeedScroll"
  bindtouchstart="onFeedTouchStart"
  bindscrolltolower="onReachBottom"
  lower-threshold="200"
  refresher-enabled
  refresher-default-style="none"
  refresher-background="transparent"
  refresher-threshold="{{refresherThreshold}}"
  refresher-triggered="{{refreshing}}"
  bindrefresherrefresh="onPullDownRefresh"
  bindrefresherpulling="onRefresherPulling"
  bindrefresherrestore="onRefresherRestore"
>
  <!-- Custom refresher: the scroll-view now starts BELOW the fixed nav-bar
       (the nav-bar is a sibling above it, not inside it), so the spinner
       area sits under the nav-bar rather than at the physical top of the
       screen. Still bottom-aligned/status-bar-tall per refresherThreshold
       (feed.js) — NEEDS A VISUAL CHECK in DevTools to confirm the spinner
       still looks right now that the nav-bar above it is much shorter than
       the old header.

       Pre-trigger pull feedback (Task 1, this round): bindrefresherpulling
       fires continuously while the user drags down, before refresher-
       triggered flips true. Implemented as a PLAIN (non-worklet) handler —
       onRefresherPulling in feed.js — using ordinary setData, not
       worklet:bindrefresherpulling. Confidence note: binding a worklet to
       this specific attribute the same way worklet:onscroll was used
       earlier this session could not be verified without live DevTools
       (per the project owner's own caution about that prior, since-
       reverted attempt), so the safe non-worklet path was chosen
       deliberately here — a plain setData handler cannot crash the page,
       at worst it's a bit less silky-smooth than a worklet would be.
       dotStyles (feed.js) holds one inline transform/opacity string per
       dot, staggered so they don't all appear in unison; once
       refresher-triggered is true, refresh-dot-active's CSS keyframe
       (feed.wxss) takes over automatically (CSS animations win over a
       plain inline style while running) — no JS coordination needed for
       that handoff itself, but onPullDownRefresh also resets dotStyles
       back to baseline once refreshing begins, and onRefresherRestore
       resets them if the user lets go before triggering, so the dots
       don't get stuck mid-pull-progress. -->
  <view slot="refresher" class="feed-refresher" style="height:{{refresherThreshold}}px">
    <view class="refresh-dots">
      <view class="refresh-dot {{refreshing ? 'refresh-dot-active' : ''}}" style="{{refreshing ? '' : dotStyles[0]}}"></view>
      <view class="refresh-dot {{refreshing ? 'refresh-dot-active' : ''}}" style="{{refreshing ? '' : dotStyles[1]}}"></view>
      <view class="refresh-dot {{refreshing ? 'refresh-dot-active' : ''}}" style="{{refreshing ? '' : dotStyles[2]}}"></view>
    </view>
  </view>

  <view class="event-list-container">

    <!-- Loading skeleton -->
    <block wx:if="{{loading && events.length === 0}}">
      <view wx:for="{{[1,2,3]}}" wx:key="*this" class="skeleton-card">
        <view class="skeleton-img"></view>
        <view class="skeleton-body">
          <view class="skeleton-line skeleton-line-lg"></view>
          <view class="skeleton-btn"></view>
        </view>
      </view>
    </block>

    <!-- Event Cards -->
    <block wx:if="{{filteredEvents.length > 0}}">
      <!-- Press feedback (Task 2, this round): hover-class="pressed" (the
           shared, app-wide CSS-transition press mechanism — app.wxss) is
           deliberately NOT used on this element anymore; a card-specific
           spring mechanism replaces it (see .event-card/.event-card--pressed
           in feed.wxss and onCardTouchStart/onCardTouchEnd in feed.js) so
           the press-then-release feel is one cohesive spring, not the flat
           shared .pressed effect plus a second competing spring stacked on
           top. Implementation tier: CSS-bezier-fallback — plain touch
           handlers toggle a class via ordinary setData; the spring
           overshoot comes entirely from a CSS transition using the same
           cubic-bezier(0.34, 1.56, 0.64, 1) curve already trusted elsewhere
           in this app (bottom-sheet / register consent-sheet), not from a
           worklet. This tier was chosen over a worklet-driven approach
           because it is guaranteed to work without live DevTools
           verification. -->
      <view
        wx:for="{{filteredEvents}}"
        wx:key="_id"
        class="event-card {{pressedCardId === item._id ? 'event-card--pressed' : ''}}"
        style="animation-delay: {{item.animDelay}}ms"
        bindtap="goToDetail"
        bindtouchstart="onCardTouchStart"
        bindtouchend="onCardTouchEnd"
        bindtouchcancel="onCardTouchEnd"
        data-id="{{item._id}}"
      >
        <!-- Header row: venue (left) + date (right), plain text on the
             card's own background, sitting above the photo instead of
             overlaid on it. Replaces the old date-chip/venue-chip/gradient
             scrim that used to live inside .card-media-wrap. -->
        <view class="card-header">
          <text class="card-header-venue">{{item.venueName || 'Venue'}}</text>
          <text class="card-header-date">{{item.chipDay}} {{item.chipMonth}}</text>
        </view>

        <!-- Image; count badge (top-right) and the title+CTA overlay
             (bottom, .card-poster-overlay) both live inside this wrapper so
             they stack visually on top of the photo. Title/button used to be
             plain-background siblings below .card-media-wrap; they're now
             absolutely positioned children anchored to the wrap's bottom
             edge, over a dark gradient scrim (see .card-poster-scrim). -->
        <view class="card-media-wrap" style="min-height:{{cardImgHeight}}rpx">
          <image
            wx:if="{{item.promoImages[0]}}"
            src="{{item.promoImages[0]}}"
            mode="widthFix"
            class="card-img"
          />
          <view wx:else class="card-img-empty"></view>
          <view wx:if="{{item.promoImages.length > 1}}" class="img-count-badge">
            <text class="img-count-txt">{{item.promoImages.length}}</text>
            <view class="icon icon--camera img-count-icon"></view>
          </view>

          <!-- Bottom scrim + title/CTA overlay -->
          <view class="card-poster-scrim"></view>
          <view class="card-poster-overlay">
            <view class="card-info">
              <text class="card-title">{{item.title}}</text>
              <view class="card-title-divider"></view>
            </view>
            <view class="card-btn-wrap">
              <button
                wx:if="{{!item.isRegistered}}"
                class="get-ticket-btn pressable"
                hover-class="pressed"
                hover-start-time="20"
                hover-stay-time="80"
                catchtap="goToTicketDirect"
                data-id="{{item._id}}"
              >
                <view class="icon icon--list btn-list-icon"></view>
                <text>ADD ME ON GUESTS LIST</text>
              </button>
              <view
                wx:else
                class="registered-badge"
              >
                <text class="registered-badge-txt">✓ You're on the list</text>
              </view>
            </view>
          </view>
        </view>

      </view>
    </block>

    <!-- Empty State -->
    <view wx:if="{{filteredEvents.length === 0 && !loading}}" class="empty-state">
      <view class="icon icon--list icon-empty"></view>
      <text class="empty-title">No events found</text>
      <text class="empty-sub">Try adjusting your search or date filter</text>
      <view wx:if="{{selectedDate || searchKeyword}}" class="empty-clear-btn" bindtap="clearAllFilters">
        <text class="empty-clear-txt">Clear filters</text>
      </view>
    </view>

    <view class="list-bottom-pad"></view>
  </view>
</scroll-view>

<!-- Calendar Modal -->
<bottom-sheet show="{{showCalendar}}" position="center" bind:close="toggleCalendar">
  <view class="calendar-modal">
    <view class="calendar-header">
      <view class="cal-nav-btn" bindtap="prevMonth">
        <text class="cal-nav-txt">‹</text>
      </view>
      <text class="calendar-month-title">{{currentMonth}}</text>
      <view class="cal-nav-btn" bindtap="nextMonth">
        <text class="cal-nav-txt">›</text>
      </view>
    </view>
    <view class="calendar-grid">
      <view class="calendar-weekday" wx:for="{{weekdays}}" wx:key="*this">{{item}}</view>
      <view
        wx:for="{{calendarDays}}"
        wx:key="date"
        class="calendar-day {{item.isEmpty ? 'cal-empty' : ''}} {{item.isToday ? 'cal-today' : ''}} {{selectedDate === item.date ? 'cal-selected' : ''}} {{item.hasEvent ? 'cal-has-event' : ''}}"
        bindtap="selectDate"
        data-date="{{item.date}}"
      >
        <text class="cal-day-num">{{item.day}}</text>
        <view wx:if="{{item.hasEvent && !item.isEmpty}}" class="event-dot"></view>
      </view>
    </view>
    <view class="calendar-actions">
      <view class="cal-action-btn cal-action-clear" bindtap="clearDateFilter">
        <text class="cal-action-txt">Clear</text>
      </view>
      <view class="cal-action-btn cal-action-done" bindtap="toggleCalendar">
        <text class="cal-action-txt cal-action-done-txt">Done</text>
      </view>
    </view>
  </view>
</bottom-sheet>

</view>