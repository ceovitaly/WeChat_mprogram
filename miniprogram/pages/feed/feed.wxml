<!--pages/feed/feed.wxml-->
<view class="container">
  <!-- Fixed Header with Avatar and Tickets -->
  <view class="header">
    <view class="header-icons">
      <view class="icon-btn avatar-btn" bindtap="goToProfile">
        <image wx:if="{{userInfo && userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" mode="aspectFill" class="icon-img avatar" />
        <view wx:else class="avatar-placeholder">?</view>
      </view>
      <view class="icon-btn ticket-btn" bindtap="goToTickets">
        <image src="/images/ticket-icon.svg" mode="aspectFit" class="icon-img" />
      </view>
    </view>
  </view>
  
  <!-- Main Scrollable Content -->
  <scroll-view class="main-scroll" scroll-y enable-flex enhanced show-scrollbar="false" bindrefresherrefresh="onPullDownRefresh" refresher-triggered="{{loading}}">
    <!-- Featured Events Slider -->
    <view class="featured-section">
      <view class="section-title">Highlights</view>
      <swiper class="featured-swiper" indicator-dots autoplay circular interval="3000">
        <swiper-item wx:for="{{featuredEvents}}" wx:key="_id">
          <view class="slide-card" bindtap="goToDetail" data-id="{{item._id}}">
            <image src="{{item.promoImage || '/images/placeholder.png'}}" mode="aspectFill" class="slide-image" />
            <view class="slide-overlay">
              <text class="slide-title">{{item.title}}</text>
              <text class="slide-date">{{item.date}}</text>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <view wx:if="{{featuredEvents.length === 0 && !loading}}" class="empty-state">No featured events</view>
    </view>
  
    <!-- Filter Section -->
    <view class="filter-section">
      <view class="filter-row">
        <view class="filter-item" bindtap="showDateFilter">
          <text class="filter-label">Date</text>
          <text class="filter-value">{{selectedDate || 'Any'}}</text>
          <text class="filter-arrow">›</text>
        </view>
        <view class="filter-item" bindtap="showLocationFilter">
          <text class="filter-label">Location</text>
          <text class="filter-value">{{selectedLocation || 'Any'}}</text>
          <text class="filter-arrow">›</text>
        </view>
        <view class="filter-item" bindtap="showPriceFilter">
          <text class="filter-label">Price</text>
          <text class="filter-value">{{selectedPrice || 'Any'}}</text>
          <text class="filter-arrow">›</text>
        </view>
      </view>
      <view class="filter-clear" bindtap="clearFilters" wx:if="{{hasActiveFilters}}">
        <text class="clear-text">Clear Filters</text>
      </view>
    </view>
  
    <!-- Event List -->
    <view class="event-list-section">
      <view class="section-title">Upcoming Events</view>
      <view class="event-list">
        <view 
          wx:for="{{filteredEvents}}" 
          wx:key="_id" 
          class="event-card"
          bindtap="goToDetail"
          data-id="{{item._id}}"
        >
          <image src="{{item.promoImage || '/images/placeholder.png'}}" mode="aspectFill" class="event-img" />
          <view class="event-info">
            <text class="event-title">{{item.title}}</text>
            <view class="event-meta">
              <text class="event-date">📅 {{item.date}} | {{item.time}}</text>
              <text class="event-location">📍 {{item.venue || 'No location'}}</text>
            </view>
            <view class="event-footer">
              <text class="event-price">💰 {{item.price || 'TBA'}}</text>
              <text class="buy-btn">Buy Ticket</text>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{filteredEvents.length === 0 && !loading}}" class="empty-list">No events match your filters</view>
    </view>
    
    <!-- Loading -->
    <view wx:if="{{loading && events.length === 0}}" class="loading-mask">
      <text>Loading...</text>
    </view>
  </scroll-view>
</view>

<!-- Date Picker Modal -->
<view class="modal-overlay" wx:if="{{showDateModal}}" bindtap="hideDateModal">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">Select Date</text>
      <text class="modal-close" bindtap="hideDateModal">✕</text>
    </view>
    <view class="date-options">
      <view class="date-option {{selectedDate === '' ? 'active' : ''}}" bindtap="selectDateFilter" data-date="">
        <text>Any Date</text>
      </view>
      <view wx:for="{{dateList}}" wx:key="dateStr" class="date-option {{selectedDate === item.dateStr ? 'active' : ''}}" bindtap="selectDateFilter" data-date="{{item.dateStr}}">
        <text>{{item.dayName}}, {{item.dayNum}}</text>
      </view>
    </view>
  </view>
</view>

<!-- Location Picker Modal -->
<view class="modal-overlay" wx:if="{{showLocationModal}}" bindtap="hideLocationModal">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">Select Location</text>
      <text class="modal-close" bindtap="hideLocationModal">✕</text>
    </view>
    <view class="location-options">
      <view class="location-option {{selectedLocation === '' ? 'active' : ''}}" bindtap="selectLocationFilter" data-location="">
        <text>Any Location</text>
      </view>
      <view wx:for="{{uniqueLocations}}" wx:key="*this" class="location-option {{selectedLocation === item ? 'active' : ''}}" bindtap="selectLocationFilter" data-location="{{item}}">
        <text>{{item}}</text>
      </view>
    </view>
  </view>
</view>

<!-- Price Picker Modal -->
<view class="modal-overlay" wx:if="{{showPriceModal}}" bindtap="hidePriceModal">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">Select Price Range</text>
      <text class="modal-close" bindtap="hidePriceModal">✕</text>
    </view>
    <view class="price-options">
      <view class="price-option {{selectedPrice === '' ? 'active' : ''}}" bindtap="selectPriceFilter" data-price="">
        <text>Any Price</text>
      </view>
      <view class="price-option {{selectedPrice === 'free' ? 'active' : ''}}" bindtap="selectPriceFilter" data-price="free">
        <text>Free</text>
      </view>
      <view class="price-option {{selectedPrice === 'low' ? 'active' : ''}}" bindtap="selectPriceFilter" data-price="low">
        <text>Under $20</text>
      </view>
      <view class="price-option {{selectedPrice === 'medium' ? 'active' : ''}}" bindtap="selectPriceFilter" data-price="medium">
        <text>$20 - $50</text>
      </view>
      <view class="price-option {{selectedPrice === 'high' ? 'active' : ''}}" bindtap="selectPriceFilter" data-price="high">
        <text>Over $50</text>
      </view>
    </view>
  </view>
</view>
