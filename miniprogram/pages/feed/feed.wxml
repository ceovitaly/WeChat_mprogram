<!--pages/feed/feed.wxml-->
<view class="page-container">
  <!-- Unified Header -->
  <view class="common-header">
    <text class="header-title">Hot Offers</text>
  </view>

  <!-- Main Scrollable Content -->
  <scroll-view class="scroll-content" scroll-y enable-flex enhanced show-scrollbar="false" bindrefresherrefresh="onPullDownRefresh" refresher-triggered="{{loading}}">
    <!-- Featured Events Slider -->
    <view class="section">
      <swiper class="featured-swiper" indicator-dots autoplay circular interval="3000">
        <swiper-item wx:for="{{featuredEvents}}" wx:key="_id">
          <view class="slide-card" bindtap="goToDetail" data-id="{{item._id}}">
            <image src="{{item.promoImage || '/images/placeholder.png'}}" mode="aspectFill" class="slide-image" />
            <view class="slide-overlay">
              <text class="slide-title">{{item.title}}</text>
              <text class="slide-date">{{item.date}}</text>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <view wx:if="{{featuredEvents.length === 0 && !loading}}" class="empty-state">No featured events</view>
    </view>
  
    <!-- Compact Filter Section -->
    <view class="section">
      <view class="filter-row">
        <view class="filter-trigger" bindtap="toggleFilter" data-type="date">
          <text class="filter-text">{{selectedDate || 'Date'}}</text>
          <text class="filter-arrow">{{filterOpen === 'date' ? '▲' : '▼'}}</text>
        </view>
        <view class="filter-trigger" bindtap="toggleFilter" data-type="location">
          <text class="filter-text">{{selectedLocation || 'Location'}}</text>
          <text class="filter-arrow">{{filterOpen === 'location' ? '▲' : '▼'}}</text>
        </view>
        <view class="filter-trigger" bindtap="toggleFilter" data-type="price">
          <text class="filter-text">{{selectedPrice || 'Price'}}</text>
          <text class="filter-arrow">{{filterOpen === 'price' ? '▲' : '▼'}}</text>
        </view>
      </view>

      <!-- Expandable Filter Panels -->
      <view class="filter-panel {{filterOpen === 'date' ? 'active' : ''}}">
        <view class="option-item {{selectedDate === '' ? 'selected' : ''}}" bindtap="selectFilter" data-type="date" data-value="">Any Date</view>
        <view wx:for="{{dateList}}" wx:key="dateStr" class="option-item {{selectedDate === item.dateStr ? 'selected' : ''}}" bindtap="selectFilter" data-type="date" data-value="{{item.dateStr}}">
          {{item.dayName}}, {{item.dayNum}}
        </view>
      </view>

      <view class="filter-panel {{filterOpen === 'location' ? 'active' : ''}}">
        <view class="option-item {{selectedLocation === '' ? 'selected' : ''}}" bindtap="selectFilter" data-type="location" data-value="">Any Location</view>
        <view wx:for="{{uniqueLocations}}" wx:key="*this" class="option-item {{selectedLocation === item ? 'selected' : ''}}" bindtap="selectFilter" data-type="location" data-value="{{item}}">
          {{item}}
        </view>
      </view>

      <view class="filter-panel {{filterOpen === 'price' ? 'active' : ''}}">
        <view class="option-item {{selectedPrice === '' ? 'selected' : ''}}" bindtap="selectFilter" data-type="price" data-value="">Any Price</view>
        <view class="option-item {{selectedPrice === 'free' ? 'selected' : ''}}" bindtap="selectFilter" data-type="price" data-value="free">Free</view>
        <view class="option-item {{selectedPrice === 'low' ? 'selected' : ''}}" bindtap="selectFilter" data-type="price" data-value="low">Under $20</view>
        <view class="option-item {{selectedPrice === 'medium' ? 'selected' : ''}}" bindtap="selectFilter" data-type="price" data-value="medium">$20 - $50</view>
        <view class="option-item {{selectedPrice === 'high' ? 'selected' : ''}}" bindtap="selectFilter" data-type="price" data-value="high">Over $50</view>
      </view>

      <view class="filter-actions {{filterOpen ? 'visible' : ''}}">
        <view class="filter-clear-btn" bindtap="clearFilters">Clear Filters</view>
      </view>
    </view>
  
    <!-- Event List -->
    <view class="section">
      <view class="section-title">Upcoming Events</view>
      <view class="event-list">
        <view 
          wx:for="{{filteredEvents}}" 
          wx:key="_id" 
          class="event-card"
          bindtap="goToDetail"
          data-id="{{item._id}}"
        >
          <image src="{{item.promoImage || '/images/placeholder.png'}}" mode="aspectFill" class="event-img" />
          <view class="event-info">
            <text class="event-title">{{item.title}}</text>
            <view class="event-meta">
              <text class="event-date">📅 {{item.date}} | {{item.time}}</text>
              <text class="event-location">📍 {{item.venue || 'No location'}}</text>
            </view>
            <view class="event-footer">
              <text class="event-price">💰 {{item.price || 'TBA'}}</text>
              <text class="buy-btn">Buy Ticket</text>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{filteredEvents.length === 0 && !loading}}" class="empty-list">No events match your filters</view>
    </view>
    
    <!-- Loading -->
    <view wx:if="{{loading && events.length === 0}}" class="loading-mask">
      <text>Loading...</text>
    </view>
  </scroll-view>

  <!-- Floating Bottom Navigation -->
  <view class="floating-nav">
    <view class="nav-circle" bindtap="goToTickets">
      <image src="/images/ticket-icon.svg" mode="aspectFit" class="nav-icon" />
    </view>
    <view class="nav-circle" bindtap="goToProfile">
      <image wx:if="{{userInfo && userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" mode="aspectFill" class="nav-icon" style="border-radius: 50%;" />
      <text wx:else class="nav-icon-placeholder">?</text>
    </view>
  </view>
</view>
