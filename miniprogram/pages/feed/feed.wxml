<!--pages/feed/feed.wxml-->
<view class="page-container">
  <!-- Header Controls: Calendar Button + Search Bar -->
  <view class="header-controls">
    <view class="calendar-btn" bindtap="toggleCalendar">
      <text class="calendar-icon">📅</text>
    </view>
    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="Search events..." confirm-type="search" bindconfirm="onSearch" />
    </view>
  </view>

  <!-- Main Scrollable Content -->
  <scroll-view 
    class="scroll-content feed-scroll" 
    scroll-y 
    enable-flex 
    enhanced 
    show-scrollbar="false" 
    bindrefresherrefresh="onPullDownRefresh" 
    refresher-triggered="{{loading}}"
    bounces="false"
  >
    <!-- Event List -->
    <view class="event-list-container">
      <view 
        wx:for="{{filteredEvents}}" 
        wx:key="_id" 
        class="event-card"
        bindtap="goToDetail"
        data-id="{{item._id}}"
      >
        <image src="{{item.promoImage || '/images/placeholder.png'}}" mode="aspectFill" class="event-img" />
        <view class="event-info">
          <text class="event-club-name">{{item.venue || 'CLUB NAME'}}</text>
          <text class="event-title">{{item.title}}</text>
          <text class="event-date-time">{{item.date}} • {{item.time}}</text>
          <button class="get-ticket-btn" bindtap="goToDetail" data-id="{{item._id}}">Get Ticket</button>
        </view>
      </view>
      
      <!-- Empty State -->
      <view wx:if="{{filteredEvents.length === 0 && !loading}}" class="empty-state-feed">
        <text class="empty-icon">🎫</text>
        <text class="empty-title">No events found</text>
        <text class="empty-sub">Try adjusting your search or date filter</text>
      </view>
      
      <!-- Loading -->
      <view wx:if="{{loading && events.length === 0}}" class="loading-feed">
        <text>Loading events...</text>
      </view>
    </view>
  </scroll-view>

  <!-- Floating Bottom Navigation -->
  <view class="floating-nav">
    <view class="nav-circle" bindtap="goToTickets">
      <image src="/images/ticket-icon.svg" mode="aspectFit" class="nav-icon" />
    </view>
    <view class="nav-circle" bindtap="goToProfile">
      <image wx:if="{{userInfo && userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" mode="aspectFill" class="nav-icon" style="border-radius: 50%;" />
      <text wx:else class="nav-icon-placeholder">?</text>
    </view>
  </view>

  <!-- Calendar Modal -->
  <view wx:if="{{showCalendar}}" class="modal-overlay" bindtap="toggleCalendar">
    <view class="calendar-modal" catchtap="stopPropagation">
      <view class="calendar-header">
        <text class="calendar-month">{{currentMonth}}</text>
      </view>
      <view class="calendar-grid">
        <view class="calendar-weekday">Sun</view>
        <view class="calendar-weekday">Mon</view>
        <view class="calendar-weekday">Tue</view>
        <view class="calendar-weekday">Wed</view>
        <view class="calendar-weekday">Thu</view>
        <view class="calendar-weekday">Fri</view>
        <view class="calendar-weekday">Sat</view>
        <view 
          wx:for="{{calendarDays}}" 
          wx:key="date"
          class="calendar-day {{item.isToday ? 'today' : ''}} {{selectedDate === item.date ? 'selected' : ''}} {{item.isEmpty ? 'empty' : ''}}"
          bindtap="selectDate"
          data-date="{{item.date}}"
        >
          {{item.day}}
        </view>
      </view>
    </view>
  </view>
</view>
