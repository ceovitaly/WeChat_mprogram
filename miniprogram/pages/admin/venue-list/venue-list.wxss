page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.page {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.scroll-content {
  flex: 1;
  height: 0;
}

.nav-bar {
  background: var(--bg-card);
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 0.5px solid var(--border);
  flex-shrink: 0;
}

.nav-bar:active { background: var(--bg); }

.nav-add-text {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--blue);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  gap: 20rpx;
}

.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 28rpx; color: #8E8E93; }

.empty-btn {
  margin-top: 8rpx;
  padding: 16rpx 40rpx;
  background: var(--blue);
  border-radius: 20rpx;
}

.empty-btn-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.item-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  overflow: hidden;
}

.item-top {
  display: flex;
  align-items: center;
  padding: 28rpx;
  gap: 20rpx;
  border-bottom: 0.5px solid var(--bg);
}

.item-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #E8F0FB;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.venue-logo-img {
  width: 88rpx;
  height: 88rpx;
}

.item-avatar-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #185FA5;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: hidden;
}

.item-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.item-sub {
  font-size: 28rpx;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-actions {
  display: flex;
}

.action-btn {
  flex: 1;
  padding: 22rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  border-right: 0.5px solid var(--bg);
}

.action-btn:last-child { border-right: none; }
.action-btn:active { opacity: 0.6; }

.action-btn--primary { color: var(--blue); }
.action-btn--danger { color: var(--red); }

.safe-area-bottom {
  height: calc(32rpx + env(safe-area-inset-bottom));
}
