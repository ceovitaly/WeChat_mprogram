.page {
  height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.scroll {
  flex: 1;
  height: 0;
}

.section {
  padding: 24rpx 24rpx 0;
}

.date-filter-row {
  margin: 20rpx 0 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.date-picker {
  flex: 1;
}

.date-filter-btn {
  height: 76rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  background: var(--bg-card);
}

.date-filter-btn--active {
  border-color: var(--blue);
}

.date-filter-label {
  font-size: 28rpx;
  color: var(--text);
}

.date-clear-btn {
  height: 76rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: var(--bg-card);
}

.date-clear-text {
  font-size: 26rpx;
  color: var(--blue);
  font-weight: 600;
}

.event-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.event-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.event-card:active { opacity: 0.7; }

.event-card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.event-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.event-meta {
  font-size: 26rpx;
  color: var(--text-2);
}

.event-card-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.guest-count {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--blue);
  line-height: 1;
}

.guest-label {
  font-size: 20rpx;
  color: var(--text-2);
  margin-top: 4rpx;
}

.empty-state {
  padding: 48rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-3);
}

/* Subpage (navigateTo) — no tab bar, just safe-area breathing room */
.bottom-spacer {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
