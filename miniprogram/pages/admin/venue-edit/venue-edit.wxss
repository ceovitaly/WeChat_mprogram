.page {
  background: var(--bg);
}

/* ── Nav bar ── */
.nav-bar {
  background: var(--bg-card);
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 0.5px solid var(--border);
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.nav-btn {
  padding: 10rpx 16rpx;
}

.nav-btn-text {
  font-size: 30rpx;
  color: var(--blue);
  font-weight: 600;
}

.nav-btn-text--dim { opacity: 0.4; }

/* ── Sections ── */
.section {
  padding: 24rpx 24rpx 0;
}

.section-title {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 1rpx;
  padding: 0 4rpx 12rpx;
  display: block;
}

/* ── Logo row ── */
.logo-row {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.logo-row:active { opacity: 0.7; }

.logo-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.logo-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: var(--text-3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.logo-plus {
  font-size: 48rpx;
  color: var(--text-2);
  line-height: 1;
}

.logo-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.logo-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.logo-sub {
  font-size: 26rpx;
  color: var(--text-2);
}

/* ── Card ── */
.card {
  background: var(--bg-card);
  border-radius: 20rpx;
  overflow: hidden;
}

/* ── Field rows ── */
.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  min-height: 88rpx;
  border-bottom: 0.5px solid var(--bg);
}

.field-row:last-child { border-bottom: none; }

.field-row:active { background: var(--bg); }

.field-label {
  font-size: 28rpx;
  color: var(--text);
  min-width: 200rpx;
  flex-shrink: 0;
}

.field-input {
  flex: 1;
  text-align: left;
  font-size: 28rpx;
  color: var(--text);
  height: 88rpx;
  padding-left: 20rpx;
}

.field-placeholder { color: var(--text-3); }

.field-picker {
  font-size: 28rpx;
  color: var(--blue);
  text-align: right;
  flex: 1;
}

/* ── Save button ── */
.save-btn {
  background: var(--blue);
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
}

.save-btn:active { opacity: 0.8; }
.save-btn--dim { opacity: 0.5; }
.save-btn-text { font-size: 30rpx; color: #FFFFFF; font-weight: 600; }

.safe-area-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
