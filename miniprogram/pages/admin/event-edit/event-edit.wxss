.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.header-container {
  flex-shrink: 0;
  background: var(--bg-card);
  border-bottom: 0.5px solid var(--border);
}

.content-area {
  flex: 1;
  overflow: hidden;
}

.nav-bar {
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.nav-btn {
  padding: 10rpx 16rpx;
}

.nav-btn-text {
  font-size: 30rpx;
  color: var(--blue);
  font-weight: 600;
}

.nav-btn-text--dim { opacity: 0.4; }

.tab-bar {
  display: flex;
  height: 88rpx;
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-2);
  position: relative;
}

.tab--active {
  color: var(--blue);
  font-weight: 600;
}

.tab--active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 4rpx;
  background: var(--blue);
  border-radius: 2rpx;
}

/* ── Media grid ── */
.media-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-top: 12rpx;
}

.media-item {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
}

.media-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background: var(--text-3);
}

.media-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  z-index: 10;
}

.media-add {
  background: var(--text-3);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1 / 1;
}

.add-plus {
  font-size: 40rpx;
  color: var(--text-2);
  line-height: 1;
}

.add-label {
  font-size: 20rpx;
  color: var(--text-2);
  margin-top: 4rpx;
}

/* ── Content ── */
.tab-content {
  padding-bottom: 40rpx;
}

.section {
  padding: 24rpx 24rpx 0;
}

.section-title {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 1rpx;
  padding: 0 4rpx 12rpx;
  display: block;
}

/* ── Card ── */
.card {
  background: var(--bg-card);
  border-radius: 20rpx;
  overflow: hidden;
}

/* ── Field rows ── */
.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  min-height: 88rpx;
  border-bottom: 0.5px solid var(--bg);
  background: var(--bg-card);
}

.field-row:last-child { border-bottom: none; }

.field-row--area {
  align-items: flex-start;
  padding: 20rpx 28rpx;
}

.field-label {
  font-size: 28rpx;
  color: var(--text);
  min-width: 160rpx;
  flex-shrink: 0;
}

.field-input {
  flex: 1;
  text-align: left;
  font-size: 28rpx;
  color: var(--text);
  height: 88rpx;
  padding-left: 20rpx;
}

.field-textarea {
  flex: 1;
  text-align: left;
  font-size: 28rpx;
  color: var(--text);
  min-height: 120rpx;
  width: 100%;
  margin-top: 4rpx;
  padding-left: 20rpx;
}

.field-placeholder { color: var(--text-3); }

.field-picker {
  font-size: 28rpx;
  color: var(--blue);
  text-align: right;
}

.field-value { font-size: 28rpx; color: var(--text-2); }

/* ── Packages ── */
.package-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  border-bottom: 0.5px solid var(--bg);
}

.package-row:last-child { border-bottom: none; }

.package-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.package-name { font-size: 28rpx; font-weight: 500; color: var(--text); }
.package-meta { font-size: 24rpx; color: var(--text-2); }
.package-actions { display: flex; gap: 12rpx; }

.pkg-btn {
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pkg-btn--edit  { background: #E8F0FB; color: #185FA5; }
.pkg-btn--delete { background: #FFEBE9; color: #FF3B30; }

.paid-package-block {
  margin-top: 20rpx;
}

.paid-package-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 12rpx;
}

.paid-package-num {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.add-btn {
  margin-top: 16rpx;
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px dashed var(--border);
}

.add-btn:active { opacity: 0.6; }
.add-btn-text { font-size: 28rpx; color: var(--blue); font-weight: 500; }

/* ── Save button ── */
.save-btn {
  background: var(--blue);
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
}

.save-btn:active { opacity: 0.8; }
.save-btn--dim { opacity: 0.5; }
.save-btn-text { font-size: 30rpx; color: #FFFFFF; font-weight: 600; }

.safe-area-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

/* ── Modals ── */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal {
  width: 100%;
  background: var(--bg);
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 20rpx;
}

.modal-title { font-size: 32rpx; font-weight: 700; color: var(--text); }
.modal-close { font-size: 28rpx; color: var(--text-2); padding: 8rpx 16rpx; }

.modal-body {
  background: var(--bg-card);
  margin: 0 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
}

.modal-cancel {
  flex: 1;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-2);
  font-weight: 500;
}

.modal-save {
  flex: 2;
  background: var(--blue);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}
