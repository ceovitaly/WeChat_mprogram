<view class="page">

<view class="header-container">
  <view class="nav-bar">
    <text class="nav-title">{{isEdit ? 'Edit Event' : 'New Event'}}</text>
    <view class="nav-btn" bindtap="onSave">
      <text class="nav-btn-text {{isProcessing ? 'nav-btn-text--dim' : ''}}">Save</text>
    </view>
  </view>
  <view class="tab-bar">
    <view class="tab {{activeTab === 0 ? 'tab--active' : ''}}" bindtap="switchTab" data-index="0">
      <text>General</text>
    </view>
    <view class="tab {{activeTab === 1 ? 'tab--active' : ''}}" bindtap="switchTab" data-index="1">
      <text>Packages</text>
    </view>
  </view>
</view>

<!-- ── General Tab ── -->
<view wx:if="{{activeTab === 0}}" class="tab-content">

  <view class="section">
    <text class="section-title">Photos ({{images.length}}/10)</text>
    <view class="media-grid">
      <view class="media-item" wx:for="{{images}}" wx:key="index">
        <image src="{{item}}" mode="aspectFill" class="media-img" />
        <view class="media-remove" bindtap="removeImage" data-index="{{index}}">
          <text>✕</text>
        </view>
      </view>
      <view class="media-add" bindtap="chooseImages" wx:if="{{images.length < 10}}">
        <text class="add-plus">+</text>
        <text class="add-label">Add</text>
      </view>
    </view>
  </view>

  <view class="section">
    <text class="section-title">Event info</text>
    <view class="card">
      <view class="field-row">
        <text class="field-label">Title</text>
        <input
          class="field-input"
          placeholder="Event name"
          placeholder-class="field-placeholder"
          value="{{title}}"
          bindinput="onTitleInput"
          confirm-type="done"
        />
      </view>
      <view class="field-row field-row--area">
        <text class="field-label">Description</text>
        <textarea
          class="field-textarea"
          placeholder="Event details..."
          placeholder-class="field-placeholder"
          value="{{description}}"
          bindinput="onDescInput"
          auto-height
          cursor-spacing="20"
        />
      </view>
    </view>
  </view>

  <view class="section">
    <text class="section-title">Date & time</text>
    <view class="card">
      <view class="field-row">
        <text class="field-label">Date</text>
        <text class="field-value">{{date || 'Not set'}}</text>
      </view>
      <view class="field-row">
        <text class="field-label">Start</text>
        <picker mode="time" value="{{startTime}}" bindchange="onStartTimeChange">
          <text class="field-picker">{{startTime}}</text>
        </picker>
      </view>
      <view class="field-row">
        <text class="field-label">End</text>
        <picker mode="time" value="{{endTime}}" bindchange="onEndTimeChange">
          <text class="field-picker">{{endTime}}</text>
        </picker>
      </view>
    </view>
  </view>

  <view class="section">
    <text class="section-title">Venue</text>
    <view class="card">
      <view class="field-row">
        <text class="field-label">Location</text>
        <picker range="{{venues}}" range-key="name" value="{{venueIndex}}" bindchange="onVenueChange">
          <text class="field-picker {{selectedVenueName ? '' : 'field-placeholder'}}">
            {{selectedVenueName || 'Select venue'}}
          </text>
        </picker>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="save-btn {{isProcessing ? 'save-btn--dim' : ''}}" bindtap="onSave">
      <text class="save-btn-text">{{isProcessing ? 'Saving...' : 'Save Event'}}</text>
    </view>
  </view>
</view>

<!-- ── Packages Tab ── -->
<view wx:if="{{activeTab === 1}}" class="tab-content">

  <!-- Free Entry -->
  <view class="section">
    <text class="section-title">Free Entry</text>
    <view class="card">
      <view class="field-row">
        <text class="field-label">Enable free entry</text>
        <switch checked="{{hasFreeEntry}}" bindchange="toggleFreeEntry" color="#007AFF" />
      </view>
    </view>
  </view>

  <!-- Paid Packages -->
  <view class="section">
    <text class="section-title">Paid Packages</text>
    <view class="card">
      <view class="field-row">
        <text class="field-label">Enable paid packages</text>
        <switch checked="{{hasPaidPackages}}" bindchange="togglePaidPackages" color="#007AFF" />
      </view>
    </view>

    <block wx:if="{{hasPaidPackages}}">
      <view
        wx:for="{{paidPackages}}"
        wx:key="index"
        class="paid-package-block"
      >
        <view class="paid-package-header">
          <text class="paid-package-num">Package {{index + 1}}</text>
          <view class="pkg-btn pkg-btn--delete" bindtap="removePaidPackage" data-index="{{index}}">
            <text>✕</text>
          </view>
        </view>
        <view class="card">
          <view class="field-row">
            <text class="field-label">Name</text>
            <input
              class="field-input"
              placeholder="VIP Table, Bottle service..."
              placeholder-class="field-placeholder"
              value="{{item.name}}"
              bindinput="onPaidPackageInput"
              data-index="{{index}}"
              data-field="name"
              confirm-type="done"
            />
          </view>
          <view class="field-row">
            <text class="field-label">Payment link</text>
            <input
              class="field-input"
              placeholder="https://..."
              placeholder-class="field-placeholder"
              value="{{item.paymentLink}}"
              bindinput="onPaidPackageInput"
              data-index="{{index}}"
              data-field="paymentLink"
              confirm-type="done"
            />
          </view>
        </view>
      </view>

      <view class="add-btn" bindtap="addPaidPackage">
        <text class="add-btn-text">+ Add package</text>
      </view>
    </block>
  </view>

  <view class="section">
    <view class="save-btn {{isProcessing ? 'save-btn--dim' : ''}}" bindtap="onSave">
      <text class="save-btn-text">{{isProcessing ? 'Saving...' : 'Save Event'}}</text>
    </view>
  </view>
</view>

<view class="safe-area-bottom" />
</view>