.history-page{height:100vh;display:flex;flex-direction:column;background:var(--bg);color:var(--text)}.history-scroll{flex:1;height:0}.history-section{padding:24rpx 24rpx 160rpx}.tab-bar-spacer{height:160rpx;flex-shrink:0}.history-heading{display:block;color:var(--text-2);font-size:24rpx;font-weight:600;margin:20rpx 0}.history-card{background:var(--bg-card);border-radius:18rpx;padding:22rpx;margin-bottom:14rpx;border:1rpx solid var(--border)}.history-row{display:flex;align-items:center;gap:18rpx}.history-flex{flex:1;min-width:0;display:flex;flex-direction:column;gap:7rpx}.history-photo{width:88rpx;height:88rpx;border-radius:12rpx}.history-name{font-size:30rpx;font-weight:600}.history-muted{color:var(--text-2);font-size:23rpx}.history-chevron{color:var(--text-3);font-size:34rpx}.history-link,.history-load{color:var(--blue);font-size:27rpx}.history-load,.history-empty{text-align:center;padding:22rpx;color:var(--text-2)}.history-filters{display:flex;gap:12rpx;overflow:auto;margin:12rpx 0}.history-chip{flex-shrink:0;border-radius:30rpx;padding:12rpx 20rpx;background:var(--bg-card);color:var(--text-2);font-size:24rpx}.history-chip.active{background:var(--blue);color:#fff}.history-input{background:var(--bg-card);border-radius:12rpx;padding:12rpx 20rpx;color:var(--text);margin:10rpx 0}.history-green{border-left:6rpx solid #34c759}.history-red{border-left:6rpx solid #ff3b30}.history-blue{border-left:6rpx solid #007aff}.history-orange{border-left:6rpx solid #ff9500}.history-gray{border-left:6rpx solid #8e8e93}
