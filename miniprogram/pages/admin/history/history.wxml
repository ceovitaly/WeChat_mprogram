<view class="history-page"><nav-bar title="History"/><scroll-view class="history-scroll" scroll-y bindscrolltolower="loadMore"><view class="history-section"><view class="history-card history-link" bindtap="openSessions">Counter Sessions ›</view><text class="history-heading">Venues</text><view wx:for="{{venues}}" wx:key="id" class="history-card history-row" bindtap="open" data-id="{{item.id}}" data-name="{{item.name}}"><image wx:if="{{item.photoUrl}}" class="history-photo" src="{{item.photoUrl}}" mode="aspectFill"/><view class="history-flex"><text class="history-name">{{item.name}}{{item.historical ? ' · Deleted' : ''}}</text><text wx:if="{{!item.global && !item.historical}}" class="history-muted">{{item.eventCount}} events · {{item.activeEvents}} active · Last {{item.lastEventDate || '—'}}</text><text wx:if="{{!item.global}}" class="history-muted">Counter: {{item.occupied ? 'Occupied' : 'Available'}}</text><text wx:if="{{item.global}}" class="history-muted">Staff and organisation activity</text></view><text class="history-chevron">›</text></view><view wx:if="{{!venues.length && !loading}}" class="history-empty">No venues</view><view wx:if="{{loading}}" class="history-muted">Loading…</view><view wx:if="{{hasMore && !loading}}" class="history-load" bindtap="loadMore">Load more</view></view></scroll-view><view class="tab-bar-spacer"/></view>
