<view class="page">

<!-- Capsule-aligned header. Tab page — no back affordance by design. -->
<nav-bar>
  <view slot="left" class="nav-date" bindtap="toggleCalendar">
    <text class="nav-date-text">{{selectedDateLabel}}</text>
    <text class="nav-chevron">{{calendarVisible ? '▲' : '▼'}}</text>
  </view>
</nav-bar>

<view class="page-toolbar">
  <view class="page-add-btn" bindtap="goCreateEvent">
    <text class="page-add-btn-text">+ Add</text>
  </view>
</view>

<!-- Scrollable content. Custom dots refresher (same mechanic as the guest
     app's feed, admin blue): the native pull-down spinner doesn't render
     under a custom navigation bar, so refresher-default-style="none" + the
     slot below draw it ourselves. -->
<scroll-view
  class="content-scroll"
  scroll-y
  refresher-enabled
  refresher-default-style="none"
  refresher-background="transparent"
  refresher-threshold="{{refresherThreshold}}"
  refresher-triggered="{{refreshing}}"
  bindrefresherrefresh="onRefresh"
  bindrefresherpulling="onRefresherPulling"
  bindrefresherrestore="onRefresherRestore"
>
  <view slot="refresher" class="cal-refresher" style="height:{{refresherThreshold}}px">
    <view class="refresh-dots">
      <view class="refresh-dot {{refreshing ? 'refresh-dot-active' : ''}}" style="{{refreshing ? '' : dotStyles[0]}}"></view>
      <view class="refresh-dot {{refreshing ? 'refresh-dot-active' : ''}}" style="{{refreshing ? '' : dotStyles[1]}}"></view>
      <view class="refresh-dot {{refreshing ? 'refresh-dot-active' : ''}}" style="{{refreshing ? '' : dotStyles[2]}}"></view>
    </view>
  </view>

  <!-- Calendar grid (collapsible) -->
  <view class="calendar-wrap {{calendarVisible ? 'calendar-wrap--visible' : ''}}">
    <view class="calendar-month-header">
      <text class="calendar-month-name" bindtap="openPicker">{{monthName}} {{currYear}} ›</text>
    </view>
    <view class="weekdays">
      <text wx:for="{{['Mo','Tu','We','Th','Fr','Sa','Su']}}" wx:key="*this" class="weekday">{{item}}</text>
    </view>
    <view class="days-grid">
      <view
        wx:for="{{calendarDays}}"
        wx:key="fullDate"
        class="day-cell {{item.fullDate === selectedDate ? 'day-cell--selected' : ''}} {{!item.day ? 'day-cell--empty' : ''}}"
        bindtap="selectDate"
        data-date="{{item.fullDate}}"
      >
        <text class="day-num">{{item.day}}</text>
      </view>
    </view>
  </view>

  <!-- Events list -->
  <view class="events-wrap">

    <view wx:if="{{loading}}" class="empty-state">
      <text class="empty-text">Loading...</text>
    </view>

    <view wx:elif="{{filteredEvents.length === 0}}" class="empty-state">
      <text class="empty-icon">📅</text>
      <text class="empty-text">No events on this date</text>
    </view>

    <view wx:else>
      <view wx:for="{{filteredEvents}}" wx:key="_id" class="swipe-item">
        <!-- Swipe-to-delete (iOS-style): dragging the card left reveals the
             Delete button behind it. Tap still opens the editor — the old
             Edit/Delete row below the cover is gone by design. -->
        <view class="swipe-delete" catchtap="confirmDelete" data-id="{{item._id}}" data-title="{{item.title}}">
          <text class="swipe-delete-text">Delete</text>
        </view>
        <view
          class="event-card swipe-content {{swiping && swipeId === item._id ? 'swipe-content--drag' : ''}}"
          style="transform: translateX({{swipeId === item._id ? swipeX : 0}}px)"
          bindtap="goEditEvent"
          data-id="{{item._id}}"
          bindtouchstart="onSwipeStart"
          bindtouchmove="onSwipeMove"
          bindtouchend="onSwipeEnd"
          bindtouchcancel="onSwipeEnd"
        >
          <view class="event-cover">
            <text class="event-cover-title">{{item.title}}</text>
            <text class="event-cover-meta">{{item.venueName || 'Venue'}}{{item.startTime ? ' · ' + item.startTime : ''}}</text>
          </view>
        </view>
      </view>
    </view>

  </view>

  <view class="tab-bar-spacer" />
</scroll-view>

<!-- Month Picker Modal -->
<view wx:if="{{pickerVisible}}" class="picker-mask" bindtap="closePicker">
  <view class="picker-sheet" catchtap="">
    <view class="picker-header">
      <text class="picker-cancel" bindtap="closePicker">Cancel</text>
      <text class="picker-title">Select Month</text>
      <text class="picker-confirm" bindtap="confirmPicker">Done</text>
    </view>
    <view class="picker-columns">
      <picker-view
        class="picker-view"
        indicator-style="height: 88rpx;"
        value="{{[pickerMonthIndex]}}"
        bindchange="onPickerMonthChange"
      >
        <picker-view-column>
          <view wx:for="{{monthNames}}" wx:key="*this" class="picker-item">{{item}}</view>
        </picker-view-column>
      </picker-view>
    </view>
  </view>
</view>

</view>
