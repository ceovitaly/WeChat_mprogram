/* Hoisted to app.wxss: .empty-btn .empty-btn-text .tab-bar-spacer.

   Removed as dead code: the dark-mode .badge-green/.badge-red/.badge-gray
   overrides — calendar.wxml never renders those badges (and the base
   rules in app.wxss were unused too, so they went with them). */

page {
  height: 100vh;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  overflow: hidden;
}

/* ── Nav bar ──
   The bar itself is now <nav-bar> (/components/nav-bar). Only the
   contents of its "left" slot are styled here — slot content renders in
   the page's scope, so it cannot come from the component's .wxss.
   The date label drops 36rpx → 32rpx to match the shared nav title and
   to sit comfortably inside the capsule's band. */
.nav-date {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.nav-date-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -0.5rpx;
}

.nav-chevron {
  font-size: 20rpx;
  color: var(--text-2);
}

/* ── Scrollable content ── */
.content-scroll {
  flex: 1;
  height: 0;
}

/* ── Calendar grid ── */
.calendar-wrap {
  background: var(--bg-card);
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.calendar-wrap--visible { max-height: 680rpx; }

.calendar-month-header {
  padding: 20rpx 24rpx 8rpx;
}

.calendar-month-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--blue);
}

.weekdays {
  display: flex;
  padding: 8rpx 24rpx 8rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-2);
}

.days-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx 20rpx;
}

.day-cell {
  width: calc(100% / 7);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
}

.day-cell--empty { pointer-events: none; }

.day-num {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text);
  border-radius: 30rpx;
}

.day-cell--selected .day-num {
  background: var(--blue);
  color: #FFFFFF;
  font-weight: 600;
}

/* ── Events ── */
.events-wrap { padding: 20rpx 24rpx 0; }

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  gap: 16rpx;
}

/* 64rpx rather than the shared 80rpx — this empty state sits inside the
   day list rather than filling the page */
.empty-icon { font-size: 64rpx; }
.empty-text { font-size: 28rpx; color: var(--text-2); }

.event-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.event-cover {
  background: #1a1a2e;
  padding: 20rpx 24rpx;
  /* Same stacking as the Events tab card: title on top, "venue · time"
     below it — not side by side. */
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 96rpx;
  gap: 8rpx;
}

.event-cover-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  /* Full tile width so long titles wrap line by line; break-all keeps
     unbroken runs (emoji, long words) from pushing past the tile edge. */
  align-self: stretch;
  line-height: 1.4;
  word-break: break-all;
}

.event-cover-meta {
  font-size: 24rpx;
  color: #FFFFFF;
  text-align: left;
  line-height: 1.4;
}

.event-card-actions {
  display: flex;
  border-top: 0.5px solid var(--separator);
}

.event-action-btn {
  flex: 1;
  padding: 28rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.event-action-btn:active { opacity: 0.5; }

.event-action-btn--edit {
  border-right: 0.5px solid var(--separator);
}

.event-action-text {
  font-size: 28rpx;
  font-weight: 500;
}

.event-action-btn--edit .event-action-text { color: var(--blue); }
.event-action-btn--delete .event-action-text { color: var(--red); }

/* ── Picker Modal ── */
.picker-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.picker-sheet {
  width: 100%;
  background: var(--bg);
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: var(--bg-card);
  border-radius: 24rpx 24rpx 0 0;
  border-bottom: 0.5px solid var(--border);
}

.picker-cancel {
  font-size: 28rpx;
  color: var(--text-2);
}

.picker-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.picker-confirm {
  font-size: 28rpx;
  color: var(--blue);
  font-weight: 600;
}

.picker-columns {
  display: flex;
  padding: 0 16rpx;
}

.picker-view {
  flex: 1;
  height: 440rpx;
}

.picker-item {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--text);
}

@media (prefers-color-scheme: dark) {
  .event-cover {
    background: linear-gradient(135deg, #1B3A8C 0%, #2D1B69 100%);
  }
}

/* ── Custom dots pull-to-refresh (guest-feed mechanic, admin blue #007AFF) ── */

.cal-refresher {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  /* The refresher slot's wrapper shrink-to-fits its content — without an
     explicit full width the box hugs the left edge and justify-content
     centers nothing. Same fix as the guest feed's .feed-refresher. */
  width: 100%;
  box-sizing: border-box;
  padding-bottom: 16rpx;
}

/* Pre-trigger state (pulling): each dot's transform/opacity comes from the
   inline style driven by dotStyles in onRefresherPulling — dots grow from
   small/faint to full-size as the user pulls. Once refresher-triggered
   flips true, .refresh-dot-active's keyframe animation takes over
   automatically (CSS animations win over a plain inline style). */
.refresh-dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.refresh-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #007AFF;
  transform: scale(0.4);
  opacity: 0.25;
}

.refresh-dot-active {
  animation: refresh-dot-bounce 1.2s ease-in-out infinite;
}

.refresh-dot-active:nth-child(2) { animation-delay: 0.15s; }
.refresh-dot-active:nth-child(3) { animation-delay: 0.3s; }

@keyframes refresh-dot-bounce {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.5; }
  40% { transform: translateY(-12rpx); opacity: 1; }
}

/* Calendar's +Add: square with rounded corners (28rpx radius) instead of the
   shared capsule in app.wxss, at the app's compact 76rpx toolbar height —
   scoped to this page; the Team subpages keep the capsule until asked. */
.page-add-btn {
  height: 76rpx;
  border-radius: 28rpx;
}

/* ── Swipe-to-delete (iOS-style) ── */

.swipe-item {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

/* The wrapper owns the vertical rhythm now. */
.swipe-item .event-card {
  margin-bottom: 0;
}

/* Red Delete revealed behind the card's right edge. */
.swipe-delete {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 160rpx;
  background: #FF3B30;
  display: flex;
  align-items: center;
  justify-content: center;
}

.swipe-delete-text {
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
}

/* Snap animation on release; disabled while the finger is down so the card
   tracks the drag 1:1. */
.swipe-content {
  transition: transform 0.25s ease;
}

.swipe-content--drag {
  transition: none;
}
