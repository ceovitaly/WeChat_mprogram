/* Hoisted to app.wxss: .empty-btn .empty-btn-text .tab-bar-spacer.

   Removed as dead code: the dark-mode .badge-green/.badge-red/.badge-gray
   overrides — calendar.wxml never renders those badges (and the base
   rules in app.wxss were unused too, so they went with them). */

page {
  height: 100vh;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  overflow: hidden;
}

/* ── Nav bar ── */
.nav-bar {
  background: var(--bg-card);
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 0.5px solid var(--border);
  flex-shrink: 0;
}

.nav-date {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.nav-date-text {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -0.5rpx;
}

.nav-chevron {
  font-size: 20rpx;
  color: var(--text-2);
}

.nav-btn { padding: 10rpx 20rpx; }

.nav-btn-text {
  font-size: 34rpx;
  color: var(--blue);
  font-weight: 500;
}

/* ── Scrollable content ── */
.content-scroll {
  flex: 1;
  height: 0;
}

/* ── Calendar grid ── */
.calendar-wrap {
  background: var(--bg-card);
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.calendar-wrap--visible { max-height: 680rpx; }

.calendar-month-header {
  padding: 20rpx 24rpx 8rpx;
}

.calendar-month-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--blue);
}

.weekdays {
  display: flex;
  padding: 8rpx 24rpx 8rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-2);
}

.days-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx 20rpx;
}

.day-cell {
  width: calc(100% / 7);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
}

.day-cell--empty { pointer-events: none; }

.day-num {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text);
  border-radius: 30rpx;
}

.day-cell--selected .day-num {
  background: var(--blue);
  color: #FFFFFF;
  font-weight: 600;
}

/* ── Events ── */
.events-wrap { padding: 20rpx 24rpx 0; }

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  gap: 16rpx;
}

/* 64rpx rather than the shared 80rpx — this empty state sits inside the
   day list rather than filling the page */
.empty-icon { font-size: 64rpx; }
.empty-text { font-size: 28rpx; color: var(--text-2); }

.event-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.event-cover {
  background: #1a1a2e;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  gap: 16rpx;
}

.event-cover-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  flex-shrink: 0;
}

.event-cover-meta {
  font-size: 24rpx;
  color: #FFFFFF;
  text-align: right;
  flex: 1;
}

.event-card-actions {
  display: flex;
  border-top: 0.5px solid var(--separator);
}

.event-action-btn {
  flex: 1;
  padding: 28rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.event-action-btn:active { opacity: 0.5; }

.event-action-btn--edit {
  border-right: 0.5px solid var(--separator);
}

.event-action-text {
  font-size: 28rpx;
  font-weight: 500;
}

.event-action-btn--edit .event-action-text { color: var(--blue); }
.event-action-btn--delete .event-action-text { color: var(--red); }

/* ── Picker Modal ── */
.picker-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.picker-sheet {
  width: 100%;
  background: var(--bg);
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: var(--bg-card);
  border-radius: 24rpx 24rpx 0 0;
  border-bottom: 0.5px solid var(--border);
}

.picker-cancel {
  font-size: 28rpx;
  color: var(--text-2);
}

.picker-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.picker-confirm {
  font-size: 28rpx;
  color: var(--blue);
  font-weight: 600;
}

.picker-columns {
  display: flex;
  padding: 0 16rpx;
}

.picker-view {
  flex: 1;
  height: 440rpx;
}

.picker-item {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--text);
}

@media (prefers-color-scheme: dark) {
  .event-cover {
    background: linear-gradient(135deg, #1B3A8C 0%, #2D1B69 100%);
  }
}
