.page {
  min-height: 100vh;
  background: #F2F2F7;
}

/* ── Nav bar ── */
.nav-bar {
  background: #FFFFFF;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 0.5px solid #C6C6C8;
  position: sticky;
  top: 0;
  z-index: 10;
}

.nav-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #000000;
  letter-spacing: -0.5rpx;
}

.nav-btn { padding: 10rpx 20rpx; }

.nav-btn-text {
  font-size: 34rpx;
  color: #007AFF;
  font-weight: 500;
}

/* ── Date bar ── */
.month-bar {
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx;
  border-bottom: 0.5px solid #F2F2F7;
}

.month-arrow {
  font-size: 64rpx;
  color: #007AFF;
  padding: 0 16rpx;
  font-weight: 300;
  line-height: 1;
}

.month-center {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  justify-content: center;
}

.month-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.month-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #000000;
}

.month-chevron {
  font-size: 20rpx;
  color: #8E8E93;
}

.calendar-icon-btn {
  width: 56rpx;
  height: 56rpx;
  background: #F2F2F7;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.calendar-icon {
  font-size: 32rpx;
}

/* ── Calendar grid ── */
.calendar-wrap {
  background: #FFFFFF;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.calendar-wrap--visible { max-height: 600rpx; }

.weekdays {
  display: flex;
  padding: 16rpx 24rpx 8rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  font-weight: 500;
  color: #8E8E93;
}

.days-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx 20rpx;
}

.day-cell {
  width: calc(100% / 7);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
}

.day-cell--empty { pointer-events: none; }

.day-num {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #000000;
  border-radius: 30rpx;
}

.day-cell--selected .day-num {
  background: #007AFF;
  color: #FFFFFF;
  font-weight: 600;
}

/* ── Date label ── */
.date-label-wrap { padding: 24rpx 32rpx 12rpx; }

.date-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #8E8E93;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

/* ── Events ── */
.events-wrap { padding: 0 24rpx; }

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  gap: 16rpx;
}

.empty-icon { font-size: 64rpx; }
.empty-text { font-size: 28rpx; color: #8E8E93; }

.empty-btn {
  margin-top: 8rpx;
  padding: 16rpx 40rpx;
  background: #007AFF;
  border-radius: 20rpx;
}

.empty-btn-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.event-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.event-cover {
  height: 120rpx;
  background: #1a1a2e;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.event-cover-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.event-status-badge {
  font-size: 20rpx;
  font-weight: 500;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.badge-green { background: #D4EDDA; color: #155724; }
.badge-red   { background: #FFEBE9; color: #FF3B30; }
.badge-gray  { background: #E5E5EA; color: #8E8E93; }

.event-info {
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.event-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.event-time {
  font-size: 26rpx;
  font-weight: 500;
  color: #000000;
}

.event-venue {
  font-size: 24rpx;
  color: #8E8E93;
}

.event-actions { display: flex; gap: 12rpx; }

.action-btn {
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.action-btn--edit  { background: #E8F0FB; color: #185FA5; }
.action-btn--delete { background: #FFEBE9; color: #FF3B30; }

/* ── Picker Modal ── */
.picker-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.picker-sheet {
  width: 100%;
  background: #F2F2F7;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  border-bottom: 0.5px solid #C6C6C8;
}

.picker-cancel {
  font-size: 28rpx;
  color: #8E8E93;
}

.picker-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
}

.picker-confirm {
  font-size: 28rpx;
  color: #007AFF;
  font-weight: 600;
}

.picker-columns {
  display: flex;
  padding: 0 16rpx;
}

.picker-view {
  flex: 1;
  height: 440rpx;
}

.picker-item {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #000000;
}

.tab-bar-spacer {
  height: calc(100rpx + env(safe-area-inset-bottom));
}