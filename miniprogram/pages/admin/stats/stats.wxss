/* Hoisted to app.wxss: .section-title.

   Removed as dead code — stats.wxml contains no matching markup for any
   of these (the guest-check-in modal, the metric tiles and the report
   detail view all live on other pages now):
     .metrics-grid .metric-card .metric-value .metric-label
     .modal-overlay .modal-close .guest-modal .gm-* .duty-*
     .rpt-* .section-header .gm-close-event-*
   Verified with a grep of stats.wxml and every page .js. */

.page {
  height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.nav-bar {
  background: var(--bg-card);
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 0.5px solid var(--border);
  flex-shrink: 0;
}

.nav-username {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.nav-btn-logout {
  font-size: 28rpx;
  color: var(--red);
  font-weight: 700;
}

.sub-tabs {
  display: flex;
  background: var(--bg-card);
  border-bottom: 0.5px solid var(--border);
  flex-shrink: 0;
}

.sub-tab {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.sub-tab-text {
  font-size: 28rpx;
  color: var(--text-2);
}

.sub-tab--active .sub-tab-text {
  color: var(--blue);
  font-weight: 600;
}

.sub-tab--active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 4rpx;
  background: var(--blue);
  border-radius: 2rpx;
}

.scroll {
  flex: 1;
  height: 0;
}

.section {
  padding: 24rpx 24rpx 0;
}

/* Today's events */
.today-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.today-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.today-card:active { opacity: 0.7; }

.today-card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.today-event-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.today-event-meta {
  font-size: 26rpx;
  color: var(--text-2);
}

.today-card-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.today-guest-count {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--blue);
  line-height: 1;
}

.today-guest-label {
  font-size: 20rpx;
  color: var(--text-2);
  margin-top: 4rpx;
}

/* inherits display/flex-direction/align-items/colour from app.wxss's
   .empty-state; only the tighter padding differs */
.empty-state {
  padding: 48rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-3);
}

/* flat value, not the shared calc() — this page's spacer sits inside a
   scroll-view that already clears the safe area */
.tab-bar-spacer {
  height: 160rpx;
}
