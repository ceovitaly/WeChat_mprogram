.page {
  height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.scroll {
  flex: 1;
  min-height: 0;
}

.body {
  padding: 24rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-3);
  text-transform: uppercase;
  letter-spacing: 1rpx;
  margin: 8rpx 8rpx 16rpx;
}

.card {
  background: var(--bg-card, #FFFFFF);
  border-radius: 28rpx;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--border, #E5E5EA);
}

.row:last-child {
  border-bottom: none;
}

.rank {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-3);
  min-width: 44rpx;
  text-align: center;
}

/* Top three stand out a little */
.rank--top {
  color: #FF6B35;
}

.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #E8F0FB;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #007AFF;
}

.name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.count {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

/* The leader's number in brand accent — "who is winning" at a glance */
.count--top {
  color: #FF6B35;
}

.empty-state {
  padding: 120rpx 48rpx;
  display: flex;
  justify-content: center;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-3);
}

.safe-bottom {
  height: 48rpx;
}
