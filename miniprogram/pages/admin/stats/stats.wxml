<view class="page">

<view class="nav-bar">
  <text class="nav-title">Stats</text>
  <view class="nav-btn" bindtap="confirmLogout">
    <text class="nav-btn-logout">Log out</text>
  </view>
</view>

<view class="section">
  <text class="section-title">Overview</text>
  <view class="metrics-grid">

    <view class="metric-card" bindtap="goToCalendar">
      <text class="metric-value">{{totalEvents}}</text>
      <text class="metric-label">Events</text>
    </view>

    <view class="metric-card" bindtap="goToGuests">
      <text class="metric-value">{{totalGuests}}</text>
      <text class="metric-label">Guests</text>
    </view>

    <view class="metric-card" bindtap="goToPromoters">
      <text class="metric-value">{{totalPromoters}}</text>
      <text class="metric-label">Promoters</text>
      <view wx:if="{{totalPending > 0}}" class="metric-badge">
        <text class="metric-badge-text">{{totalPending}} pending</text>
      </view>
    </view>

    <view class="metric-card" bindtap="goToStaff">
      <text class="metric-value">{{totalStaff}}</text>
      <text class="metric-label">Counters</text>
    </view>

  </view>
</view>

<view class="section">
  <text class="section-title">Top promoters</text>

  <view wx:if="{{agentStats.length === 0}}" class="empty-state">
    <text class="empty-text">No data yet</text>
  </view>

  <view wx:else class="card">
    <view wx:for="{{agentStats}}" wx:key="name" class="agent-row">

      <view class="agent-left">
        <view class="agent-avatar">
          <text class="agent-avatar-text">{{item.name[0]}}</text>
        </view>
        <view class="agent-info">
          <text class="agent-name">{{item.name}}</text>
          <view class="agent-bar-wrap">
            <view class="agent-bar-fill" style="flex:{{item.barPercent}}"></view>
            <view class="agent-bar-empty" style="flex:{{100 - item.barPercent}}"></view>
          </view>
        </view>
      </view>

      <text class="agent-count">{{item.count}}</text>

    </view>
  </view>

</view>

<view class="tab-bar-spacer"></view>

</view>