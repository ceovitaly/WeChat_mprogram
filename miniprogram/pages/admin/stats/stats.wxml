<view class="page">

<nav-bar title="Stats" show-back />

<scroll-view class="scroll" scroll-y>

  <view wx:if="{{loading}}" class="empty-state">
    <text class="empty-text">Loading...</text>
  </view>

  <view wx:elif="{{rows.length === 0}}" class="empty-state">
    <text class="empty-text">No promoters yet</text>
  </view>

  <view wx:else class="body">
    <view class="section-title">Promoters by registered guests</view>
    <view class="card">
      <view wx:for="{{rows}}" wx:key="_id" class="row">
        <text class="rank {{index < 3 ? 'rank--top' : ''}}">{{index + 1}}</text>
        <view class="avatar">
          <text class="avatar-text">{{item.avatarLetter}}</text>
        </view>
        <text class="name">{{item.name}}</text>
        <text class="count {{index === 0 ? 'count--top' : ''}}">{{item.guestCount}}</text>
      </view>
    </view>
  </view>

  <view class="safe-bottom"></view>
</scroll-view>

</view>
