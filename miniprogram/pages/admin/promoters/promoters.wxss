page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.page {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.scroll-content {
  flex: 1;
  height: 0;
}

.nav-bar {
  background: var(--bg-card);
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 0.5px solid var(--border);
  flex-shrink: 0;
}

.nav-bar:active { background: var(--bg); }

.nav-add-text {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--blue);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  gap: 20rpx;
}

.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 28rpx; color: var(--text-2); }

.empty-btn {
  margin-top: 8rpx;
  padding: 16rpx 40rpx;
  background: var(--blue);
  border-radius: 20rpx;
}

.empty-btn-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.item-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  overflow: hidden;
}

.item-top {
  display: flex;
  align-items: center;
  padding: 28rpx;
  gap: 20rpx;
  border-bottom: 0.5px solid var(--bg);
}

.item-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #E8F0FB;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.item-avatar-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #185FA5;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: hidden;
}

.item-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.item-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.status-badge {
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.badge-approved { background: #E8F8F0; }
.badge-pending { background: #FFF3E0; }
.badge-suspended { background: #FFEBE9; }
.badge-revoked { background: var(--bg); }

.status-text {
  font-size: 20rpx;
  font-weight: 500;
  text-transform: capitalize;
  color: #8E8E93;
}

.badge-approved .status-text { color: #1D9E75; }
.badge-pending .status-text { color: #E65100; }
.badge-suspended .status-text { color: #FF3B30; }

.item-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.promo-code {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--blue);
  letter-spacing: 1rpx;
}

.meta-dot {
  font-size: 24rpx;
  color: var(--text-3);
}

.item-sub {
  font-size: 28rpx;
  color: var(--text-2);
}

.item-actions {
  display: flex;
}

.action-btn {
  flex: 1;
  padding: 22rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  border-right: 0.5px solid var(--bg);
}

.action-btn:last-child { border-right: none; }
.action-btn:active { opacity: 0.6; }

.action-btn--primary { color: var(--blue); }

.safe-area-bottom {
  height: calc(32rpx + env(safe-area-inset-bottom));
}

/* ── Modals ── */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.modal {
  width: 100%;
  background: var(--bg);
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 20rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.modal-subtitle {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 4rpx;
  display: block;
}

.modal-close {
  font-size: 28rpx;
  color: var(--text-2);
  padding: 8rpx 16rpx;
}

.modal-body {
  background: var(--bg-card);
  margin: 0 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  min-height: 88rpx;
  border-bottom: 0.5px solid var(--bg);
}

.field-row:last-child { border-bottom: none; }

.field-label {
  font-size: 28rpx;
  color: var(--text);
  min-width: 180rpx;
}

.field-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--text);
  height: 88rpx;
}

.field-placeholder { color: var(--text-3); }

.code-save-wrap {
  padding: 16rpx 24rpx 0;
}

.code-save-btn {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  border: 1.5rpx solid var(--blue);
}

.code-save-btn:active { opacity: 0.7; }

.code-save-text {
  font-size: 28rpx;
  color: var(--blue);
  font-weight: 600;
}

.action-section {
  padding: 24rpx 24rpx 0;
}

.action-section-title {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 1rpx;
  padding: 0 4rpx 12rpx;
  display: block;
}

.action-list {
  background: var(--bg-card);
  border-radius: 20rpx;
  overflow: hidden;
}

.action-row {
  padding: 28rpx;
  border-bottom: 0.5px solid var(--bg);
  text-align: center;
}

.action-row:last-child { border-bottom: none; }
.action-row:active { opacity: 0.6; }

.action-row--green .action-row-text { color: #34C759; font-weight: 600; font-size: 28rpx; }
.action-row--orange .action-row-text { color: #FF9500; font-weight: 600; font-size: 28rpx; }
.action-row--red .action-row-text { color: #FF3B30; font-weight: 600; font-size: 28rpx; }

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
}

.modal-cancel {
  flex: 1;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-2);
  font-weight: 500;
}

.modal-cancel--full { flex: 1; }

.modal-save {
  flex: 2;
  background: var(--blue);
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.modal-save:active { opacity: 0.8; }
