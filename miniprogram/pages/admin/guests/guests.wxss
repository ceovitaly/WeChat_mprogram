.page {
  min-height: 100vh;
  background: #F2F2F7;
}

.nav-bar {
  background: #FFFFFF;
  padding: 16rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 0.5px solid #C6C6C8;
  position: sticky;
  top: 0;
  z-index: 10;
}

.nav-back-text {
  font-size: 28rpx;
  color: #007AFF;
  min-width: 120rpx;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #000000;
  flex: 1;
  text-align: center;
}

.nav-count {
  font-size: 26rpx;
  color: #8E8E93;
  min-width: 60rpx;
  text-align: right;
}

.search-wrap {
  padding: 16rpx 24rpx;
  background: #F2F2F7;
}

.search-input {
  height: 72rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #000000;
  width: 100%;
  box-sizing: border-box;
}

.search-placeholder {
  color: #C7C7CC;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  gap: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8E8E93;
}

.card {
  margin: 0 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
}

.guest-row {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  gap: 16rpx;
  border-bottom: 0.5px solid #F2F2F7;
}

.guest-row:last-child {
  border-bottom: none;
}

.guest-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #E8F0FB;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.guest-avatar-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #185FA5;
}

.guest-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.guest-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #000000;
}

.guest-event {
  font-size: 22rpx;
  color: #8E8E93;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.guest-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  flex-shrink: 0;
}

.guest-promoter {
  font-size: 24rpx;
  font-weight: 500;
  color: #007AFF;
}

.guest-arrived {
  font-size: 20rpx;
  color: #34C759;
  font-weight: 500;
}

.guest-pending {
  font-size: 20rpx;
  color: #C7C7CC;
}

.tab-bar-spacer {
  height: 160rpx;
}