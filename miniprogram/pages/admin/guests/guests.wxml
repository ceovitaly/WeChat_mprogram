<view class="page">

<view class="search-wrap">
  <input
    class="search-input"
    placeholder="Search guest or promoter..."
    placeholder-class="search-placeholder"
    value="{{searchQuery}}"
    bindinput="onSearchInput"
  />
</view>

<view wx:if="{{isLoading && filteredGuests.length === 0}}" class="empty-state">
  <text class="empty-text">Loading...</text>
</view>

<view wx:elif="{{!isLoading && filteredGuests.length === 0}}" class="empty-state">
  <text class="empty-icon">👥</text>
  <text class="empty-text">No guests found</text>
</view>

<view wx:else class="card">
  <view
    wx:for="{{filteredGuests}}"
    wx:key="_id"
    class="guest-row"
  >
    <view class="guest-avatar">
      <text class="guest-avatar-text">{{item.guestName[0]}}</text>
    </view>
    <view class="guest-info">
      <text class="guest-name">{{item.guestName}}</text>
      <text class="guest-event">{{item.eventTitle || '—'}}</text>
    </view>
    <view class="guest-right">
      <text class="guest-promoter">{{item.promoterName || 'No promoter'}}</text>
      <text wx:if="{{item.arrivedAt}}" class="guest-arrived">✓ {{item.arrivedAt}}</text>
      <text wx:else class="guest-pending">Waiting</text>
    </view>
  </view>

  <view wx:if="{{isLoading}}" class="load-more-indicator">
    <text class="load-more-text">Loading...</text>
  </view>
</view>

<view class="tab-bar-spacer"></view>

</view>