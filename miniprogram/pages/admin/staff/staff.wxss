.page {
  min-height: 100vh;
  background: #F2F2F7;
}

.nav-bar {
  background: #FFFFFF;
  padding: 16rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 0.5px solid #C6C6C8;
  position: sticky;
  top: 0;
  z-index: 10;
}

.nav-back-text {
  font-size: 28rpx;
  color: #007AFF;
  min-width: 120rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #000000;
}

.nav-btn-text {
  font-size: 30rpx;
  color: #007AFF;
  font-weight: 500;
  min-width: 120rpx;
  text-align: right;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  gap: 20rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8E8E93;
}

.empty-btn {
  padding: 16rpx 40rpx;
  background: #007AFF;
  border-radius: 20rpx;
}

.empty-btn-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.list {
  padding: 24rpx;
}

.section-title {
  font-size: 22rpx;
  font-weight: 500;
  color: #8E8E93;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  padding: 0 4rpx 12rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.staff-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  gap: 16rpx;
  border-bottom: 0.5px solid #F2F2F7;
}

.staff-row:last-child {
  border-bottom: none;
}

.staff-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar--admin {
  background: #E8F0FB;
}

.avatar--counter {
  background: #F2F2F7;
}

.staff-avatar-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
}

.staff-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  overflow: hidden;
}

.staff-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.staff-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
}

.role-badge {
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.badge-admin {
  background: #E8F0FB;
}

.badge-counter {
  background: #F2F2F7;
}

.role-badge-text {
  font-size: 20rpx;
  font-weight: 500;
  color: #8E8E93;
  text-transform: uppercase;
  letter-spacing: 0.5rpx;
}

.staff-pass {
  font-size: 24rpx;
  color: #8E8E93;
}

.staff-actions {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.action-btn {
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.action-btn:active {
  opacity: 0.6;
}

.action-btn--copy {
  background: #F2F2F7;
  color: #007AFF;
}

.action-btn--edit {
  background: #E8F0FB;
  color: #185FA5;
}

.action-btn--delete {
  background: #FFEBE9;
  color: #FF3B30;
}

.safe-area-bottom {
  height: calc(32rpx + env(safe-area-inset-bottom));
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.modal {
  width: 100%;
  background: #F2F2F7;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 20rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #000000;
}

.modal-close {
  font-size: 28rpx;
  color: #8E8E93;
  padding: 8rpx 16rpx;
}

.modal-body {
  background: #FFFFFF;
  margin: 0 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  min-height: 88rpx;
  border-bottom: 0.5px solid #F2F2F7;
}

.field-row:last-child {
  border-bottom: none;
}

.field-label {
  font-size: 28rpx;
  color: #000000;
  min-width: 160rpx;
}

.field-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #000000;
  height: 88rpx;
}

.field-placeholder {
  color: #C7C7CC;
}

.role-section {
  padding: 24rpx 24rpx 0;
}

.role-section-title {
  font-size: 22rpx;
  font-weight: 500;
  color: #8E8E93;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  padding: 0 4rpx 12rpx;
}

.role-options {
  display: flex;
  gap: 16rpx;
}

.role-option {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  border: 2rpx solid transparent;
}

.role-option--active {
  border-color: #007AFF;
  background: #E8F0FB;
}

.role-option-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
}

.role-option-sub {
  font-size: 22rpx;
  color: #8E8E93;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
}

.modal-cancel {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8E8E93;
  font-weight: 500;
}

.modal-save {
  flex: 2;
  background: #007AFF;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.modal-save:active {
  opacity: 0.8;
}