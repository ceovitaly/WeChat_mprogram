page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.page {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.scroll-content {
  flex: 1;
  height: 0;
}

.nav-bar {
  background: var(--bg-card);
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 0.5px solid var(--border);
  flex-shrink: 0;
}

.nav-bar:active { background: var(--bg); }

.nav-add-text {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--blue);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  gap: 20rpx;
}

.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 28rpx; color: #8E8E93; }

.list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.item-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  overflow: hidden;
}

.item-top {
  display: flex;
  align-items: center;
  padding: 28rpx;
  gap: 20rpx;
  border-bottom: 0.5px solid var(--bg);
}

.item-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar--admin { background: #E8F0FB; }
.avatar--counter { background: var(--bg); }

.item-avatar-text {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.item-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.role-badge {
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}

.badge-admin { background: #E8F0FB; }
.badge-counter { background: var(--bg); }

.role-badge-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #8E8E93;
  text-transform: uppercase;
  letter-spacing: 0.5rpx;
}

.item-sub {
  font-size: 28rpx;
  color: var(--text-2);
}

.modal-delete-row {
  margin: 0 24rpx 0;
  background: #FFF1F0;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
}

.modal-delete-row:active { opacity: 0.7; }

.modal-delete-text {
  font-size: 28rpx;
  color: #FF3B30;
  font-weight: 500;
}

.item-actions {
  display: flex;
}

.action-btn {
  flex: 1;
  padding: 22rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  border-right: 0.5px solid var(--bg);
}

.action-btn:last-child { border-right: none; }
.action-btn:active { opacity: 0.6; }

.action-btn--copy { color: #007AFF; }
.action-btn--edit { color: #185FA5; }
.action-btn--delete { color: #FF3B30; }

.safe-area-bottom {
  height: calc(32rpx + env(safe-area-inset-bottom));
}

/* ── Modal ── */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.modal {
  width: 100%;
  background: var(--bg);
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 20rpx;
}

.modal-title { font-size: 32rpx; font-weight: 700; color: var(--text); }
.modal-close { font-size: 28rpx; color: var(--text-2); padding: 8rpx 16rpx; }

.modal-body {
  background: var(--bg-card);
  margin: 0 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  min-height: 88rpx;
  border-bottom: 0.5px solid var(--bg);
}

.field-row:last-child { border-bottom: none; }

.field-label { font-size: 28rpx; color: var(--text); min-width: 160rpx; }

.field-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--text);
  height: 88rpx;
}

.field-placeholder { color: var(--text-3); }

.role-section { padding: 24rpx 24rpx 0; }

.role-section-title {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 1rpx;
  padding: 0 4rpx 12rpx;
  display: block;
}

.role-options { display: flex; gap: 16rpx; }

.role-option {
  flex: 1;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  border: 2rpx solid transparent;
}

.role-option--active { border-color: var(--blue); background: #E8F0FB; }
.role-option-text { font-size: 28rpx; font-weight: 600; color: var(--text); }
.role-option-sub { font-size: 22rpx; color: var(--text-2); }

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
}

.modal-cancel {
  flex: 1;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-2);
  font-weight: 500;
}

.modal-save {
  flex: 2;
  background: var(--blue);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.modal-save:active { opacity: 0.8; }
