.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.top-bar {
  background: var(--bg-card);
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 0.5px solid var(--border);
  flex-shrink: 0;
}

.top-bar-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.event-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.event-sub {
  font-size: 24rpx;
  color: var(--text-2);
}

.close-event-btn {
  background: rgba(255, 59, 48, 0.1);
  border: 1rpx solid rgba(255, 59, 48, 0.25);
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.close-event-btn:active { opacity: 0.7; }

.close-event-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--red);
}

.export-btn {
  background: rgba(48, 209, 88, 0.12);
  border: 1rpx solid rgba(48, 209, 88, 0.3);
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.export-btn:active { opacity: 0.7; }

.export-btn-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #30D158;
}

.stats-bar--closed {
  border-bottom-color: rgba(48, 209, 88, 0.3);
}

.stats-bar {
  background: var(--bg-card);
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  border-bottom: 0.5px solid var(--bg);
  flex-shrink: 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  flex: 1;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
}

.stat-num--green { color: #34C759; }

.stat-label {
  font-size: 20rpx;
  color: var(--text-2);
}

.stat-div {
  width: 1rpx;
  height: 48rpx;
  background: var(--border);
}

.refresh-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding-left: 24rpx;
}

.refresh-btn:active { opacity: 0.5; }

.refresh-icon {
  font-size: 36rpx;
  color: var(--blue);
  line-height: 1;
}

.refresh-time {
  font-size: 18rpx;
  color: var(--text-3);
}

.scroll {
  flex: 1;
  overflow: hidden;
}

.body {
  padding: 24rpx 24rpx 0;
}

.section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 1rpx;
  padding: 0 4rpx 12rpx;
  display: block;
}

.card {
  background: var(--bg-card);
  border-radius: 20rpx;
  overflow: hidden;
}

.guest-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  gap: 16rpx;
  border-bottom: 0.5px solid var(--bg);
}

.guest-row:last-child { border-bottom: none; }

.guest-row--duty { background: rgba(52, 199, 89, 0.06); }
.guest-row--arrived { background: transparent; }

.position-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #34C759;
  min-width: 44rpx;
  text-align: center;
  flex-shrink: 0;
}

.position-num--duty {
  color: #007AFF;
}

.guest-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.guest-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text);
}

.guest-name--arrived { color: #1D9E75; }
.guest-name--duty { color: #007AFF; }

.guest-sub {
  font-size: 22rpx;
  color: var(--text-2);
}

.arrival-time {
  font-size: 26rpx;
  color: var(--text-2);
  flex-shrink: 0;
}

.arrival-badge {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--blue);
  background: #E8F0FB;
  border-radius: 10rpx;
  padding: 6rpx 14rpx;
  flex-shrink: 0;
}

.pending-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--text-3);
  flex-shrink: 0;
  margin: 0 15rpx;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-3);
}

.safe-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

.group-badge {
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 8rpx;
}
.group-badge--p { background: #E8F5E9; color: #2E7D32; }
.group-badge--ap { background: #E3F2FD; color: #1565C0; }
.group-badge--lap { background: #FFF3E0; color: #E65100; }

.arrived-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx 8rpx;
  background: var(--bg);
  border-radius: 16rpx 16rpx 0 0;
  margin-top: 16rpx;
}
.arrived-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-2);
  letter-spacing: 1rpx;
  text-transform: uppercase;
}
.arrived-section-count {
  font-size: 24rpx;
  color: var(--text-2);
}
.arrived-section-card {
  border-radius: 0 0 20rpx 20rpx;
}

/* Tier row tints */
.row--party  { background: rgba(46, 125, 50, 0.07); }
.row--ap     { background: rgba(21, 101, 192, 0.07); }
.row--lap    { background: rgba(230, 81, 0, 0.07); }
.row--extra  { background: transparent; }

/* Tier badges */
.tier-badge {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.tier-badge-text { font-size: 22rpx; font-weight: 700; font-family: monospace; }
.tier-badge--p   { background: rgba(46, 125, 50, 0.12); }
.tier-badge--p .tier-badge-text   { color: #2E7D32; }
.tier-badge--ap  { background: rgba(21, 101, 192, 0.12); }
.tier-badge--ap .tier-badge-text  { color: #1565C0; }
.tier-badge--lap { background: rgba(230, 81, 0, 0.12); }
.tier-badge--lap .tier-badge-text { color: #E65100; }
.tier-badge--e   { background: rgba(0, 0, 0, 0.06); }
.tier-badge--e .tier-badge-text   { color: #757575; }

@media (prefers-color-scheme: dark) {
  .guest-name--arrived { color: #30D158; }
  .guest-name--duty    { color: #0A84FF; }

  .tier-badge--p .tier-badge-text   { color: #30D158; }
  .tier-badge--ap .tier-badge-text  { color: #64B5F6; }
  .tier-badge--lap .tier-badge-text { color: #FFB74D; }
  .tier-badge--e .tier-badge-text   { color: #AEAEB2; }
  .tier-badge--e { background: rgba(255,255,255,0.08); }

  .arrived-section-header { background: transparent; }
}
