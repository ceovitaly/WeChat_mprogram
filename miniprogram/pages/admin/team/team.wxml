<view class="page">

<!-- Capsule-aligned header. Opened from the Main menu now (used to be a
     tab) — a back affordance replaces the tab-page behaviour. -->
<nav-bar title="Team" show-back />

<scroll-view class="scroll" scroll-y>

  <view class="section" style="padding-top: 32rpx;">
    <text class="section-title">Manage</text>
    <view class="card">

      <view class="card-row" bindtap="goTo" data-url="/packageAdmin/pages/admin/venue-list/venue-list">
        <view class="row-left">
          <view class="row-icon" style="background:#E8F0FB">
            <text class="row-icon-emoji">🏛</text>
          </view>
          <view class="row-text">
            <text class="row-label">Venues</text>
            <text class="row-sub">{{venueCount}} venues</text>
          </view>
        </view>
        <view class="row-right">
          <text class="chevron">›</text>
        </view>
      </view>

      <view class="card-row" bindtap="goTo" data-url="/packageAdmin/pages/admin/staff/staff">
        <view class="row-left">
          <view class="row-icon" style="background:#E8F8F0">
            <text class="row-icon-emoji">👤</text>
          </view>
          <view class="row-text">
            <text class="row-label">Counters</text>
            <text class="row-sub">{{staffCount}} staff</text>
          </view>
        </view>
        <view class="row-right">
          <text class="chevron">›</text>
        </view>
      </view>

      <view class="card-row" bindtap="goTo" data-url="/packageAdmin/pages/admin/promoters/promoters">
        <view class="row-left">
          <view class="row-icon" style="background:#FFF3E0">
            <text class="row-icon-emoji">⭐</text>
          </view>
          <view class="row-text">
            <text class="row-label">Promoters</text>
            <text class="row-sub">{{promoterCount}} total</text>
          </view>
        </view>
        <view class="row-right">
          <view wx:if="{{pendingCount > 0}}" class="pending-badge">
            <text class="pending-badge-text">{{pendingCount}}</text>
          </view>
          <text class="chevron">›</text>
        </view>
      </view>

      <view class="card-row" bindtap="goTo" data-url="/packageAdmin/pages/admin/guests/guests">
        <view class="row-left">
          <view class="row-icon" style="background:#F0E8FB">
            <text class="row-icon-emoji">👥</text>
          </view>
          <view class="row-text">
            <text class="row-label">All Guests</text>
            <text class="row-sub">{{totalGuests}} total</text>
          </view>
        </view>
        <view class="row-right">
          <text class="chevron">›</text>
        </view>
      </view>

    </view>
  </view>

  <view class="bottom-spacer" />
</scroll-view>

</view>
