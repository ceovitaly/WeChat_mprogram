.page {
  background: var(--bg);
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* Counter bar */
.counter-bar {
  background: var(--bg-card);
  border-bottom: 0.5px solid var(--border);
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  flex-shrink: 0;
}

.counter-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.counter-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
}

.counter-label {
  font-size: 22rpx;
  color: var(--text-2);
}

.counter-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--border);
}

/* Scroll */
.scroll {
  flex: 1;
}

/* Section */
.section {
  padding: 0 24rpx 0;
}

.section-title {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 1rpx;
  padding: 0 8rpx 12rpx;
  display: block;
}

/* Event list (guest lists) */
.event-list {
  background: var(--bg-card);
  border-radius: 24rpx;
  overflow: hidden;
}

.event-row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 0.5px solid var(--bg);
  gap: 16rpx;
}

.event-row:last-child {
  border-bottom: none;
}

.event-row:active {
  background: var(--bg);
}

.event-row-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.event-row-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.event-row-meta {
  font-size: 24rpx;
  color: var(--text-2);
}

.event-row-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.event-row-count {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--blue);
  line-height: 1;
}

.event-row-count-label {
  font-size: 20rpx;
  color: var(--text-2);
  margin-top: 2rpx;
}

/* Empty state */
.empty-state {
  padding: 48rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-3);
}

/* Manage card */
.card {
  background: var(--bg-card);
  border-radius: 24rpx;
  overflow: hidden;
}

.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 0.5px solid var(--bg);
}

.card-row:last-child {
  border-bottom: none;
}

.card-row:active {
  background: var(--bg);
}

.row-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.row-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.row-icon-emoji {
  font-size: 30rpx;
}

.row-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.row-label {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
}

.row-sub {
  font-size: 24rpx;
  color: var(--text-2);
}

.row-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pending-badge {
  background: #FF3B30;
  border-radius: 20rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pending-badge-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.chevron {
  font-size: 36rpx;
  color: var(--text-3);
  font-weight: 300;
}

.tab-bar-spacer {
  height: calc(100rpx + env(safe-area-inset-bottom));
}
