/* Hoisted to app.wxss: .tab-bar-spacer.

   Removed as dead code — team.wxml contains no matching markup:
     .counter-bar .counter-item .counter-num .counter-label .counter-divider
     .event-list .event-row(+states) .event-row-info .event-row-title
     .event-row-meta .event-row-right .event-row-count .event-row-count-label
     .empty-state .empty-text
   Verified with a grep of team.wxml and every page .js. */

/* Fixed 100vh + height:0 on the scroller (rather than the previous
   min-height:100vh + bare flex:1) now that <nav-bar> occupies a
   non-scrolling band at the top: without it the scroll-view would size
   to its content and push the list past the bottom of the screen. This
   matches every other list page in the app. */
.page {
  background: var(--bg);
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

/* Scroll */
.scroll {
  flex: 1;
  height: 0;
}

/* Section */
.section {
  padding: 0 24rpx 0;
}

/* wider side padding than the shared .section-title (0 4rpx 12rpx),
   because this page's section sits at 24rpx rather than 24rpx + card inset */
.section-title {
  padding: 0 8rpx 12rpx;
}

/* Manage card — 24rpx radius rather than the shared 20rpx */
.card {
  border-radius: 24rpx;
}

.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 0.5px solid var(--bg);
}

.card-row:last-child {
  border-bottom: none;
}

.card-row:active {
  background: var(--bg);
}

.row-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.row-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.row-icon-emoji {
  font-size: 30rpx;
}

.row-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.row-label {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
}

.row-sub {
  font-size: 24rpx;
  color: var(--text-2);
}

.row-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pending-badge {
  background: #FF3B30;
  border-radius: 20rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pending-badge-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.chevron {
  font-size: 36rpx;
  color: var(--text-3);
  font-weight: 300;
}
