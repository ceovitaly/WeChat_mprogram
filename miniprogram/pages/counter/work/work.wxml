<view class="page">

<!-- ══ STEP 1: VENUE ══ -->
<view wx:if="{{step === 'venue'}}" class="step-venue">
  <view class="venue-bg-gradient" />
  <view class="venue-hero">
    <text class="venue-app-name">THE LIST</text>
    <text class="venue-greeting">{{staffName ? 'Hi, ' + staffName + '!' : 'Welcome'}}</text>
    <text class="venue-hint">Enter venue password to start your shift</text>
  </view>
  <view class="venue-card">
    <view class="input-group">
      <text class="input-label">VENUE PASSWORD</text>
      <input
        class="venue-input"
        placeholder="Enter password"
        placeholder-class="input-placeholder"
        value="{{clubCode}}"
        bindinput="onCodeInput"
        confirm-type="done"
        bindconfirm="enterVenue"
      />
    </view>
    <view class="primary-btn" bindtap="enterVenue">
      <text class="primary-btn-text">Enter</text>
    </view>
    <view class="danger-btn" bindtap="confirmLogout">
      <text class="danger-btn-text">Log Out</text>
    </view>
  </view>
</view>

<!-- ══ STEP 2: EVENTS ══ -->
<view wx:if="{{step === 'event'}}" class="step-event">
  <nav-bar title="{{venueName}}" show-back back-color="#FF3B30" auto-back="{{false}}" bind:back="leaveVenue" />
  <scroll-view class="step-scroll" scroll-y>
    <view wx:if="{{isLoading}}" class="empty-state">
      <text class="empty-text">Loading...</text>
    </view>
    <view wx:elif="{{events.length === 0}}" class="empty-state">
      <text class="empty-icon">📅</text>
      <text class="empty-text">No upcoming events</text>
    </view>
    <view wx:else class="events-list">
      <text class="section-label">Select event</text>
      <view
        wx:for="{{events}}"
        wx:key="_id"
        class="event-card"
        bindtap="selectEvent"
        data-event="{{item}}"
      >
        <view class="event-cover">
          <text class="event-cover-title">{{item.title}}</text>
        </view>
        <view class="event-info">
          <view class="event-meta">
            <text class="event-time">{{item.startTime}} — {{item.endTime}}</text>
            <text class="event-date">{{item.date}}</text>
          </view>
          <text class="chevron">›</text>
        </view>
      </view>
    </view>
    <view class="safe-area-bottom"/>
  </scroll-view>
</view>

<!-- ══ STEP 3: GUESTS ══ -->
<view wx:if="{{step === 'guests'}}" class="step-guests">

  <nav-bar title="{{venueName}} · {{currentEvent.title}}" show-back bind:back="backToEvents" />

  <!-- Search bar -->
  <view class="search-wrap">
    <input
      class="search-input"
      placeholder="Search guests..."
      placeholder-class="field-placeholder"
      value="{{searchQuery}}"
      bindinput="onSearchInput"
    />
  </view>

  <!-- Promoter filter chips -->
  <scroll-view class="chips-bar" scroll-x enable-flex>
    <view class="chips-inner">
      <view
        class="chip {{selectedPromoter === '' ? 'chip--on' : ''}}"
        bindtap="filterPromoter"
        data-name=""
      ><text class="chip-text">All</text></view>
      <view
        wx:for="{{promoterNames}}"
        wx:key="*this"
        class="chip {{selectedPromoter === item ? 'chip--on' : ''}}"
        bindtap="filterPromoter"
        data-name="{{item}}"
      ><text class="chip-text">{{item}}</text></view>
    </view>
  </scroll-view>

  <!-- Stats -->
  <view class="stats-row">
    <text class="stat-green">{{arrivedGuests.length}} arrived</text>
    <text class="stat-sep">·</text>
    <text class="stat-grey">{{totalExpected - arrivedGuests.length}} waiting</text>
  </view>

  <!-- Scrollable guest list -->
  <scroll-view class="guests-scroll" scroll-y>

    <view wx:if="{{isLoading}}" class="empty-state">
      <text class="empty-text">Loading...</text>
    </view>

    <view wx:else class="guests-body">

      <!-- Arrived section -->
      <view wx:if="{{arrivedGuests.length > 0}}" class="guest-group">
        <view class="group-hd">
          <text class="group-hd-name">Arrived</text>
          <text class="group-hd-count">{{arrivedGuests.length}}</text>
        </view>
        <block wx:for="{{filteredArrivedSections}}" wx:key="tag">
          <view class="arrived-section-header">
            <text class="arrived-section-title">{{item.label}}</text>
            <text class="arrived-section-count">{{item.guests.length}}</text>
          </view>
          <view class="card arrived-section-card">
            <view
              wx:for="{{item.guests}}"
              wx:for-item="guest"
              wx:key="_id"
              class="guest-row guest-row--done {{guest.group === 'P' ? 'row--party' : guest.group === 'AP' ? 'row--ap' : guest.group === 'LAP' ? 'row--lap' : 'row--extra'}}"
              catchtap="confirmUncheck"
              data-id="{{guest._id}}"
              data-name="{{guest.guestName}}"
            >
              <text class="arrival-number">{{guest.arrivalNumber}}</text>
              <view class="guest-info">
                <text class="guest-name guest-name--done">{{guest.guestName}}</text>
                <text class="guest-sub">{{guest.promoterName || '—'}}</text>
              </view>
              <view class="tier-badge {{guest.group === 'P' ? 'tier-badge--p' : guest.group === 'AP' ? 'tier-badge--ap' : guest.group === 'LAP' ? 'tier-badge--lap' : 'tier-badge--e'}}">
                <text class="tier-badge-text">{{guest.group || 'E'}}</text>
              </view>
              <text class="arrival-time">{{guest.arrivedAt}}</text>
              <view wx:if="{{guest.internalRole}}" class="staff-badge">
                <text class="staff-badge-text">{{guest.internalLabel}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>

      <!-- Empty pending -->
      <view wx:if="{{filteredGuests.length === 0}}" class="empty-state">
        <text class="empty-text">
          {{searchQuery || selectedPromoter ? 'No guests found' : (arrivedGuests.length > 0 ? 'All guests arrived!' : 'No registered guests')}}
        </text>
      </view>

      <!-- Pending grouped by promoter -->
      <view
        wx:for="{{filteredGuests}}"
        wx:key="promoterName"
        wx:for-item="group"
        wx:for-index="pindex"
        class="guest-group"
      >
        <view class="group-hd">
          <text class="group-hd-name">{{group.promoterName || 'No promoter'}}</text>
          <text class="group-hd-count">{{group.guests.length}}</text>
        </view>
        <view class="card">
          <view
            wx:for="{{group.guests}}"
            wx:key="_id"
            wx:for-item="guest"
            wx:for-index="gindex"
            class="guest-row"
            catchtap="checkIn"
            data-id="{{guest._id}}"
            data-pindex="{{pindex}}"
            data-gindex="{{gindex}}"
          >
            <view class="checkbox">
              <text class="checkbox-empty">○</text>
            </view>
            <text class="guest-name">{{guest.guestName}}</text>
            <view wx:if="{{guest.internalRole}}" class="staff-badge">
              <text class="staff-badge-text">{{guest.internalLabel}}</text>
            </view>
          </view>
        </view>
      </view>

    </view>

    <view class="tab-bar-spacer"/>
  </scroll-view>

</view>

</view>
