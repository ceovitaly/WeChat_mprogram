/* Hoisted to app.wxss: .card .search-input .guest-row(+:last-child)
   .guest-name .guest-info .guest-sub .arrival-time .tier-badge
   .arrived-section-header/-title/-count/-card .tab-bar-spacer
   .empty-icon .nav-title. Only the deltas live here. */

page {
  height: 100vh;
  background: var(--bg);
}

.page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* ══ STEP 1 ══ */

.step-venue {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #050505;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding: 0 32rpx;
  padding-top: calc(env(safe-area-inset-top) + 20rpx);
  padding-bottom: calc(env(safe-area-inset-bottom) + 100rpx);
  z-index: 10;
  overflow-y: auto;
}

.venue-bg-gradient {
  position: fixed;
  top: -200rpx;
  left: -100rpx;
  right: -100rpx;
  height: 900rpx;
  background: radial-gradient(
    ellipse at 50% 20%,
    rgba(0, 122, 255, 0.20) 0%,
    rgba(0, 0, 0, 0) 70%
  );
  z-index: 0;
  pointer-events: none;
}

.venue-hero {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding-top: calc(40rpx + env(safe-area-inset-top));
  padding-bottom: 40rpx;
}

.venue-app-name {
  font-size: 80rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: -3rpx;
  line-height: 1;
}

.venue-greeting {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: -1rpx;
  margin-top: 8rpx;
}

.venue-hint {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.35);
  margin-top: 16rpx;
}

.venue-card {
  position: relative;
  z-index: 1;
  background: rgba(28, 28, 30, 0.85);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 44rpx;
  padding: 48rpx 44rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.input-group { display: flex; flex-direction: column; gap: 10rpx; }

.input-label {
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.35);
  letter-spacing: 1rpx;
  padding-left: 4rpx;
}

.venue-input {
  height: 96rpx;
  background: rgba(255, 255, 255, 0.07);
  border-radius: 28rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  color: #FFFFFF;
  width: 100%;
  box-sizing: border-box;
}

.input-placeholder { color: rgba(255, 255, 255, 0.2); }

/* House CTA geometry (76rpx / 999rpx pill / 28rpx / 600) — see app.wxss.
   This card sits on a fixed dark background, so both buttons keep their
   literal colours rather than the theme vars. */
.primary-btn {
  height: 96rpx;
  background: #007AFF;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn:active { opacity: 0.8; }

.primary-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.danger-btn {
  height: 96rpx;
  background: rgba(255, 59, 48, 0.15);
  border: 1rpx solid rgba(255, 59, 48, 0.3);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.danger-btn:active { opacity: 0.7; }

.danger-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FF3B30;
}

/* ══ STEP 2 ══ */

.step-event {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.step-scroll { flex: 1; height: 0; }

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  gap: 16rpx;
}

.empty-text { font-size: 28rpx; color: var(--text-2); text-align: center; }

.events-list { padding: 24rpx; }

.section-label {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 1rpx;
  padding: 0 4rpx 16rpx;
}

.event-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.event-card:active { opacity: 0.8; }

.event-cover {
  /* min-height instead of height: a wrapped two-line title must grow the
     cover instead of being clipped or overflowing the card. */
  min-height: 100rpx;
  background: #1a1a2e;
  padding: 16rpx 28rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.event-cover-title { font-size: 30rpx; font-weight: 600; color: #FFFFFF; line-height: 1.4; word-break: break-all; }

.event-info {
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.event-meta { display: flex; flex-direction: column; gap: 4rpx; }
.event-time { font-size: 28rpx; font-weight: 500; color: var(--text); }
.event-date { font-size: 22rpx; color: var(--text-2); }
.chevron { font-size: 36rpx; color: var(--text-3); }

/* ══ STEP 3 ══ */

.step-guests {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Sub-title rendered inside <nav-bar>'s default slot (below the capsule band) */
.nav-sub {
  display: block;
  font-size: 24rpx;
  color: var(--text-2);
  padding: 0 0 8rpx;
}

/* Search */
.search-wrap {
  background: var(--bg);
  padding: 16rpx 24rpx;
  flex-shrink: 0;
}

/* Chips */
.chips-bar {
  background: var(--bg);
  flex-shrink: 0;
  padding-bottom: 16rpx;
}

.chips-inner {
  display: flex;
  flex-direction: row;
  padding: 0 24rpx;
  gap: 12rpx;
}

.chip {
  height: 56rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  background: var(--bg-card);
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.chip--on { background: var(--blue); }

.chip-text { font-size: 26rpx; font-weight: 500; color: var(--text); }
.chip--on .chip-text { color: #FFFFFF; }

/* Stats */
.stats-row {
  background: var(--bg);
  padding: 0 28rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.stat-green { font-size: 24rpx; font-weight: 600; color: var(--green); }
.stat-sep { font-size: 24rpx; color: var(--text-3); }
.stat-grey { font-size: 24rpx; color: var(--text-2); flex: 1; }

/* Guest list */
.guests-scroll { flex: 1; height: 0; }

.guests-body { padding: 16rpx 24rpx 0; }

.guest-group { margin-bottom: 20rpx; }

.group-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 10rpx;
}

.group-hd-name {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 0.5rpx;
}

.group-hd-count { font-size: 22rpx; color: var(--text-3); }

/* wider gap than the shared 16rpx — this list has a leading checkbox */
.guest-row { gap: 20rpx; }

.guest-row:active { background: var(--bg); }
.guest-row--done { background: #FAFFFE; }

.checkbox {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid var(--text-3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox-empty { font-size: 28rpx; color: var(--text-3); }

.guest-name--done { color: var(--text-green); }

.arrival-number {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--green);
  min-width: 44rpx;
  text-align: center;
  flex-shrink: 0;
}

.staff-badge {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 122, 255, 0.12);
  flex-shrink: 0;
  margin-left: auto;
}
.staff-badge-text {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--blue);
}
/* Tapped-on state: this person is marked present at the event.
   Colour + weight both change — colour alone is not a reliable signal. */
.staff-badge--on { background: rgba(52, 199, 89, 0.18); }
.staff-badge--on .staff-badge-text { color: var(--green); font-weight: 800; }

.safe-area-bottom { height: calc(32rpx + env(safe-area-inset-bottom)); }

/* Tier badge colours — deliberately NOT shared with event-guests, which
   uses translucent fills where this page uses solid pastel ones. */
.tier-badge-text { font-size: 22rpx; font-weight: 600; font-family: monospace; }
.tier-badge--p { background: #E8F5E9; }
.tier-badge--p .tier-badge-text { color: #2E7D32; }
.tier-badge--ap { background: #FFF9C4; }
.tier-badge--ap .tier-badge-text { color: #F57F17; }
.tier-badge--lap { background: #FFF3E0; }
.tier-badge--lap .tier-badge-text { color: #E65100; }
.tier-badge--e { background: #FFE0B2; }
.tier-badge--e .tier-badge-text { color: #E65100; }

.row--party { background: #F5FBF6; }
.row--ap { background: #FFFDF5; }
.row--lap { background: #FFFBF5; }
.row--extra { background: #FFF8E1; }

@media (prefers-color-scheme: dark) {
  .guest-row--done { background: var(--bg-card); }

  .row--party  { background: rgba(48, 209, 88, 0.06); }
  .row--ap     { background: rgba(10, 132, 255, 0.06); }
  .row--lap    { background: rgba(255, 149, 0, 0.06); }
  .row--extra  { background: var(--bg-card); }

  .tier-badge--p   { background: rgba(48, 209, 88, 0.15); }
  .tier-badge--p .tier-badge-text   { color: #30D158; }
  .tier-badge--ap  { background: rgba(10, 132, 255, 0.15); }
  .tier-badge--ap .tier-badge-text  { color: #0A84FF; }
  .tier-badge--lap { background: rgba(255, 149, 0, 0.15); }
  .tier-badge--lap .tier-badge-text { color: #FF9500; }
  .tier-badge--e   { background: rgba(255, 149, 0, 0.15); }
  .tier-badge--e .tier-badge-text   { color: #FF9500; }
}
/* ─── Check-in QR ─── */
/* Trigger row under the promoter chips — the door's main action alongside the list. */
.qr-open-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0 24rpx 16rpx;
  height: 76rpx;
  border-radius: 16rpx;
  background: var(--blue);
}

.qr-open-btn:active { opacity: 0.8; }

.qr-open-icon { font-size: 30rpx; color: #FFFFFF; }

.qr-open-text { font-size: 28rpx; font-weight: 600; color: #FFFFFF; }

/* No-scan chip: this ARRIVED guest was checked in manually, without the
   guest scanning the door code — the counter's responsibility flag. Guests
   who scanned (the normal path) show nothing. */
.noscan-chip {
  flex-shrink: 0;
  margin-left: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(255, 149, 0, 0.15);
}

.noscan-chip-text {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #FF9500;
}

/* Full-screen overlay */
.qr-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr-panel {
  width: 580rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111111;
}

.qr-event {
  font-size: 24rpx;
  color: #666666;
  margin-top: 8rpx;
  text-align: center;
}

.qr-canvas-wrap {
  width: 440rpx;
  height: 440rpx;
  margin-top: 28rpx;
  background: #FFFFFF;
}

.qr-canvas { width: 100%; height: 100%; }

.qr-timer-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  margin-top: 28rpx;
}

.qr-timer-bar {
  flex: 1;
  height: 8rpx;
  border-radius: 4rpx;
  background: #EEEEEE;
  overflow: hidden;
}

.qr-timer-fill {
  height: 100%;
  background: var(--blue);
  transition: width 1s linear;
}

.qr-timer-text {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--blue);
  min-width: 52rpx;
  text-align: right;
}

.qr-hint {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  line-height: 1.5;
  margin-top: 20rpx;
}

.qr-close-btn {
  margin-top: 28rpx;
  width: 100%;
  height: 76rpx;
  border-radius: 16rpx;
  background: #F2F2F2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr-close-btn:active { opacity: 0.8; }

.qr-close-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

@media (prefers-color-scheme: dark) {
  .qr-panel { background: #1C1C1E; }
  .qr-title { color: #FFFFFF; }
  .qr-event { color: #9898A0; }
  .qr-timer-bar { background: #2C2C2E; }
  .qr-close-btn { background: #2C2C2E; }
  .qr-close-text { color: #FFFFFF; }
}

/* Expired-code state: the square swaps to a tappable refresh icon (one
   request per tap — see refreshCheckinQr in work.js). */
.qr-expired {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: #F5F5F7;
  border-radius: 24rpx;
}

.qr-refresh-icon {
  font-size: 96rpx;
  line-height: 1;
  color: #1A1A1A;
}

.qr-refresh-text {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.55);
}

.qr-expired:active .qr-refresh-icon {
  opacity: 0.5;
}

/* ─── Paid-guest scan alert ─────────────────────────────────────────────── */
.paid-alert-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 1100; /* above the QR overlay (1000-level) */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.paid-alert {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-sizing: border-box;
}

.paid-alert-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.paid-alert-tag {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #FF6B35;
}

.paid-alert-time {
  font-size: 24rpx;
  color: #8E8E93;
}

.paid-alert-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.paid-alert-ticket {
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #F2F2F7;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.paid-alert-ticket-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
  flex: 1;
}

.paid-alert-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #007AFF;
}

.paid-alert-promoter {
  font-size: 24rpx;
  color: #8E8E93;
}

.paid-alert-btn {
  height: 76rpx;
  border-radius: 28rpx;
  background: #007AFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.paid-alert-btn-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* Paid arrivals: name + arrival number in red instead of the green every
   arrived guest gets — the counter spots paid tickets in the list at a
   glance. */
.guest-name--paid { color: var(--red); }
.arrival-number--paid { color: var(--red); }
