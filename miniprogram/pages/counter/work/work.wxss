/* Hoisted to app.wxss: .card .search-input .guest-row(+:last-child)
   .guest-name .guest-info .guest-sub .arrival-time .tier-badge
   .arrived-section-header/-title/-count/-card .tab-bar-spacer
   .empty-icon .nav-title. Only the deltas live here. */

page {
  height: 100vh;
  background: var(--bg);
}

.page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* ══ STEP 1 ══ */

.step-venue {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #050505;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding: 0 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 10;
  overflow-y: auto;
}

.venue-bg-gradient {
  position: fixed;
  top: -200rpx;
  left: -100rpx;
  right: -100rpx;
  height: 900rpx;
  background: radial-gradient(
    ellipse at 50% 20%,
    rgba(0, 122, 255, 0.20) 0%,
    rgba(0, 0, 0, 0) 70%
  );
  z-index: 0;
  pointer-events: none;
}

.venue-hero {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  padding-top: 80rpx;
  padding-bottom: 40rpx;
}

.venue-app-name {
  font-size: 80rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: -3rpx;
  line-height: 1;
}

.venue-greeting {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: -1rpx;
  margin-top: 8rpx;
}

.venue-hint {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.35);
  margin-top: 16rpx;
}

.venue-card {
  position: relative;
  z-index: 1;
  background: rgba(28, 28, 30, 0.85);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 44rpx;
  padding: 48rpx 44rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.input-group { display: flex; flex-direction: column; gap: 10rpx; }

.input-label {
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.35);
  letter-spacing: 1rpx;
  padding-left: 4rpx;
}

.venue-input {
  height: 96rpx;
  background: rgba(255, 255, 255, 0.07);
  border-radius: 16rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  color: #FFFFFF;
  width: 100%;
  box-sizing: border-box;
}

.input-placeholder { color: rgba(255, 255, 255, 0.2); }

/* House CTA geometry (76rpx / 999rpx pill / 28rpx / 600) — see app.wxss.
   This card sits on a fixed dark background, so both buttons keep their
   literal colours rather than the theme vars. */
.primary-btn {
  height: 76rpx;
  background: #007AFF;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn:active { opacity: 0.8; }

.primary-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.danger-btn {
  height: 76rpx;
  background: rgba(255, 59, 48, 0.15);
  border: 1rpx solid rgba(255, 59, 48, 0.3);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.danger-btn:active { opacity: 0.7; }

.danger-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FF3B30;
}

/* ══ STEP 2 ══ */

.step-event {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.step-scroll { flex: 1; height: 0; }

.nav-bar {
  background: var(--bg-card);
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 0.5px solid var(--border);
  flex-shrink: 0;
}

.nav-title { font-size: 32rpx; flex: 1; text-align: center; }
.nav-back-red {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}
.nav-back-red:active { opacity: 0.5; }
.nav-back-red-arrow { font-size: 52rpx; color: #FF3B30; line-height: 1; }
.nav-back-placeholder { width: 60rpx; }

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  gap: 16rpx;
}

.empty-text { font-size: 28rpx; color: var(--text-2); text-align: center; }

.events-list { padding: 24rpx; }

.section-label {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 1rpx;
  padding: 0 4rpx 16rpx;
}

.event-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.event-card:active { opacity: 0.8; }

.event-cover {
  height: 100rpx;
  background: #1a1a2e;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
}

.event-cover-title { font-size: 30rpx; font-weight: 600; color: #FFFFFF; }

.event-info {
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.event-meta { display: flex; flex-direction: column; gap: 4rpx; }
.event-time { font-size: 28rpx; font-weight: 500; color: var(--text); }
.event-date { font-size: 22rpx; color: var(--text-2); }
.chevron { font-size: 36rpx; color: var(--text-3); }

/* ══ STEP 3 ══ */

.step-guests {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Header */
.guest-header {
  background: var(--bg-card);
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 0.5px solid var(--border);
  flex-shrink: 0;
  gap: 16rpx;
}

.header-back {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.header-back:active { opacity: 0.4; }

.header-back-arrow {
  font-size: 52rpx;
  color: var(--text);
  line-height: 1;
  margin-top: -4rpx;
}

.header-info { display: flex; flex-direction: column; gap: 4rpx; }
.header-name { font-size: 30rpx; font-weight: 700; color: var(--text); }
.header-venue { font-size: 24rpx; color: var(--text-2); }

/* Search */
.search-wrap {
  background: var(--bg);
  padding: 16rpx 24rpx;
  flex-shrink: 0;
}

/* Chips */
.chips-bar {
  background: var(--bg);
  flex-shrink: 0;
  padding-bottom: 16rpx;
}

.chips-inner {
  display: flex;
  flex-direction: row;
  padding: 0 24rpx;
  gap: 12rpx;
}

.chip {
  height: 56rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  background: var(--bg-card);
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.chip--on { background: var(--blue); }

.chip-text { font-size: 26rpx; font-weight: 500; color: var(--text); }
.chip--on .chip-text { color: #FFFFFF; }

/* Stats */
.stats-row {
  background: var(--bg);
  padding: 0 28rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.stat-green { font-size: 24rpx; font-weight: 600; color: var(--green); }
.stat-sep { font-size: 24rpx; color: var(--text-3); }
.stat-grey { font-size: 24rpx; color: var(--text-2); flex: 1; }

/* Guest list */
.guests-scroll { flex: 1; height: 0; }

.guests-body { padding: 16rpx 24rpx 0; }

.guest-group { margin-bottom: 20rpx; }

.group-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 10rpx;
}

.group-hd-name {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 0.5rpx;
}

.group-hd-count { font-size: 22rpx; color: var(--text-3); }

/* wider gap than the shared 16rpx — this list has a leading checkbox */
.guest-row { gap: 20rpx; }

.guest-row:active { background: var(--bg); }
.guest-row--done { background: #FAFFFE; }

.checkbox {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid var(--text-3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox-empty { font-size: 28rpx; color: var(--text-3); }

.guest-name--done { color: var(--text-green); }

.arrival-number {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--green);
  min-width: 44rpx;
  text-align: center;
  flex-shrink: 0;
}

.staff-badge {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 122, 255, 0.12);
  flex-shrink: 0;
  margin-left: auto;
}
.staff-badge-text {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--blue);
}

.safe-area-bottom { height: calc(32rpx + env(safe-area-inset-bottom)); }

/* Tier badge colours — deliberately NOT shared with event-guests, which
   uses translucent fills where this page uses solid pastel ones. */
.tier-badge-text { font-size: 22rpx; font-weight: 600; font-family: monospace; }
.tier-badge--p { background: #E8F5E9; }
.tier-badge--p .tier-badge-text { color: #2E7D32; }
.tier-badge--ap { background: #E3F2FD; }
.tier-badge--ap .tier-badge-text { color: #1565C0; }
.tier-badge--lap { background: #FFF3E0; }
.tier-badge--lap .tier-badge-text { color: #E65100; }
.tier-badge--e { background: #F5F5F5; }
.tier-badge--e .tier-badge-text { color: #757575; }

.row--party { background: #F5FBF6; }
.row--ap { background: #F5F8FF; }
.row--lap { background: #FFFBF5; }
.row--extra { background: #FAFFFE; }

@media (prefers-color-scheme: dark) {
  .guest-row--done { background: var(--bg-card); }

  .row--party  { background: rgba(48, 209, 88, 0.06); }
  .row--ap     { background: rgba(10, 132, 255, 0.06); }
  .row--lap    { background: rgba(255, 149, 0, 0.06); }
  .row--extra  { background: var(--bg-card); }

  .tier-badge--p   { background: rgba(48, 209, 88, 0.15); }
  .tier-badge--p .tier-badge-text   { color: #30D158; }
  .tier-badge--ap  { background: rgba(10, 132, 255, 0.15); }
  .tier-badge--ap .tier-badge-text  { color: #0A84FF; }
  .tier-badge--lap { background: rgba(255, 149, 0, 0.15); }
  .tier-badge--lap .tier-badge-text { color: #FF9500; }
  .tier-badge--e   { background: rgba(255, 255, 255, 0.08); }
  .tier-badge--e .tier-badge-text   { color: #AEAEB2; }
}
