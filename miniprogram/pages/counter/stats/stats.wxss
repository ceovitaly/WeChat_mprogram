/* The header row is now <nav-bar title="Stats" align="center">
   (/components/nav-bar), which replaced this page's .nav-bar + its
   .nav-title label. The old bar was position:sticky, which is moot now:
   the page no longer scrolls past it (the content is a single centred
   flex:1 block). */

.page {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
}

.coming-soon {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  gap: 24rpx;
}

.cs-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  background: var(--bg-card);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.cs-icon {
  font-size: 80rpx;
}

.cs-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -0.5rpx;
}

.cs-subtitle {
  font-size: 28rpx;
  color: var(--text-2);
  text-align: center;
  line-height: 1.6;
}

.tab-bar-spacer {
  height: 160rpx;
}