page {
  background: var(--bg);
  overflow: hidden;
  height: 100%;
}
.container {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.content-scroll {
  flex: 1;
  height: 0;
}

/* Hero */
/* Image-placeholder gray — a deliberately distinct shade from --bg-inset
   (darker than F2F2F7/f8f9fa) used only while the hero image loads.
   Its dark-mode value happens to match --bg-inset's dark value, but the
   light value doesn't, so this is intentionally left un-tokenized rather
   than forced onto --bg-inset (which would visibly lighten it). */
.hero-section {
  width: 100%;
  height: 560rpx;
  flex-shrink: 0;
  background: #e5e5ea;
  position: relative;
}
.hero-swiper {
  width: 100%;
  height: 560rpx;
}
/* Hero fades in over the .hero-section placeholder once loaded
   (heroLoaded flag set by bindload in event-detail.js) */
.hero-image {
  width: 100%;
  height: 560rpx;
  display: block;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.hero-image--loaded {
  opacity: 1;
}
/* Soft bottom vignette so the swiper's white indicator dots stay legible
   against bright images. Only rendered in the multi-image (swiper)
   branch — a single image has no dots and needs no darkening.
   Non-interactive so it never blocks tap-to-preview or the swipe. */
.hero-gradient {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 40%;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.35) 100%);
  pointer-events: none;
}
.image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.placeholder-text {
  font-size: 28rpx;
  color: #c7c7cc;
}

/* Main card */
.main-card {
  background: var(--bg-elevated);
  border-radius: 40rpx 40rpx 0 0;
  margin-top: -40rpx;
  padding: 48rpx 40rpx 240rpx;
  position: relative;
}

/* Block 1: info (date + title) — plain on the card surface, competitor
   style: small accent datetime line above a large bold title */
.info-block {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.info-datetime {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent);
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.info-title {
  font-size: 46rpx;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.2;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Block 2: venue card — name + address left, mini-map preview right */
.venue-card {
  background: var(--bg-inset);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 36rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.venue-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.venue-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* Venue name + pin stay on --blue: opening the map is a system action,
   and the color signals the whole card navigates somewhere */
.venue-pin {
  width: 32rpx;
  height: 32rpx;
  background-color: var(--blue);
}

.venue-name {
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--blue);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.venue-address {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Static mini-map preview. The transparent cover swallows the native
   map's own gesture handling so the card's tap always wins, and hosts
   the CSS pin (drawn ourselves — no marker iconPath asset needed).
   The pin sits slightly above center so its tip points at the venue. */
.venue-map-wrap {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  flex-shrink: 0;
}

.venue-map {
  width: 100%;
  height: 100%;
}

.venue-map-cover {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.venue-map-pin {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50% 50% 50% 0;
  background: var(--accent);
  transform: rotate(-45deg);
  margin-top: -30rpx;
  position: relative;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
}

.venue-map-pin::after {
  content: '';
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  background: #ffffff;
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}


/* Sections */
.section {
  margin-bottom: 28rpx;
}
.section-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #c7c7cc;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
  display: block;
}
.section-content {
  font-size: 30rpx;
  color: #3a3a3c;
  line-height: 1.7;
  display: block;
}

/* Description block */
.section--desc {
  background: var(--bg-inset);
  border-radius: 28rpx;
  padding: 32rpx 36rpx;
  margin-bottom: 28rpx;
}

/* Promo scroll */
.promo-scroll {
  width: 100%;
  white-space: nowrap;
}
.promo-list {
  display: flex;
  gap: 16rpx;
}
.promo-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

/* Action bar */
.action-bar {
  flex-shrink: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.97);
  border-top: 1rpx solid var(--bg-inset);
}
.action-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
/* Primary brand CTA — the core "get on the list" action */
.btn-register {
  flex: 1;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 24rpx;
  border: none;
  text-align: center;
  margin: 0;
  padding: 0;
}

/* Leading icon inside the CTA — tinted by the button's white text color */
.btn-register-icon {
  width: 32rpx;
  height: 32rpx;
}
.btn-share {
  width: 100rpx;
  height: 100rpx;
  line-height: 100rpx;
  background: var(--bg-inset);
  color: var(--text-primary);
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 24rpx;
  border: none;
  text-align: center;
  flex-shrink: 0;
  margin: 0;
  padding: 0;
}
button::after { border: none; }
.no-profile-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.no-profile-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
}
/* Same primary CTA family as .btn-register, for users without a profile yet */
.btn-join-app {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 24rpx;
  border: none;
  text-align: center;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
.registered-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.registered-status {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}
.registered-icon {
  font-size: 40rpx;
  color: #34c759;
}
.registered-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #34c759;
}

/* Ticket modal — mask/shell now provided by <bottom-sheet>; this stays
   page-specific card styling for the ticket sheet's contents. */
.ticket-modal {
  width: 100%;
  background: var(--bg-elevated);
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.modal-handle {
  width: 80rpx;
  height: 8rpx;
  background: var(--border);
  border-radius: 4rpx;
  margin: 0 auto 32rpx;
}
.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  text-align: center;
  margin-bottom: 32rpx;
}
.modal-subtitle {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}
.ticket-option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--bg-inset);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}

/* Ticket-type selection — kept on --blue (a system list-selection state),
   distinct from the accent-branded CTAs above */
.ticket-selected {
  background: #EEF5FF;
  border-color: var(--blue);
}

.ticket-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #C7C7CC;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ticket-check--on {
  background: var(--blue);
  border-color: var(--blue);
}

.check-mark {
  font-size: 26rpx;
  color: #fff;
  font-weight: 700;
}

.ticket-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ticket-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.ticket-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.ticket-price-tag {
  font-size: 30rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.free-tag { color: #34c759; }
.paid-tag { color: var(--text-primary); }

.no-tickets {
  padding: 40rpx;
  text-align: center;
}

.no-tickets-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* Primary brand CTA — commits the ticket selection ("ticket action button") */
.register-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 24rpx;
  border: none;
  text-align: center;
  margin: 16rpx 0 0;
  padding: 0;
}
.register-btn::after { border: none; }

.modal-cancel {
  text-align: center;
  padding: 28rpx;
  font-size: 30rpx;
  color: var(--text-secondary);
}

/* Success moment — replaces the sheet's content right after a
   successful registration (joinSuccess flag in event-detail.js) */
.join-success {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  padding: 72rpx 0 64rpx;
}

.join-success-circle {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  /* Same spring curve as the bottom-sheet's slide-up */
  animation: joinPop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

/* CSS-drawn check: an L-shape rotated -45deg (same trick as the
   .venue-map-pin CSS shape above) */
.join-success-check {
  width: 52rpx;
  height: 26rpx;
  border-left: 8rpx solid #ffffff;
  border-bottom: 8rpx solid #ffffff;
  box-sizing: border-box;
  transform: rotate(-45deg) translate(2rpx, -6rpx);
  animation: joinCheckIn 0.25s ease-out 0.2s both;
}

.join-success-text {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  animation: joinCheckIn 0.3s ease-out 0.25s both;
}

@keyframes joinPop {
  from { transform: scale(0.4); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

@keyframes joinCheckIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.prompt-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.6;
  padding: 0 8rpx 24rpx;
}

/* Package rows — tappable: open the ticket sheet preselected (see
   openPackageFromList in event-detail.js) */
.package-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--bg-inset);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid var(--border);
}
.package-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.package-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.package-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.package-price {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  flex-shrink: 0;
}
.package-chevron {
  width: 28rpx;
  height: 28rpx;
  background-color: var(--text-secondary);
}

/* ===== DARK MODE ===== */
/* Most colors flip automatically via the tokens above. Only genuinely
   page-local shades (out of the token palette, or diverging from the
   token's dark value) are overridden below. */
@media (prefers-color-scheme: dark) {
  .hero-section { background: #2C2C2E; }

  .section-content { color: #EBEBF5; }
  .section-label { color: #636366; }

  .promo-thumb { background: var(--bg-inset); }

  /* action-bar's translucent white needs its own dark value; its border
     reads as a real divider in dark mode (--border), not the barely-there
     bg-inset blend it uses in light mode */
  .action-bar { background: rgba(28,28,30,0.97); border-top-color: var(--border); }

  .registered-icon { color: #30D158; }
  .registered-text { color: #30D158; }

  .modal-handle { background: #3A3A3C; }

  .ticket-selected { background: rgba(10,132,255,0.15); }
  .ticket-check { border-color: #48484A; }
}
