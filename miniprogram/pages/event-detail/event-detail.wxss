page {
  background: var(--bg);
  overflow: hidden;
  height: 100%;
}
.container {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.content-scroll {
  flex: 1;
  height: 0;
}

/* Hero */
/* Image-placeholder gray — a deliberately distinct shade from --bg-inset
   (darker than F2F2F7/f8f9fa) used only while the hero image loads.
   Its dark-mode value happens to match --bg-inset's dark value, but the
   light value doesn't, so this is intentionally left un-tokenized rather
   than forced onto --bg-inset (which would visibly lighten it). */
.hero-section {
  width: 100%;
  height: 560rpx;
  flex-shrink: 0;
  background: #e5e5ea;
}
.hero-swiper {
  width: 100%;
  height: 560rpx;
}
.hero-image {
  width: 100%;
  height: 560rpx;
  display: block;
}
.image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.placeholder-text {
  font-size: 28rpx;
  color: #c7c7cc;
}

/* Main card */
.main-card {
  background: var(--bg-elevated);
  border-radius: 40rpx 40rpx 0 0;
  margin-top: -40rpx;
  padding: 48rpx 40rpx 240rpx;
  position: relative;
}

/* Block 1: info (date + title) */
.info-block {
  background: var(--bg-inset);
  border-radius: 28rpx;
  padding: 32rpx 36rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-datetime {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
  letter-spacing: 0.3rpx;
}

.info-title {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.2;
}

/* Block 2: venue + map */
.venue-block {
  background: var(--bg-inset);
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 36rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.venue-block:active {
  opacity: 0.75;
}

/* Location ring icon */
.venue-loc-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.venue-loc-ring {
  position: absolute;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid var(--accent);
  box-sizing: border-box;
}

.venue-loc-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--accent);
}

.venue-block-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.venue-v-line {
  width: 2rpx;
  height: 52rpx;
  background: var(--border);
  flex-shrink: 0;
}

/* CSS map pin icon — neutral system/map action, stays on --blue */
.map-icon-btn {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
}

.map-pin-body {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50% 50% 50% 0;
  background: var(--blue);
  transform: rotate(-45deg);
  position: relative;
}

.map-pin-body::after {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  background: #ffffff;
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}


/* Sections */
.section {
  margin-bottom: 28rpx;
}
.section-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #c7c7cc;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
  display: block;
}
.section-content {
  font-size: 30rpx;
  color: #3a3a3c;
  line-height: 1.7;
  display: block;
}

/* Description block */
.section--desc {
  background: var(--bg-inset);
  border-radius: 28rpx;
  padding: 32rpx 36rpx;
  margin-bottom: 28rpx;
}

/* Promo scroll */
.promo-scroll {
  width: 100%;
  white-space: nowrap;
}
.promo-list {
  display: flex;
  gap: 16rpx;
}
.promo-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

/* Action bar */
.action-bar {
  flex-shrink: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.97);
  border-top: 1rpx solid var(--bg-inset);
}
.action-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
/* Primary brand CTA — the core "get on the list" action */
.btn-register {
  flex: 1;
  height: 100rpx;
  line-height: 100rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 24rpx;
  border: none;
  text-align: center;
  margin: 0;
  padding: 0;
}
.btn-share {
  width: 100rpx;
  height: 100rpx;
  line-height: 100rpx;
  background: var(--bg-inset);
  color: var(--text-primary);
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 24rpx;
  border: none;
  text-align: center;
  flex-shrink: 0;
  margin: 0;
  padding: 0;
}
button::after { border: none; }
.no-profile-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.no-profile-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
}
/* Same primary CTA family as .btn-register, for users without a profile yet */
.btn-join-app {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 24rpx;
  border: none;
  text-align: center;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
.registered-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.registered-status {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}
.registered-icon {
  font-size: 40rpx;
  color: #34c759;
}
.registered-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #34c759;
}

/* Ticket modal — mask/shell now provided by <bottom-sheet>; this stays
   page-specific card styling for the ticket sheet's contents. */
.ticket-modal {
  width: 100%;
  background: var(--bg-elevated);
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.modal-handle {
  width: 80rpx;
  height: 8rpx;
  background: var(--border);
  border-radius: 4rpx;
  margin: 0 auto 32rpx;
}
.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  text-align: center;
  margin-bottom: 32rpx;
}
.modal-subtitle {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}
.ticket-option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--bg-inset);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}

/* Ticket-type selection — kept on --blue (a system list-selection state),
   distinct from the accent-branded CTAs above */
.ticket-selected {
  background: #EEF5FF;
  border-color: var(--blue);
}

.ticket-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #C7C7CC;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ticket-check--on {
  background: var(--blue);
  border-color: var(--blue);
}

.check-mark {
  font-size: 26rpx;
  color: #fff;
  font-weight: 700;
}

.ticket-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ticket-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.ticket-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.ticket-price-tag {
  font-size: 30rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.free-tag { color: #34c759; }
.paid-tag { color: var(--text-primary); }

.no-tickets {
  padding: 40rpx;
  text-align: center;
}

.no-tickets-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* Primary brand CTA — commits the ticket selection ("ticket action button") */
.register-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 24rpx;
  border: none;
  text-align: center;
  margin: 16rpx 0 0;
  padding: 0;
}
.register-btn::after { border: none; }

.modal-cancel {
  text-align: center;
  padding: 28rpx;
  font-size: 30rpx;
  color: var(--text-secondary);
}

.prompt-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.6;
  padding: 0 8rpx 24rpx;
}

.package-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-inset);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid var(--border);
}
.package-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* ===== DARK MODE ===== */
/* Most colors flip automatically via the tokens above. Only genuinely
   page-local shades (out of the token palette, or diverging from the
   token's dark value) are overridden below. */
@media (prefers-color-scheme: dark) {
  .hero-section { background: #2C2C2E; }

  .section-content { color: #EBEBF5; }
  .section-label { color: #636366; }

  .promo-thumb { background: var(--bg-inset); }

  /* action-bar's translucent white needs its own dark value; its border
     reads as a real divider in dark mode (--border), not the barely-there
     bg-inset blend it uses in light mode */
  .action-bar { background: rgba(28,28,30,0.97); border-top-color: var(--border); }

  .registered-icon { color: #30D158; }
  .registered-text { color: #30D158; }

  .modal-handle { background: #3A3A3C; }

  .ticket-selected { background: rgba(10,132,255,0.15); }
  .ticket-check { border-color: #48484A; }
}
