page {
  background: #f8f9fa;
}
.container {
  padding-bottom: 220rpx;
}

/* Hero */
.hero-section {
  width: 100%;
  height: 560rpx;
  background: #e5e5ea;
}
.hero-image {
  width: 100%;
  height: 100%;
  display: block;
}
.image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.placeholder-text {
  font-size: 28rpx;
  color: #c7c7cc;
}

/* Main card */
.main-card {
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  margin-top: -40rpx;
  padding: 48rpx 40rpx 40rpx;
  position: relative;
}

/* Title row */
.title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.event-title {
  font-size: 52rpx;
  font-weight: 800;
  color: #1c1c1e;
  line-height: 1.2;
  flex: 1;
  margin-right: 24rpx;
}
.share-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f2f2f7;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.share-icon {
  font-size: 36rpx;
  color: #1c1c1e;
  font-weight: 700;
}

/* Venue */
.venue-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.venue-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}
.venue-name {
  font-size: 30rpx;
  color: #8e8e93;
  font-weight: 500;
}

/* Meta chips */
.meta-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 40rpx;
}
.meta-chip {
  background: #f2f2f7;
  border-radius: 20rpx;
  padding: 12rpx 24rpx;
}
.meta-text {
  font-size: 26rpx;
  color: #3a3a3c;
  font-weight: 500;
}

.divider {
  height: 1rpx;
  background: #f2f2f7;
  margin-bottom: 40rpx;
}

/* Sections */
.section {
  margin-bottom: 48rpx;
}
.section-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #c7c7cc;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
  display: block;
}
.section-content {
  font-size: 30rpx;
  color: #3a3a3c;
  line-height: 1.7;
  display: block;
}

/* Promo scroll */
.promo-scroll {
  width: 100%;
  white-space: nowrap;
}
.promo-list {
  display: flex;
  gap: 16rpx;
}
.promo-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

/* Action bar */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.97);
  border-top: 1rpx solid #f2f2f7;
  z-index: 100;
}
.btn-register {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: #1c1c1e;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 50rpx;
  border: none;
  text-align: center;
}
button::after { border: none; }
.registered-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 100rpx;
}
.registered-icon {
  font-size: 40rpx;
  color: #34c759;
}
.registered-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #34c759;
}

/* Ticket modal */
.ticket-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.ticket-modal {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.modal-handle {
  width: 80rpx;
  height: 8rpx;
  background: #e5e5ea;
  border-radius: 4rpx;
  margin: 0 auto 32rpx;
}
.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1c1c1e;
  display: block;
  text-align: center;
  margin-bottom: 32rpx;
}
.modal-subtitle {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #8e8e93;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}
.ticket-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f8f9fa;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}
.ticket-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.ticket-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
}
.ticket-desc {
  font-size: 26rpx;
  color: #8e8e93;
}
.ticket-price {
  font-size: 36rpx;
  font-weight: 700;
}
.ticket-price.free { color: #34c759; }
.ticket-price.paid { color: #1c1c1e; }
.modal-cancel {
  text-align: center;
  padding: 32rpx;
  font-size: 30rpx;
  color: #8e8e93;
}

/* Promo code */
.promo-input-row {
  margin-bottom: 20rpx;
}
.promo-input-label {
  display: block;
  font-size: 24rpx;
  color: #8e8e93;
  margin-bottom: 12rpx;
}
.promo-input-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #f2f2f7;
  border-radius: 16rpx;
  padding: 0 20rpx;
  height: 88rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}
.input-valid {
  border-color: #34c759;
  background: #f0faf4;
}
.promo-input {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #1c1c1e;
  height: 88rpx;
}
.check-btn {
  margin-top: 12rpx;
  background: #007aff;
  border-radius: 14rpx;
  padding: 16rpx 0;
  text-align: center;
}
.check-btn-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
.promo-promoter-name {
  display: block;
  font-size: 24rpx;
  color: #34c759;
  margin-top: 10rpx;
  font-weight: 600;
}
.promo-error {
  display: block;
  font-size: 24rpx;
  color: #ff3b30;
  margin-top: 10rpx;
}

/* Auth modal actions */
.auth-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 32rpx;
}
.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #1c1c1e;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 44rpx;
  border: none;
  text-align: center;
}
.login-btn::after { border: none; }
.modal-sub {
  display: block;
  font-size: 28rpx;
  color: #8e8e93;
  text-align: center;
  margin-bottom: 16rpx;
}