page {
  background: var(--bg);
  overflow: hidden;
  height: 100%;
}
.container {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.content-scroll {
  flex: 1;
  height: 0;
}

/* Hero */
/* Image-placeholder gray — a deliberately distinct shade from --bg-inset
   (darker than F2F2F7/f8f9fa) used only while the hero image loads.
   Its dark-mode value happens to match --bg-inset's dark value, but the
   light value doesn't, so this is intentionally left un-tokenized rather
   than forced onto --bg-inset (which would visibly lighten it). */
.hero-section {
  width: 100%;
  height: 750rpx;
  flex-shrink: 0;
  background: #e5e5ea;
  position: relative;
}
.hero-swiper {
  width: 100%;
  height: 750rpx;
}
/* Hero fades in over the .hero-section placeholder once loaded
   (heroLoaded flag set by bindload in event-detail.js) */
.hero-image {
  width: 100%;
  height: 750rpx;
  display: block;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.hero-image--loaded {
  opacity: 1;
}
/* Bottom scrim behind the title/datetime overlay — same visual language as
   the feed page's .card-poster-scrim (feed.wxss), scaled to the hero's
   larger size. Rendered in both the swiper and single-image branches (not
   just multi-image) since it now also backs the overlaid title/datetime,
   not just the swiper's indicator dots. Non-interactive so it never blocks
   tap-to-preview or the swipe. */
.hero-scrim {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 55%;
  background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0) 0%,
    rgba(0, 0, 0, 0.25) 40%,
    rgba(0, 0, 0, 0.55) 70%,
    rgba(0, 0, 0, 0.8) 100%
  );
  pointer-events: none;
}

/* Title + datetime "header" bar — a sibling of .hero-section (not nested
   inside it anymore) rendered once regardless of which image branch is
   active. In its resting position, the negative margin-top pulls it up
   so it visually overlaps the bottom of the hero image exactly like the
   old absolutely-positioned overlay did. As the page scrolls, the hero
   image (a normal block above this one) scrolls away; once this bar's
   natural top edge reaches the scroll-view's top, `position: sticky`
   pins it there so the title/date stay visible while the rest of the
   content (venue card, description, etc.) keeps scrolling underneath.
   Non-interactive (pointer-events: none) so taps still reach the image
   underneath for previewHeroImage. -184rpx roughly matches this block's
   own rendered height (datetime line + up-to-3-line title + divider/gaps/
   padding) — needs live-DevTools tuning against real title lengths, see
   report. */
.hero-overlay {
  position: sticky;
  top: 0;
  z-index: 10;
  margin-top: -184rpx;
  padding: 0 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  pointer-events: none;
  transition: background-color 0.2s ease, box-shadow 0.2s ease;
}

/* Pinned state — toggled by JS (event-detail.js onContentScroll) once the
   sticky bar has reached the scroll-view's top edge, and also forced on
   from the start when there's no hero image to overlay transparently
   over (see the wx:else image-placeholder branch and the WXML class
   binding). Solid card-colored background + normal on-card text colors,
   replacing the transparent/white/text-shadow "over a photo" look. */
.hero-overlay--pinned {
  background: var(--bg-elevated);
  border-radius: 0;
}
.hero-overlay--pinned::after {
  content: '';
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: 0;
  height: 1rpx;
  background: var(--border);
}
.hero-overlay--pinned .info-title {
  color: var(--text-primary);
  text-shadow: none;
}
.hero-overlay--pinned .info-datetime {
  text-shadow: none;
}
.image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.placeholder-text {
  font-size: 28rpx;
  color: #c7c7cc;
}

/* Main card */
.main-card {
  background: var(--bg-elevated);
  border-radius: 40rpx 40rpx 0 0;
  margin-top: -40rpx;
  padding: 32rpx 40rpx 48rpx;
  position: relative;
}

/* Block 1: info (date + title) — sits inside the sticky .hero-overlay bar
   (see above); competitor style: small accent datetime line above a large
   bold title. Resting colors assume it's overlaid transparently on the
   hero photo (fixed, not theme tokens, with a text-shadow for contrast on
   bright/busy images — accent-orange is saturated enough to read fine on
   the dark scrim, the shadow is just an extra safety margin). Once pinned
   (.hero-overlay--pinned above) these are overridden to normal on-card
   colors with no shadow. */
.info-datetime {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent);
  letter-spacing: 2rpx;
  text-transform: uppercase;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.45);
}

.info-title {
  font-size: 50rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.2;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.5);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Divider under the title, over the hero scrim — semi-transparent white
   (not var(--border), which is a light/dark surface token that would be
   invisible or wrong against a dark photo). Same technique as the feed
   page's .card-title-divider (feed.wxss). Switches to the normal
   var(--border) token once .hero-overlay--pinned is active, matching how
   .info-title/.info-datetime already get color overrides in that state. */
.info-title-divider {
  width: calc(100% + 16rpx);
  height: 1rpx;
  background: rgba(255, 255, 255, 0.25);
  margin: 24rpx -8rpx 0;
}
.hero-overlay--pinned .info-title-divider {
  background: var(--border);
}

/* Block 2: venue card — top-map/bottom-text stacked card. A map preview
   strip sits on top (no cover-view, no text overlaid on it — see below),
   the venue name/address sit in a plain solid-background strip
   underneath. When there are no coordinates, the map strip just shows
   its fallback background (no <map>, no crash) and the text strip below
   still renders normally — same unconditional markup either way. */
.venue-card {
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.venue-card-divider {
  height: 1rpx;
  background: var(--border);
  margin: 0 32rpx 16rpx;
}

/* Map preview strip. Deliberately NOT overlaid with any cover-view text:
   cover-view children of a native <map> component visibly lag the map's
   own compositing layer while the page scrolls (confirmed jittering in
   live WeChat DevTools testing), so venue name/address live in their own
   plain block below instead — eliminating that compositing mismatch
   entirely. Fallback background shows when there are no coordinates. */
.venue-map-preview {
  width: 100%;
  height: 140rpx;
  position: relative;
  background: var(--bg-inset);
  flex-shrink: 0;
}

.venue-map {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

/* Plain name/address strip below the map — always the same markup
   whether or not a map is showing above it. Solid card-surface
   background (no longer transparent-over-photo), normal on-card colors. */
.venue-info--plain {
  position: relative;
  background: var(--bg-elevated);
  box-sizing: border-box;
  padding: 20rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
}

.venue-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.venue-pin {
  width: 32rpx;
  height: 32rpx;
}

.venue-pin--plain {
  background-color: var(--text-secondary);
}

.venue-name--plain {
  color: var(--text-primary);
  text-shadow: none;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.venue-address--plain {
  color: var(--text-secondary);
  text-shadow: none;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}


/* Sections */
.section {
  margin-bottom: 32rpx;
}
.section--related {
  margin-top: 16rpx;
}
.section-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #c7c7cc;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
  display: block;
}
.section-content {
  font-size: 30rpx;
  color: #3a3a3c;
  line-height: 1.5;
  display: block;
  width: 100%;
  box-sizing: border-box;
  white-space: normal;
  overflow-wrap: break-word;
}

/* Sub-heading produced by the admin's rich-text editor (a user selects part
   of the description and marks it as a heading, rendered as <h2>). Sized
   relative to the hero title (.info-title, 50rpx) rather than left to
   rich-text's own default UA-style h2 sizing, so it reads as a deliberate
   sub-heading (50rpx - 3rpx = 47rpx) without competing with the hero title. */
.section-content h2 {
  font-size: 47rpx;
  font-weight: 700;
  color: inherit;
  line-height: 0.8;
  margin: 12rpx 0;
  white-space: normal;
  overflow-wrap: break-word;
}

/* Description block — flat on the page, separated from the next block by
   a hairline divider instead of its own background card. */
.section--desc {
  position: relative;
  padding-bottom: 28rpx;
}
.section--desc::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 0;
  height: 1rpx;
  background: var(--border);
}

/* Promo scroll */
.promo-scroll {
  width: 100%;
  white-space: nowrap;
}
.promo-list {
  display: flex;
  gap: 16rpx;
}
.promo-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

/* "You May Also Like" — horizontal strip of mini event cards. The strip
   bleeds edge-to-edge past the main-card's 40rpx padding (negative
   margins on the scroll, matching padding on the list) so cards scroll
   under the screen edges. */
.related-scroll {
  width: auto;
  margin: 0 -40rpx;
  white-space: nowrap;
}

.related-list {
  display: flex;
  gap: 20rpx;
  padding: 0 40rpx;
}

.related-card {
  width: 220rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.related-img {
  width: 220rpx;
  height: 320rpx;
  border-radius: 16rpx;
  background: var(--bg-inset);
  flex-shrink: 0;
  margin-bottom: 6rpx;
}

.related-datetime {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--accent);
  letter-spacing: 1.5rpx;
  text-transform: uppercase;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.related-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.3;
  white-space: normal;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.related-venue {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.related-venue-pin {
  width: 24rpx;
  height: 24rpx;
  background-color: var(--text-secondary);
}

.related-venue-name {
  min-width: 0;
  font-size: 22rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Action bar */
.action-bar {
  position: relative;
  flex-shrink: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.97);
}
.action-bar::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 0;
  height: 1rpx;
  background: var(--bg-inset);
}
.action-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
/* Primary brand CTA — the core "get on the list" action. Pill-shaped to
   match the feed page's .get-ticket-btn (feed.wxss) so the same CTA
   reads consistently across both pages. */
.btn-register {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #FF8F5E 0%, #FF6B35 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  border-radius: 999rpx;
  border: none;
  text-align: center;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}
.btn-register::after {
  border: none;
  display: none;
}

/* Leading icon inside the CTA — tinted by the button's white text color */
.btn-register-icon {
  width: 28rpx;
  height: 28rpx;
}

/* Circular icon-only share button — same 88rpx height as .btn-register
   so the pair sit flush in the action row. */
.btn-share {
  width: 76rpx;
  height: 76rpx;
  min-width: 76rpx;
  max-width: 76rpx;
  line-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-inset);
  border-radius: 50%;
  border: none;
  flex-shrink: 0;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  overflow: hidden;
}
.btn-share::after {
  border: none;
  display: none;
}
.btn-share-icon {
  width: 36rpx;
  height: 36rpx;
  background-color: var(--text-primary);
}
button::after { border: none; }
.no-profile-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.no-profile-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
}
/* Same primary CTA family as .btn-register, for users without a profile yet */
.btn-join-app {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 24rpx;
  border: none;
  text-align: center;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
.registered-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.registered-status {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}
.registered-icon {
  font-size: 40rpx;
  color: #34c759;
}
.registered-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #34c759;
}

/* Ended/closed state — event's date has passed, registration no longer
   available. Mirrors .registered-bar's layout (flex row, space-between,
   same alignment relative to the share button) but muted/neutral coloring
   instead of the green "confirmed" look — this isn't an error or success
   state, just informational. */
.ended-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.ended-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

/* Ticket modal — mask/shell now provided by <bottom-sheet>; this stays
   page-specific card styling for the ticket sheet's contents. */
.ticket-modal {
  width: 100%;
  background: var(--bg-elevated);
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.modal-handle {
  width: 80rpx;
  height: 8rpx;
  background: var(--border);
  border-radius: 4rpx;
  margin: 0 auto 32rpx;
}
.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  text-align: center;
  margin-bottom: 32rpx;
}
.modal-subtitle {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}
.ticket-option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--bg-inset);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}

/* Ticket-type selection — kept on --blue (a system list-selection state),
   distinct from the accent-branded CTAs above */
.ticket-selected {
  background: #EEF5FF;
  border-color: var(--blue);
}

.ticket-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #C7C7CC;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ticket-check--on {
  background: var(--blue);
  border-color: var(--blue);
}

.check-mark {
  font-size: 26rpx;
  color: #fff;
  font-weight: 700;
}

.ticket-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ticket-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.ticket-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.ticket-price-tag {
  font-size: 30rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.free-tag { color: #34c759; }
.paid-tag { color: var(--text-primary); }

.no-tickets {
  padding: 40rpx;
  text-align: center;
}

.no-tickets-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* Primary brand CTA — commits the ticket selection ("ticket action button") */
.register-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 24rpx;
  border: none;
  text-align: center;
  margin: 16rpx 0 0;
  padding: 0;
}
.register-btn::after { border: none; }

.modal-cancel {
  text-align: center;
  padding: 28rpx;
  font-size: 30rpx;
  color: var(--text-secondary);
}

/* Success moment — replaces the sheet's content right after a
   successful registration (joinSuccess flag in event-detail.js) */
.join-success {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  padding: 72rpx 0 64rpx;
}

.join-success-circle {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  /* Same spring curve as the bottom-sheet's slide-up */
  animation: joinPop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

/* CSS-drawn check: an L-shape rotated -45deg */
.join-success-check {
  width: 52rpx;
  height: 26rpx;
  border-left: 8rpx solid #ffffff;
  border-bottom: 8rpx solid #ffffff;
  box-sizing: border-box;
  transform: rotate(-45deg) translate(2rpx, -6rpx);
  animation: joinCheckIn 0.25s ease-out 0.2s both;
}

.join-success-text {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  animation: joinCheckIn 0.3s ease-out 0.25s both;
}

@keyframes joinPop {
  from { transform: scale(0.4); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

@keyframes joinCheckIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.prompt-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.6;
  padding: 0 8rpx 24rpx;
}

/* Package rows — tappable: open the ticket sheet preselected (see
   openPackageFromList in event-detail.js). No longer individually boxed;
   rows stack with a shared hairline divider between them (border-bottom on
   all but the last row) instead of each having its own background/border. */
.package-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
}
.package-item::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 0;
  height: 1rpx;
  background: var(--border);
}
.package-item:last-child {
  padding-bottom: 0;
}
.package-item:last-child::after {
  display: none;
}
.package-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.package-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.package-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.package-price {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  flex-shrink: 0;
}
.package-chevron {
  width: 28rpx;
  height: 28rpx;
  background-color: var(--text-secondary);
}

/* ===== DARK MODE ===== */
/* Most colors flip automatically via the tokens above. Only genuinely
   page-local shades (out of the token palette, or diverging from the
   token's dark value) are overridden below. */
@media (prefers-color-scheme: dark) {
  .hero-section { background: #2C2C2E; }

  .section-content { color: #EBEBF5; }
  .section-label { color: #636366; }

  .promo-thumb { background: var(--bg-inset); }

  /* action-bar's translucent white needs its own dark value; its border
     reads as a real divider in dark mode (--border), not the barely-there
     bg-inset blend it uses in light mode */
  .action-bar { background: rgba(28,28,30,0.97); }
  .action-bar::after { background: var(--border); }

  .registered-icon { color: #30D158; }
  .registered-text { color: #30D158; }

  .modal-handle { background: #3A3A3C; }

  .ticket-selected { background: rgba(10,132,255,0.15); }
  .ticket-check { border-color: #48484A; }
}
