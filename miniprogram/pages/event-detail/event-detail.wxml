<view class="container">

<view class="hero-section">
  <block wx:if="{{event.promoImages && event.promoImages.length > 1}}">
    <swiper class="hero-swiper" indicator-dots="{{true}}" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#ffffff" circular="{{true}}">
      <swiper-item wx:for="{{event.promoImages}}" wx:for-item="img" wx:key="*this">
        <image src="{{img}}" class="hero-image" mode="aspectFill" catchtap="previewHeroImage" data-url="{{img}}" />
      </swiper-item>
    </swiper>
  </block>
  <block wx:elif="{{event.promoImage}}">
    <image src="{{event.promoImage}}" class="hero-image" mode="aspectFill" catchtap="previewHeroImage" data-url="{{event.promoImage}}" />
  </block>
  <view wx:else class="image-placeholder">
    <text class="placeholder-text">No Image</text>
  </view>
</view>

<scroll-view class="content-scroll" scroll-y enhanced show-scrollbar="false">
<view class="main-card">

    <!-- Block 1: date/time + title -->
    <view class="info-block">
      <text class="info-datetime">{{event.displayDatetime || event.displayDate || event.date}}</text>
      <text class="info-title">{{event.title}}</text>
    </view>

    <!-- Block 2: venue + map -->
    <view class="venue-block" bindtap="openMap">
      <view class="venue-loc-icon">
        <view class="venue-loc-ring"></view>
        <view class="venue-loc-dot"></view>
      </view>
      <text class="venue-block-name">{{event.venueName || 'TBA'}}</text>
      <view class="venue-v-line"></view>
      <view class="map-icon-btn">
        <view class="map-pin-body"></view>
      </view>
    </view>

    <view class="section section--desc" wx:if="{{event.description}}">
      <text class="section-content">{{event.description}}</text>
    </view>

    <view class="section" wx:if="{{event.promoMaterials && event.promoMaterials.length > 0}}">
      <text class="section-label">PROMO</text>
      <scroll-view scroll-x class="promo-scroll">
        <view class="promo-list">
          <image
            wx:for="{{event.promoMaterials}}"
            wx:key="index"
            src="{{item}}"
            class="promo-thumb"
            mode="aspectFill"
            bindtap="previewMaterial"
            data-url="{{item}}"
          />
        </view>
      </scroll-view>
    </view>

    <view class="section" wx:if="{{event.paidPackages && event.paidPackages.length > 0}}">
      <text class="section-label">PACKAGES</text>
      <view
        wx:for="{{event.paidPackages}}"
        wx:key="index"
        class="package-item"
      >
        <text class="package-name">{{item.name}}</text>
      </view>
    </view>

  </view>
</scroll-view>

<view class="action-bar">
  <view wx:if="{{isRegistered}}" class="registered-bar">
    <view class="registered-status">
      <text class="registered-icon">✓</text>
      <text class="registered-text">You're on the list</text>
    </view>
    <button class="btn-share" open-type="share">Share</button>
  </view>
  <view wx:else class="action-row">
    <button class="btn-register" bindtap="openTicketModal">📋 Get on list</button>
    <button class="btn-share" open-type="share">Share</button>
  </view>
</view>

</view>

<!-- Ticket modal -->
<view wx:if="{{showTicketModal}}" class="ticket-mask" bindtap="closeTicketModal">
  <view class="ticket-modal" catchtap="noop">
    <view class="modal-handle"></view>
    <text class="modal-title">Get on list</text>
    <text class="modal-subtitle">SELECT TICKET TYPE</text>

    <!-- Free entry option -->
    <view
      wx:if="{{event.isFree}}"
      class="ticket-option {{selectedTicketId === 'free' ? 'ticket-selected' : ''}}"
      bindtap="selectTicket"
      data-id="free"
      data-name="Free Entry"
      data-price="0"
    >
      <view class="ticket-check {{selectedTicketId === 'free' ? 'ticket-check--on' : ''}}">
        <text wx:if="{{selectedTicketId === 'free'}}" class="check-mark">✓</text>
      </view>
      <view class="ticket-left">
        <text class="ticket-name">Free Entry</text>
        <text class="ticket-desc">Standard guest list</text>
      </view>
      <text class="ticket-price-tag free-tag">FREE</text>
    </view>

    <!-- Paid tickets from tickets array -->
    <view
      wx:for="{{event.tickets}}"
      wx:key="id"
      class="ticket-option {{selectedTicketId === item.id ? 'ticket-selected' : ''}}"
      bindtap="selectTicket"
      data-id="{{item.id}}"
      data-name="{{item.name}}"
      data-price="{{item.price}}"
    >
      <view class="ticket-check {{selectedTicketId === item.id ? 'ticket-check--on' : ''}}">
        <text wx:if="{{selectedTicketId === item.id}}" class="check-mark">✓</text>
      </view>
      <view class="ticket-left">
        <text class="ticket-name">{{item.name}}</text>
        <text class="ticket-desc" wx:if="{{item.description}}">{{item.description}}</text>
      </view>
      <text class="ticket-price-tag paid-tag">¥ {{item.price}}</text>
    </view>

    <!-- Paid packages -->
    <view
      wx:for="{{event.paidPackages}}"
      wx:for-index="idx"
      wx:key="idx"
      class="ticket-option {{selectedTicketId === 'pkg_' + idx ? 'ticket-selected' : ''}}"
      bindtap="selectPackage"
      data-idx="{{idx}}"
      data-name="{{item.name}}"
      data-link="{{item.paymentLink}}"
    >
      <view class="ticket-check {{selectedTicketId === 'pkg_' + idx ? 'ticket-check--on' : ''}}">
        <text wx:if="{{selectedTicketId === 'pkg_' + idx}}" class="check-mark">✓</text>
      </view>
      <view class="ticket-left">
        <text class="ticket-name">{{item.name}}</text>
        <text class="ticket-desc">Paid package</text>
      </view>
      <text class="ticket-price-tag paid-tag">PAID</text>
    </view>

    <view wx:if="{{!event.isFree && (!event.tickets || event.tickets.length === 0) && (!event.paidPackages || event.paidPackages.length === 0)}}" class="no-tickets">
      <text class="no-tickets-text">No tickets available yet</text>
    </view>

    <button
      wx:if="{{selectedTicketId}}"
      class="register-btn"
      style="width:100%;margin:0;box-sizing:border-box;"
      bindtap="handleJoin"
    >
      Register
    </button>

    <view class="modal-cancel" bindtap="closeTicketModal">
      <text>Cancel</text>
    </view>
  </view>
</view>

<!-- Register prompt for users without profile -->
<view wx:if="{{showRegisterPrompt}}" class="ticket-mask" bindtap="closeRegisterPrompt">
  <view class="ticket-modal" catchtap="noop">
    <view class="modal-handle"></view>
    <text class="modal-title">Not registered</text>
    <text class="prompt-desc">To get on the list, you need to register in the app first.</text>
    <button class="register-btn" style="width:100%;margin:0;box-sizing:border-box;" bindtap="goRegister">Register</button>
    <view class="modal-cancel" bindtap="closeRegisterPrompt">
      <text>Cancel</text>
    </view>
  </view>
</view>