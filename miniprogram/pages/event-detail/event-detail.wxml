<view class="container">

<!-- The event document couldn't be read (deleted, or no access). Replaces
     the whole page rather than rendering an empty shell with a dead CTA. -->
<view wx:if="{{loadError}}" class="load-error">
  <text class="load-error-title">Event unavailable</text>
  <text class="load-error-sub">This event is no longer available. It may have been removed.</text>
  <view class="load-error-btn" bindtap="goBackFromError">
    <text class="load-error-btn-txt">Go back</text>
  </view>
</view>

<scroll-view wx:else class="content-scroll" scroll-y enhanced show-scrollbar="false" bindscroll="onContentScroll">

<view class="hero-section" style="height:{{heroHeight}}rpx">
  <block wx:if="{{event.promoImages && event.promoImages.length > 1}}">
    <swiper class="hero-swiper" style="height:{{heroHeight + 24}}rpx" indicator-dots="{{true}}" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#ffffff" circular="{{true}}" autoplay="{{true}}" interval="{{3000}}" duration="{{400}}">
      <swiper-item wx:for="{{event.promoImages}}" wx:for-item="img" wx:key="*this">
        <image src="{{img}}" class="hero-image {{heroLoaded ? 'hero-image--loaded' : ''}}" style="height:{{heroHeight + 24}}rpx" mode="aspectFill" bindload="onHeroLoad" catchtap="previewHeroImage" data-url="{{img}}" />
      </swiper-item>
    </swiper>
    <view class="hero-scrim"></view>
  </block>
  <block wx:elif="{{event.promoImage}}">
    <image src="{{event.promoImage}}" class="hero-image {{heroLoaded ? 'hero-image--loaded' : ''}}" style="height:{{heroHeight + 24}}rpx" mode="aspectFill" bindload="onHeroLoad" catchtap="previewHeroImage" data-url="{{event.promoImage}}" />
    <view class="hero-scrim"></view>
  </block>
  <view wx:else class="image-placeholder">
    <text class="placeholder-text">No Image</text>
  </view>
</view>

<view class="hero-overlay {{(headerPinned || !(event.promoImage || (event.promoImages && event.promoImages.length > 0))) ? 'hero-overlay--pinned' : ''}}" wx:if="{{event}}">
  <text wx:if="{{event.displayDatetimeShort || event.date}}" class="info-datetime">{{event.displayDatetimeShort || event.date}}</text>
  <text class="info-title">{{event.title}}</text>
  <view class="info-title-divider"></view>
</view>

<view class="main-card">

    <view class="section section--desc" wx:if="{{event.description}}">
      <rich-text class="section-content" nodes="{{event.description}}"></rich-text>
    </view>

    <!-- Block 2: venue card — a real map of the venue's location as a
         preview strip on top, plain venue name/address below it. No
         cover-view/overlay-on-map anymore: cover-view children of a
         native <map> component can visibly lag the map's own compositing
         layer while the page scrolls (WeChat DevTools-confirmed jitter),
         so text is never overlaid on the map — it's a separate block
         underneath instead. When there are no coordinates, .venue-map-preview
         just renders its fallback background with no <map> (no crash);
         the name/address strip below is unconditional either way. The
         whole card opens the system map (openMap). -->
    <view class="venue-card pressable" hover-class="pressed-soft" hover-start-time="20" hover-stay-time="80" bindtap="openMap">
      <view class="venue-map-preview">
        <map
          wx:if="{{event.venueLatitude && event.venueLongitude}}"
          class="venue-map"
          latitude="{{event.venueLatitude}}"
          longitude="{{event.venueLongitude}}"
          scale="15"
          enable-zoom="{{false}}"
          enable-scroll="{{false}}"
          enable-rotate="{{false}}"
          show-compass="{{false}}"
          show-scale="{{false}}"
        ></map>
      </view>
      <view class="venue-info venue-info--plain">
        <view class="venue-name-row">
          <view class="icon icon--pin venue-pin venue-pin--plain"></view>
          <text class="venue-name venue-name--plain">{{event.venueName || 'TBA'}}</text>
        </view>
        <text wx:if="{{event.venueAddress}}" class="venue-address venue-address--plain">{{event.venueAddress}}</text>
      </view>
    </view>

    <view class="venue-card-divider"></view>

    <view class="section" wx:if="{{event.promoMaterials && event.promoMaterials.length > 0}}">
      <text class="section-label">PROMO</text>
      <scroll-view scroll-x class="promo-scroll">
        <view class="promo-list">
          <image
            wx:for="{{event.promoMaterials}}"
            wx:key="index"
            src="{{item}}"
            class="promo-thumb"
            mode="aspectFill"
            bindtap="previewMaterial"
            data-url="{{item}}"
          />
        </view>
      </scroll-view>
    </view>

    <view class="section" wx:if="{{event.paidPackages && event.paidPackages.length > 0}}">
      <text class="section-label">PACKAGES</text>
      <!-- Each row opens the ticket sheet with this package preselected -->
      <view
        wx:for="{{event.paidPackages}}"
        wx:key="index"
        class="package-item pressable"
        hover-class="pressed-soft"
        hover-start-time="20"
        hover-stay-time="80"
        bindtap="openPackageFromList"
        data-idx="{{index}}"
      >
        <view class="package-left">
          <text class="package-name">{{item.name}}</text>
          <text class="package-desc">{{item.description || 'Paid package'}}</text>
        </view>
        <text wx:if="{{item.price}}" class="package-price">¥ {{item.price}}</text>
        <view class="icon icon--chevron package-chevron"></view>
      </view>
    </view>

    <!-- Other upcoming events (loaded after the main event renders;
         hidden entirely when there's nothing else upcoming) -->
    <view class="section section--related" wx:if="{{relatedEvents.length > 0}}">
      <text class="section-label">YOU MAY ALSO LIKE</text>
      <scroll-view scroll-x class="related-scroll" enhanced show-scrollbar="{{false}}">
        <view class="related-list">
          <view
            wx:for="{{relatedEvents}}"
            wx:key="_id"
            class="related-card pressable"
            hover-class="pressed"
            hover-start-time="20"
            hover-stay-time="80"
            bindtap="goToRelated"
            data-id="{{item._id}}"
          >
            <image wx:if="{{item.cardImage}}" src="{{item.cardImage}}" class="related-img" mode="aspectFill" lazy-load />
            <view wx:else class="related-img"></view>
            <text class="related-datetime">{{item.displayDatetimeShort}}</text>
            <text class="related-title">{{item.title}}</text>
            <view class="related-venue" wx:if="{{item.venueName}}">
              <view class="icon icon--pin related-venue-pin"></view>
              <text class="related-venue-name">{{item.venueName}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

  </view>
</scroll-view>

<view class="action-bar" wx:if="{{!loadError}}">
  <view wx:if="{{isRegistered}}" class="registered-bar">
    <view class="registered-status">
      <text class="registered-icon">✓</text>
      <text class="registered-text">You're on the list</text>
    </view>
    <button class="btn-share pressable" hover-class="pressed" hover-start-time="20" hover-stay-time="80" open-type="share">
      <view class="icon icon--share btn-share-icon"></view>
    </button>
  </view>
  <view wx:elif="{{event.isEventOver}}" class="ended-bar">
    <text class="ended-text">Registration closed</text>
    <button class="btn-share pressable" hover-class="pressed" hover-start-time="20" hover-stay-time="80" open-type="share">
      <view class="icon icon--share btn-share-icon"></view>
    </button>
  </view>
  <view wx:else class="action-row">
    <button class="btn-register pressable" hover-class="pressed" hover-start-time="20" hover-stay-time="80" bindtap="openTicketModal">
      <view class="icon icon--list btn-register-icon"></view>
      <text>Get on list</text>
    </button>
    <button class="btn-share pressable" hover-class="pressed" hover-start-time="20" hover-stay-time="80" open-type="share">
      <view class="icon icon--share btn-share-icon"></view>
    </button>
  </view>
</view>

</view>

<!-- Ticket modal -->
<bottom-sheet show="{{showTicketModal}}" bind:close="closeTicketModal">
  <view class="ticket-modal">
    <view class="modal-handle"></view>

    <!-- Success moment: shown in place of the ticket list for ~1.2s
         after a successful registration, then the sheet closes -->
    <view wx:if="{{joinSuccess}}" class="join-success">
      <view class="join-success-circle">
        <view class="join-success-check"></view>
      </view>
      <text class="join-success-text">You're on the list</text>
    </view>

    <block wx:else>
    <text class="modal-title">ADD ME ON GUESTS LIST</text>
    <text class="modal-subtitle">SELECT TICKET TYPE</text>

    <!-- Free entry option -->
    <view
      wx:if="{{event.isFree}}"
      class="ticket-option pressable {{selectedTicketId === 'free' ? 'ticket-selected' : ''}}"
      hover-class="pressed-soft"
      hover-start-time="20"
      hover-stay-time="80"
      bindtap="selectTicket"
      data-id="free"
      data-name="Free Entry"
      data-price="0"
    >
      <view class="ticket-check {{selectedTicketId === 'free' ? 'ticket-check--on' : ''}}">
        <text wx:if="{{selectedTicketId === 'free'}}" class="check-mark">✓</text>
      </view>
      <view class="ticket-left">
        <text class="ticket-name">Free Entry</text>
        <text class="ticket-desc">Standard guest list</text>
      </view>
      <text class="ticket-price-tag free-tag">FREE</text>
    </view>

    <!-- Paid tickets from tickets array -->
    <view
      wx:for="{{event.tickets}}"
      wx:key="id"
      class="ticket-option pressable {{selectedTicketId === item.id ? 'ticket-selected' : ''}}"
      hover-class="pressed-soft"
      hover-start-time="20"
      hover-stay-time="80"
      bindtap="selectTicket"
      data-id="{{item.id}}"
      data-name="{{item.name}}"
      data-price="{{item.price}}"
      data-link="{{item.paymentLink}}"
    >
      <view class="ticket-check {{selectedTicketId === item.id ? 'ticket-check--on' : ''}}">
        <text wx:if="{{selectedTicketId === item.id}}" class="check-mark">✓</text>
      </view>
      <view class="ticket-left">
        <text class="ticket-name">{{item.name}}</text>
        <text class="ticket-desc" wx:if="{{item.description}}">{{item.description}}</text>
      </view>
      <text class="ticket-price-tag paid-tag">¥ {{item.price}}</text>
    </view>

    <!-- Paid packages -->
    <view
      wx:for="{{event.paidPackages}}"
      wx:for-index="idx"
      wx:key="idx"
      class="ticket-option pressable {{selectedTicketId === 'pkg_' + idx ? 'ticket-selected' : ''}}"
      hover-class="pressed-soft"
      hover-start-time="20"
      hover-stay-time="80"
      bindtap="selectPackage"
      data-idx="{{idx}}"
      data-name="{{item.name}}"
      data-link="{{item.paymentLink}}"
    >
      <view class="ticket-check {{selectedTicketId === 'pkg_' + idx ? 'ticket-check--on' : ''}}">
        <text wx:if="{{selectedTicketId === 'pkg_' + idx}}" class="check-mark">✓</text>
      </view>
      <view class="ticket-left">
        <text class="ticket-name">{{item.name}}</text>
        <text class="ticket-desc">Paid package</text>
      </view>
      <text class="ticket-price-tag paid-tag">PAID</text>
    </view>

    <view wx:if="{{!event.isFree && (!event.tickets || event.tickets.length === 0) && (!event.paidPackages || event.paidPackages.length === 0)}}" class="no-tickets">
      <text class="no-tickets-text">No tickets available yet</text>
    </view>

    <button
      wx:if="{{selectedTicketId}}"
      class="register-btn pressable"
      hover-class="pressed"
      hover-start-time="20"
      hover-stay-time="80"
      style="width:100%;margin:0;box-sizing:border-box;"
      bindtap="handleJoin"
    >
      Join
    </button>

    <view class="modal-cancel pressable" hover-class="pressed-soft" hover-start-time="20" hover-stay-time="80" bindtap="closeTicketModal">
      <text>Cancel</text>
    </view>
    </block>
  </view>
</bottom-sheet>

<!-- Register prompt for users without profile -->
<bottom-sheet show="{{showRegisterPrompt}}" bind:close="closeRegisterPrompt">
  <view class="ticket-modal">
    <view class="modal-handle"></view>
    <text class="modal-title">Not registered</text>
    <text class="prompt-desc">To get on the list, you need to register in the app first.</text>
    <button class="register-btn pressable" hover-class="pressed" hover-start-time="20" hover-stay-time="80" style="width:100%;margin:0;box-sizing:border-box;" bindtap="goRegister">Join</button>
    <view class="modal-cancel pressable" hover-class="pressed-soft" hover-start-time="20" hover-stay-time="80" bindtap="closeRegisterPrompt">
      <text>Cancel</text>
    </view>
  </view>
</bottom-sheet>