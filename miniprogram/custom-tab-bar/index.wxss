.tab-label {
  font-size: 20rpx;
  color: #8E8E93;
  font-weight: 400;
}
.tab-label--active {
  color: #007AFF;
  font-weight: 500;
}
.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}