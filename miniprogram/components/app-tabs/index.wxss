.app-tabs-nav {
  position: relative;
  flex-shrink: 0;
  box-sizing: border-box;
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 12rpx;
  background: var(--bg-elevated);
  transition: box-shadow 0.25s ease;
}

.app-tabs-nav::after {
  content: '';
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  height: 1rpx;
  background: var(--border);
}

.app-tabs-nav--scrolled {
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.08);
}

.app-tabs-row {
  display: flex;
  align-items: stretch;
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  overflow: hidden;
}

.app-tab {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
}

.app-tab:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 20%;
  bottom: 20%;
  width: 1rpx;
  background: var(--border);
}

.app-tab--active {
  background: rgba(255, 107, 53, 0.12);
}

.app-tab--pressed {
  opacity: 0.65;
}

.app-tab-label {
  color: var(--text-primary);
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

.app-tab--active .app-tab-label {
  color: var(--accent);
  font-weight: 700;
}
