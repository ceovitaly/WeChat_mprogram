.bottom-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  animation: fadeIn 0.2s ease-out;
}

.bottom-sheet-mask--center {
  align-items: center;
  justify-content: center;
}

.bottom-sheet-shell {
  width: 100%;
  box-sizing: border-box;
  /* Opacity-only fade, deliberately not a translateY slide: a transform
     animation on this shell was found (real-device testing only, not
     reproducible in the DevTools simulator) to visually detach/shift native
     components rendered inside the slot — e.g. the profile page's name-edit
     <input>. WeChat's native form components don't reliably track an
     ancestor's CSS transform mid-animation, so any sheet content that
     includes a native element (input/textarea/etc.) would render shifted
     off-screen. This trades away the spring slide-up motion for correctness
     across all current and future sheet content. */
  animation: sheetFadeIn 0.22s ease-out;
}

.bottom-sheet-shell--center {
  width: auto;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes sheetFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@media (prefers-color-scheme: dark) {
  .bottom-sheet-mask { background: rgba(0, 0, 0, 0.65); }
}
