{
  "pages": [
    "pages/register/register",
    "pages/admin/calendar/calendar",
    "pages/admin/events/events",
    "pages/admin/main/main",
    "pages/admin/history/history",
    "pages/admin/team/team",
    "pages/admin/stats/stats",
    "pages/admin/past-events/past-events",
    "pages/admin/reports/reports",
    "pages/counter/work/work",
    "pages/admin/ads/ads"
  ],
  "subPackages": [
    {
      "root": "packageAdmin",
      "name": "admin",
      "pages": [
        "pages/admin/venue-list/venue-list",
        "pages/admin/venue-edit/venue-edit",
        "pages/admin/event-edit/event-edit",
        "pages/admin/staff/staff",
        "pages/admin/promoters/promoters",
        "pages/admin/guests/guests",
        "pages/admin/event-guests/event-guests",
        "pages/admin/history-events/history-events",
        "pages/admin/history-timeline/history-timeline",
        "pages/admin/history-sessions/history-sessions"
      ]
    }
  ],
  "preloadRule": {
    "pages/admin/calendar/calendar": {
      "network": "all",
      "packages": [
        "admin"
      ]
    },
    "pages/admin/events/events": {
      "network": "all",
      "packages": [
        "admin"
      ]
    },
    "pages/admin/main/main": {
      "network": "all",
      "packages": [
        "admin"
      ]
    }
  },
  "lazyCodeLoading": "requiredComponents",
  "tabBar": {
    "custom": true,
    "color": "#8E8E93",
    "selectedColor": "#007AFF",
    "backgroundColor": "#ffffff",
    "list": [
      {
        "pagePath": "pages/admin/calendar/calendar",
        "text": "Schedule"
      },
      {
        "pagePath": "pages/admin/events/events",
        "text": "Events"
      },
      {
        "pagePath": "pages/admin/main/main",
        "text": "Main"
      },
      {
        "pagePath": "pages/admin/history/history",
        "text": "History"
      },
      {
        "pagePath": "pages/counter/work/work",
        "text": "Work"
      }
    ]
  },
  "window": {
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTextStyle": "@navTxtStyle",
    "navigationBarTitleText": "THE LIST",
    "backgroundColor": "@bgColor",
    "enablePullDownRefresh": false
  },
  "style": "v2",
  "darkmode": true,
  "themeLocation": "theme.json",
  "sitemapLocation": "sitemap.json"
}