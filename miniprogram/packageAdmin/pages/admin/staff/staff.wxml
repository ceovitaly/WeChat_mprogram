<view class="page">

<!-- Reached via navigateTo from Team. navigationStyle is now custom, so
     the system back button is gone — show-back restores it, routed to
     this page's pre-existing goBack() handler. -->
<nav-bar title="Counters" show-back auto-back="{{false}}" bind:back="goBack" />

<view class="page-toolbar">
  <view class="page-add-btn" bindtap="openCreateModal">
    <text class="page-add-btn-text">+ Add Counter</text>
  </view>
</view>

<scroll-view class="scroll-content" scroll-y>

  <view wx:if="{{loading}}" class="empty-state">
    <text class="empty-text">Loading...</text>
  </view>

  <view wx:elif="{{staffList.length === 0}}" class="empty-state">
    <text class="empty-icon">👤</text>
    <text class="empty-text">No counters yet</text>
  </view>

  <view wx:else class="list">
    <view wx:for="{{staffList}}" wx:key="_id" class="item-card" bindtap="openEditModal" data-id="{{item._id}}">
      <view class="item-top">
        <view class="item-avatar {{item.role === 'admin' ? 'avatar--admin' : 'avatar--counter'}}">
          <text class="item-avatar-text">{{item.name[0]}}</text>
        </view>
        <view class="item-info">
          <view class="item-name-row">
            <text class="item-name">{{item.name}}</text>
            <view class="role-badge {{item.role === 'admin' ? 'badge-admin' : 'badge-counter'}}">
              <text class="role-badge-text">{{item.role || 'counter'}}</text>
            </view>
          </view>
          <text wx:if="{{item.phone}}" class="item-sub">{{item.phone}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="safe-area-bottom" />

</scroll-view>

<!-- Keep the editor scrollable inside the shared, clipped sheet shell. -->
<bottom-sheet show="{{showModal}}" bind:close="closeModal">
  <view class="staff-sheet" style="padding-bottom: {{keyboardHeight}}px;">
    <view class="modal-header staff-header">
      <text class="modal-title">{{editingId ? 'Edit Counter' : 'New Counter'}}</text>
      <button class="staff-close" bindtap="closeModal" aria-label="Close editor">✕</button>
    </view>
    <scroll-view class="staff-editor-scroll" scroll-y enhanced show-scrollbar="{{false}}" style="height: calc(90vh - 112rpx - env(safe-area-inset-bottom) - {{keyboardHeight}}px);">
      <view class="staff-editor-content">
        <view class="modal-body staff-form">
          <view class="field-row staff-field">
            <text class="field-label staff-label">Name</text>
            <input class="field-input staff-input" placeholder="Full name" placeholder-class="field-placeholder" value="{{tempName}}" bindinput="onInputName" disabled="{{saving}}" confirm-type="next" adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeightChange" />
          </view>
          <view class="field-row staff-field">
            <text class="field-label staff-label">Phone</text>
            <input class="field-input staff-input" type="number" placeholder="Phone number" placeholder-class="field-placeholder" value="{{tempPhone}}" bindinput="onInputPhone" disabled="{{saving}}" confirm-type="next" adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeightChange" />
          </view>
          <view class="field-row staff-field staff-password-field">
            <text class="field-label staff-label">Password</text>
            <view class="staff-password-control">
              <input class="field-input staff-input" password="{{!passwordVisible}}" placeholder="{{passwordLoading ? 'Loading current password…' : (editingId ? 'Enter a new password' : 'Blank: generate password')}}" placeholder-class="field-placeholder" value="{{tempPassword}}" bindinput="onInputPassword" disabled="{{saving}}" maxlength="-1" confirm-type="done" adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeightChange" />
              <button class="staff-eye" bindtap="togglePasswordVisibility" aria-label="{{passwordVisible ? 'Hide password' : 'Show password'}}">
                <view class="staff-eye-shape"><view class="staff-eye-pupil" /></view>
                <view wx:if="{{!passwordVisible}}" class="staff-eye-slash" />
              </button>
            </view>
          </view>
        </view>
        <view class="staff-password-help" aria-live="polite">
          <text wx:if="{{passwordLoading}}">Loading the current password. You can type a replacement while it loads.</text>
          <text wx:elif="{{passwordMessage}}">{{passwordMessage}}</text>
          <text wx:elif="{{editingId}}">{{passwordEdited ? 'Save applies your edits.' : 'Current password shown. Edit it to change it, or leave it unchanged to keep it.'}}</text>
          <text wx:else>Leave blank to generate a password, or enter your own. You can view it again in Edit Counter.</text>
          <button wx:if="{{editingId && passwordMessage && !passwordLoading}}" class="staff-retry" bindtap="retryPassword" disabled="{{saving}}">Reload current password</button>
        </view>
        <view class="staff-role-section">
          <text class="section-title staff-role-label">Role</text>
          <view class="staff-role-options">
            <button class="staff-role-option {{tempRole === 'counter' ? 'staff-role-option--active' : ''}}" bindtap="selectRole" data-role="counter" disabled="{{saving}}" aria-label="Counter role">
              <text class="staff-role-text">Counter</text>
              <text class="staff-role-sub">Door check-in</text>
            </button>
            <button class="staff-role-option {{tempRole === 'admin' ? 'staff-role-option--active' : ''}}" bindtap="selectRole" data-role="admin" disabled="{{saving}}" aria-label="Admin role">
              <text class="staff-role-text">Admin</text>
              <text class="staff-role-sub">Full access</text>
            </button>
          </view>
        </view>
        <view class="modal-footer staff-footer">
          <button class="modal-cancel staff-action" bindtap="closeModal">Cancel</button>
          <button class="modal-save staff-action" bindtap="confirmSave" disabled="{{saving || passwordLoading}}" loading="{{saving}}">{{saving ? 'Saving…' : 'Save'}}</button>
        </view>
        <view wx:if="{{editingId}}" class="staff-delete-section">
          <button class="staff-delete" catchtap="deleteEditing" disabled="{{saving || passwordLoading}}">Delete Counter</button>
        </view>
      </view>
    </scroll-view>
  </view>
</bottom-sheet>

</view>
