/* Shared with venue-list + promoters and hoisted to app.wxss:
   .scroll-content .nav-add-text .list .item-card .item-top .item-name
   .item-info .item-sub .item-avatar .item-avatar-text .empty-icon
   .field-row .field-label .field-placeholder .section-title
   and the .modal-* sheet chrome. Only the deltas live here. */

page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.page {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* The nine hand-rolled .nav-bar variants are gone — this page's header
   is <nav-bar> (/components/nav-bar) and its "+ Add Counter" action uses
   the shared .nav-action / .nav-action-text pair from app.wxss. */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  gap: 20rpx;
}

/* literal #8E8E93 rather than var(--text-2), preserved as-is: in dark mode
   var(--text-2) is #AEAEB2, so switching would change this page. */
.empty-text { font-size: 28rpx; color: #8E8E93; }

.item-avatar { border-radius: 50%; }

.avatar--admin { background: #E8F0FB; }
.avatar--counter { background: var(--bg); }

.item-avatar-text { color: var(--text); }

.item-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.role-badge {
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}

.badge-admin { background: #E8F0FB; }
.badge-counter { background: var(--bg); }

.role-badge-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #8E8E93;
  text-transform: uppercase;
  letter-spacing: 0.5rpx;
}

.safe-area-bottom {
  height: calc(32rpx + env(safe-area-inset-bottom));
}

/* Page-scoped editor geometry; shared bottom-sheet and modal rules stay intact. */
.staff-sheet { width: 100%; min-height: 0; box-sizing: border-box; }
.modal-header.staff-header {
  height: 112rpx;
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.staff-header .modal-title {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  white-space: nowrap;
  font-size: 30rpx;
  line-height: 64rpx;
}
.staff-header-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  flex: 0 0 auto;
  width: auto;
  min-width: 0;
}
.staff-header-actions > .staff-delete {
  flex: 0 0 200rpx;
  width: 200rpx;
  min-width: 200rpx;
  max-width: 200rpx;
  white-space: nowrap;
}
.staff-header-actions > .staff-close {
  flex: 0 0 56rpx;
  width: 56rpx;
  min-width: 56rpx;
  max-width: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.staff-editor-scroll {
  width: 100%;
  height: auto;
  min-height: 0;
  box-sizing: border-box;
}
.staff-editor-content { padding: 0 24rpx 24rpx; box-sizing: border-box; }
.staff-close,
.staff-eye,
.staff-retry {
  padding: 0;
  margin: 0;
  background: transparent;
  color: var(--text-2);
  border: 0;
  border-radius: 0;
}
.staff-close::after,
.staff-eye::after,
.staff-retry::after,
.staff-role-option::after,
.staff-action::after,
.staff-delete::after { border: none; }
.staff-close {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  flex-shrink: 0;
}
.modal-body.staff-form { margin: 0; width: 100%; box-sizing: border-box; }
.field-row.staff-field {
  padding: 16rpx 24rpx;
  min-height: 112rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  gap: 8rpx;
}
.field-label.staff-label {
  min-width: 0;
  width: 100%;
  line-height: 36rpx;
  font-size: 24rpx;
  color: var(--text-2);
}
.field-input.staff-input {
  flex: 1;
  width: 0;
  min-width: 0;
  height: 48rpx;
  min-height: 48rpx;
  line-height: 48rpx;
  font-size: 28rpx;
  text-align: left;
  color: var(--text);
  box-sizing: border-box;
}
.staff-field > .staff-input { flex: none; width: 100%; }
.staff-password-control { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.staff-eye {
  position: relative;
  flex: 0 0 56rpx;
  width: 56rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.staff-eye-shape {
  width: 32rpx;
  height: 20rpx;
  border: 2rpx solid var(--text-2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.staff-eye-pupil { width: 10rpx; height: 10rpx; background: var(--text-2); border-radius: 50%; }
.staff-eye-slash { position: absolute; width: 38rpx; height: 2rpx; background: var(--text-2); transform: rotate(-40deg); }
.staff-password-help {
  padding: 16rpx 0 0;
  font-size: 23rpx;
  line-height: 34rpx;
  color: var(--text-2);
  overflow-wrap: break-word;
}
.staff-retry { font-size: 24rpx; line-height: 44rpx; text-align: left; color: var(--blue); }
.staff-role-section { padding-top: 24rpx; }
.section-title.staff-role-label { display: block; padding: 0 0 12rpx; margin: 0; }
.staff-role-options { display: flex; align-items: stretch; gap: 16rpx; }
.staff-role-option {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  height: 116rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 16rpx;
  background: var(--bg-card);
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 4rpx;
  line-height: normal;
  text-align: left;
}
.staff-role-option--active { border-color: var(--blue); background: rgba(0, 122, 255, 0.1); }
.staff-role-text { font-size: 28rpx; font-weight: 600; line-height: 36rpx; color: var(--text); }
.staff-role-sub { font-size: 22rpx; line-height: 30rpx; color: var(--text-2); }
.modal-footer.staff-footer { padding: 24rpx 0 0; gap: 16rpx; }
.staff-footer .modal-cancel.staff-action,
.staff-footer .modal-save.staff-action {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  box-sizing: border-box;
  height: 76rpx;
  min-height: 76rpx;
  border-radius: 999rpx;
  margin: 0;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 600;
}
.staff-action[disabled], .staff-delete[disabled] { opacity: 0.5; }
.staff-delete {
  width: auto;
  flex-shrink: 0;
  height: 64rpx;
  min-height: 64rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 59, 48, 0.08);
  color: #FF3B30;
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 600;
}
