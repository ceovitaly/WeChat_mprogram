<view class="page">

<!-- Reached via navigateTo from Schedule. navigationStyle is now custom,
     so the system back button is gone — show-back restores it, routed to
     this page's pre-existing onCancel() handler. The old
     .header-container wrapper (which drew the background + hairline for
     a borderless .nav-bar) is gone: <nav-bar> draws both itself. -->
<nav-bar
  title="{{isEdit ? 'Edit Event' : 'New Event'}}"
  show-back
  auto-back="{{false}}"
  bind:back="onCancel"
>
  <view slot="right" class="nav-action" bindtap="onSave">
    <text class="nav-action-text {{isProcessing ? 'nav-action-text--dim' : ''}}">Save</text>
  </view>
</nav-bar>

<scroll-view class="content-area" scroll-y show-scrollbar="{{false}}" bindtap="dismissKeyboard">
<view class="tab-content">

  <!-- ── Photos ── -->
  <view class="section">
    <text class="section-title">Photos ({{images.length}}/10)</text>
    <view class="media-grid">
      <view class="media-item" wx:for="{{imageDisplayUrls}}" wx:key="index">
        <image src="{{item}}" mode="aspectFill" class="media-img" />
        <view class="media-remove" bindtap="removeImage" data-index="{{index}}">
          <text>✕</text>
        </view>
      </view>
      <view class="media-add" bindtap="chooseImages" wx:if="{{images.length < 10}}">
        <text class="add-plus">+</text>
        <text class="add-label">Add</text>
      </view>
    </view>
  </view>

  <!-- ── Event info ── -->
  <view class="section">
    <text class="section-title">Event info</text>
    <view class="card">
      <view class="field-row">
        <text class="field-label">Title</text>
        <input
          class="field-input"
          placeholder="Event name"
          placeholder-class="field-placeholder"
          value="{{title}}"
          bindinput="onTitleInput"
          confirm-type="done"
        />
      </view>
      <view class="field-row field-row--area pressable" bindtap="openDescEditor">
        <text class="field-label">Description</text>
        <text class="field-value-preview {{!descPreviewText ? 'field-placeholder' : ''}}">{{descPreviewText || 'Event details...'}}</text>
      </view>
      <view class="field-row">
        <text class="field-label">External link</text>
        <input
          class="field-input"
          placeholder="https://example.com/event"
          placeholder-class="field-placeholder"
          value="{{externalLink}}"
          bindinput="onExternalLinkInput"
          confirm-type="done"
        />
      </view>
      <view class="field-row">
        <text class="field-label">Location</text>
        <picker range="{{venues}}" range-key="name" value="{{venueIndex}}" bindchange="onVenueChange">
          <text class="field-picker {{selectedVenueName ? '' : 'field-placeholder'}}">{{selectedVenueName || 'Select venue'}}</text>
        </picker>
      </view>
      <view class="field-row">
        <text class="field-label">Date</text>
        <picker mode="date" value="{{date}}" bindchange="onDateChange">
          <text class="field-picker {{date ? '' : 'field-placeholder'}}">{{date || 'Select date'}}</text>
        </picker>
      </view>
      <view class="field-row">
        <text class="field-label">Start</text>
        <picker mode="time" value="{{startTime}}" bindchange="onStartTimeChange">
          <text class="field-picker">{{startTime}}</text>
        </picker>
      </view>
      <view class="field-row">
        <text class="field-label">End</text>
        <picker mode="time" value="{{endTime}}" bindchange="onEndTimeChange">
          <text class="field-picker">{{endTime}}</text>
        </picker>
      </view>
    </view>
  </view>

  <!-- ── Entry Limits ── -->
  <view class="section">
    <text class="section-title">Guest groups</text>
    <view class="card">
      <view class="field-row">
        <text class="field-label">Party (P)</text>
        <input
          class="field-input"
          type="number"
          placeholder="0"
          placeholder-class="field-placeholder"
          value="{{partyCapacity}}"
          bindinput="onPartyCapInput"
          confirm-type="done"
        />
      </view>
      <view class="field-row">
        <text class="field-label">After Party (AP)</text>
        <input
          class="field-input"
          type="number"
          placeholder="0"
          placeholder-class="field-placeholder"
          value="{{afterPartyCapacity}}"
          bindinput="onAfterPartyCapInput"
          confirm-type="done"
        />
      </view>
      <view class="field-row">
        <text class="field-label">Late After (LAP)</text>
        <input
          class="field-input"
          type="number"
          placeholder="0"
          placeholder-class="field-placeholder"
          value="{{lateAfterPartyCapacity}}"
          bindinput="onLateAfterPartyCapInput"
          confirm-type="done"
        />
      </view>
    </view>
  </view>

  <!-- ── Paid Tickets ──
       Price > 0 → guests pay with WeChat Pay right in the app.
       No price + external link → the legacy "register, then open link" flow. -->
  <view class="section">
    <text class="section-title">Paid Tickets</text>
    <view class="card">
      <view class="field-row">
        <text class="field-label">Free entry</text>
        <switch checked="{{hasFreeEntry}}" bindchange="toggleFreeEntry" color="#007AFF" />
      </view>
      <view class="field-row" wx:if="{{hasFreeEntry}}">
        <text class="field-label">Free tickets limit</text>
        <input
          class="field-input"
          type="number"
          placeholder="Unlimited"
          placeholder-class="field-placeholder"
          value="{{freeTicketsLimit}}"
          bindinput="onFreeLimitInput"
          confirm-type="done"
        />
      </view>
      <view class="field-row" wx:if="{{hasFreeEntry}}">
        <text class="field-label">Free entry until</text>
        <picker mode="time" value="{{freeUntil}}" bindchange="onFreeUntilChange">
          <text class="field-picker {{freeUntil ? '' : 'field-picker--empty'}}">{{freeUntil || 'All night'}}</text>
        </picker>
      </view>
      <view class="field-row">
        <text class="field-label">Enable paid tickets</text>
        <switch checked="{{hasPaidPackages}}" bindchange="togglePaidPackages" color="#007AFF" />
      </view>
      <view class="field-row" wx:if="{{hasPaidPackages}}">
        <text class="field-label">Show only in Events</text>
        <switch checked="{{eventsOnly}}" bindchange="toggleEventsOnly" color="#007AFF" />
      </view>
    </view>

    <block wx:if="{{hasPaidPackages}}">
      <view
        wx:for="{{paidPackages}}"
        wx:key="index"
        class="paid-package-block"
      >
        <view class="paid-package-header">
          <text class="paid-package-num">Ticket {{index + 1}}</text>
          <view class="pkg-btn pkg-btn--delete" bindtap="removePaidPackage" data-index="{{index}}">
            <text>✕</text>
          </view>
        </view>
        <view class="card">
          <view class="field-row">
            <text class="field-label">Name</text>
            <input
              class="field-input"
              placeholder="VIP Entry, Open Bar..."
              placeholder-class="field-placeholder"
              value="{{item.name}}"
              bindinput="onPaidPackageInput"
              data-index="{{index}}"
              data-field="name"
              confirm-type="done"
            />
          </view>
          <view class="field-row">
            <text class="field-label">Description</text>
            <input
              class="field-input"
              placeholder="What's included (optional)"
              placeholder-class="field-placeholder"
              value="{{item.description}}"
              bindinput="onPaidPackageInput"
              data-index="{{index}}"
              data-field="description"
              confirm-type="done"
            />
          </view>
          <view class="field-row">
            <text class="field-label">Price, ¥</text>
            <input
              class="field-input"
              type="digit"
              placeholder="150"
              placeholder-class="field-placeholder"
              value="{{item.price}}"
              bindinput="onPaidPackageInput"
              data-index="{{index}}"
              data-field="price"
              confirm-type="done"
            />
          </view>
          <view class="field-row">
            <text class="field-label">Quantity</text>
            <input
              class="field-input"
              type="number"
              placeholder="Unlimited"
              placeholder-class="field-placeholder"
              value="{{item.quantity}}"
              bindinput="onPaidPackageInput"
              data-index="{{index}}"
              data-field="quantity"
              confirm-type="done"
            />
          </view>
        </view>
      </view>

      <view class="add-btn" bindtap="addPaidPackage">
        <text class="add-btn-text">+ Add ticket</text>
      </view>
    </block>
  </view>


  <!-- ── Save ── -->
  <view class="section">
    <view class="save-btn {{isProcessing ? 'save-btn--dim' : ''}}" bindtap="onSave">
      <text class="save-btn-text">{{isProcessing ? 'Saving...' : 'Save Event'}}</text>
    </view>
  </view>

</view>
<view class="safe-area-bottom" />
</scroll-view>

<bottom-sheet show="{{showDescEditor}}" position="top" bind:close="closeDescEditor">
    <view class="modal-header">
      <text class="modal-title">Description</text>
      <text class="modal-close" bindtap="closeDescEditor">Cancel</text>
    </view>
    <view class="modal-body">
      <view class="editor-toolbar">
        <view class="toolbar-btn {{editorFormats.bold ? 'toolbar-btn--active' : ''}}" bindtap="onFormatBold">
          <text class="toolbar-btn-text toolbar-btn-text--bold">B</text>
        </view>
        <view class="toolbar-btn {{editorFormats.italic ? 'toolbar-btn--active' : ''}}" bindtap="onFormatItalic">
          <text class="toolbar-btn-text toolbar-btn-text--italic">I</text>
        </view>
        <view class="toolbar-btn {{editorFormats.header == 2 ? 'toolbar-btn--active' : ''}}" bindtap="onFormatHeader">
          <text class="toolbar-btn-text">H</text>
        </view>
        <view class="toolbar-btn {{editorFormats.list == 'bullet' ? 'toolbar-btn--active' : ''}}" bindtap="onFormatBulletList">
          <text class="toolbar-btn-text">•</text>
        </view>
      </view>
      <editor
        id="descEditor"
        class="desc-editor"
        placeholder="Event details..."
        bindready="onEditorReady"
        bindstatuschange="onEditorStatusChange"
      ></editor>
    </view>
    <view class="modal-footer">
      <view class="modal-cancel" bindtap="closeDescEditor">Cancel</view>
      <view class="modal-save" bindtap="saveDescEditor">Save</view>
    </view>
</bottom-sheet>
</view>
