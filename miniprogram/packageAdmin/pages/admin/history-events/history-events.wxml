<view class="history-page"><nav-bar title="{{venueName}}" show-back/><scroll-view class="history-scroll" scroll-y bindscrolltolower="loadMore"><view class="history-section"><view class="history-card history-link" bindtap="openVenueHistory">Venue activity ›</view><view class="history-card history-link" bindtap="openSessions">Counter Sessions ›</view><text class="history-heading">Events · newest first</text><view wx:for="{{events}}" wx:key="id" class="history-card" bindtap="open" data-id="{{item.id}}" data-title="{{item.title}}"><text class="history-name">{{item.title || 'Untitled event'}}</text><text class="history-muted">{{item.date}} · {{item.startTime || '—'}}–{{item.endTime || '—'}} · {{item.status}}</text><text class="history-muted">Guests {{item.totalGuests == null ? '—' : item.totalGuests}} · Entered {{item.arrived == null ? '—' : item.arrived}} · NO SCAN {{item.noScan == null ? '—' : item.noScan}}</text><text class="history-muted">Cancelled since tracking {{item.cancelled == null ? '—' : item.cancelled}}{{item.historical ? ' · History snapshot' : ''}}</text></view><view wx:if="{{!events.length &amp;&amp; !loading}}" class="history-empty">No events with available records</view><view wx:if="{{hasMore &amp;&amp; !loading}}" class="history-load" bindtap="loadMore">Load more</view></view></scroll-view></view>
