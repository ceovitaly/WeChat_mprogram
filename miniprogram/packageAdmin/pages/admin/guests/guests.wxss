/* Hoisted to app.wxss: .search-input .guest-row(+:last-child) .empty-icon
   .internal-badge .scroll-content. The promoter sheet's overlay + shell
   now come from <bottom-sheet>, and the header from <nav-bar>
   (/components/nav-bar). Only the deltas live here. */

/* Fixed-height flex column (was min-height:100vh with native page
   scroll) so <nav-bar>, the search field and the filter chips stay put
   while only the list scrolls — see the comment in guests.wxml. */
page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.page {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Nav-bar export action */
.export-btn {
  background: rgba(48, 209, 88, 0.12);
  border: 1rpx solid rgba(48, 209, 88, 0.3);
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
  flex-shrink: 0;
}

.export-btn:active { opacity: 0.7; }

.export-btn-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #30D158;
}

/* Search */
.search-wrap {
  padding: 16rpx 24rpx 8rpx;
  background: var(--bg);
  flex-shrink: 0;
}

/* Promoter filter chips */
.filter-scroll {
  width: 100%;
  flex-shrink: 0;
}

.filter-row {
  display: flex;
  flex-direction: row;
  padding: 8rpx 24rpx 16rpx;
  gap: 12rpx;
  white-space: nowrap;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  flex-shrink: 0;
}

.filter-chip--active {
  background: var(--blue);
  border-color: var(--blue);
}

.filter-chip-text {
  font-size: 26rpx;
  color: var(--text-2);
  white-space: nowrap;
}

.filter-chip--active .filter-chip-text {
  color: #FFFFFF;
  font-weight: 500;
}

/* Guest list */
.guest-list {
  margin: 0 24rpx;
  background: var(--bg-card);
  border-radius: 20rpx;
  overflow: hidden;
}

.guest-row:active {
  opacity: 0.6;
}

.guest-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(10, 132, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.guest-avatar-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--blue);
}

/* narrower + flexible, unlike the shared 30rpx label used by
   event-guests / counter-work */
.guest-name {
  flex: 1;
  font-size: 28rpx;
}

.guest-promoter {
  font-size: 26rpx;
  color: var(--blue);
  flex-shrink: 0;
}

/* Empty state */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  gap: 16rpx;
}

.empty-text { font-size: 28rpx; color: var(--text-2); }

/* Safe area */
.safe-area-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

/* Change Promoter Sheet — contents of <bottom-sheet>.
   No height cap here: nothing above this node has a definite height (the
   shell hugs its content), so a `max-height` on this flex container leaves
   zero free space for a `flex:1` child to grow into. The cap lives on the
   scroll-view instead — see `.sheet-scroll`. Header + 60vh + cancel stays
   under the shell's 90vh backstop. */
.sheet-inner {
  display: flex;
  flex-direction: column;
}

.sheet-header {
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 0.5px solid var(--border);
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  display: block;
}

.sheet-guest-name {
  font-size: 26rpx;
  color: var(--text-2);
  margin-top: 6rpx;
  display: block;
}

/* The cap goes on the scroll-view itself, NOT on an ancestor: WeChat renders
   <scroll-view> as two nested divs styled `height:100%; max-height:inherit`,
   and the inner one is the actual scroller. `height:100%` of an auto-height
   parent is auto, so the only thing that bounds those divs — and therefore
   the only thing that makes them scroll — is a max-height they can inherit
   from this element. `flex:1; height:0` did the opposite: it handed them a
   0px containing block inside a container with no free space to grow into. */
.sheet-scroll {
  max-height: calc(60vh - env(safe-area-inset-bottom));
}

.sheet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 0.5px solid var(--separator);
}

.sheet-row:active { opacity: 0.6; }

.sheet-row--active {
  background: rgba(10, 132, 255, 0.06);
}

.sheet-row-name {
  font-size: 30rpx;
  color: var(--text);
}

.sheet-row--active .sheet-row-name {
  color: var(--blue);
  font-weight: 500;
}

.sheet-check {
  font-size: 28rpx;
  color: var(--blue);
  font-weight: 600;
}

.sheet-cancel {
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-top: 0.5px solid var(--border);
}

.sheet-cancel:active { opacity: 0.6; }

.sheet-cancel-text {
  font-size: 30rpx;
  color: var(--text-2);
  font-weight: 500;
}

/* Pager — one roster page at a time (see guests.js PAGE_SIZE). */
.pager {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 40rpx 8rpx;
}

.pager-btn {
  padding: 12rpx 28rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

.pager-btn--off {
  opacity: 0.35;
}

.pager-btn-text {
  font-size: 26rpx;
  color: #1A1A1A;
  font-weight: 600;
}

.pager-info {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.45);
}
