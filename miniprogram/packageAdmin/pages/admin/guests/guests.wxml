<view class="page">

<view class="search-wrap">
  <input
    class="search-input"
    placeholder="Search by name..."
    placeholder-class="field-placeholder"
    value="{{searchQuery}}"
    bindinput="onSearchInput"
  />
</view>

<!-- Promoter filter chips -->
<scroll-view class="filter-scroll" scroll-x show-scrollbar="{{false}}">
  <view class="filter-row">
    <view
      class="filter-chip {{selectedPromoter === '' ? 'filter-chip--active' : ''}}"
      bindtap="selectPromoterFilter"
      data-name=""
    >
      <text class="filter-chip-text">All</text>
    </view>
    <view
      wx:for="{{promoters}}"
      wx:key="_id"
      class="filter-chip {{selectedPromoter === item.name ? 'filter-chip--active' : ''}}"
      bindtap="selectPromoterFilter"
      data-name="{{item.name}}"
    >
      <text class="filter-chip-text">{{item.name}}</text>
    </view>
  </view>
</scroll-view>

<view wx:if="{{isLoading && filteredGuests.length === 0}}" class="empty-state">
  <text class="empty-text">Loading...</text>
</view>

<view wx:elif="{{!isLoading && filteredGuests.length === 0}}" class="empty-state">
  <text class="empty-icon">👥</text>
  <text class="empty-text">No guests found</text>
</view>

<view wx:else class="guest-list">
  <view
    wx:for="{{filteredGuests}}"
    wx:key="_id"
    class="guest-row"
    bindtap="onGuestTap"
    data-id="{{item._id}}"
  >
    <view class="guest-avatar">
      <text class="guest-avatar-text">{{item.nickName ? item.nickName[0] : '?'}}</text>
    </view>
    <text class="guest-name">{{item.nickName || '—'}}</text>
    <text wx:if="{{item.internalRole}}" class="badge {{item.internalRole === 'staff' ? 'badge-blue' : 'badge-orange'}} internal-badge">{{item.internalRole === 'staff' ? 'STAFF' : 'PROMOTER'}}</text>
    <text class="guest-promoter">{{item.promoterName || 'No promoter'}}</text>
  </view>
</view>

<view class="safe-area-bottom" />

<!-- Change Promoter Sheet -->
<bottom-sheet show="{{showPromoterSheet}}" bind:close="closePromoterSheet">
  <view class="sheet-inner">
    <view class="sheet-header">
      <text class="sheet-title">Change Promoter</text>
      <text class="sheet-guest-name">{{selectedGuest.nickName}}</text>
    </view>
    <scroll-view class="sheet-scroll" scroll-y>
      <view
        wx:for="{{promoters}}"
        wx:key="_id"
        class="sheet-row {{selectedGuest.promoterId === item._id ? 'sheet-row--active' : ''}}"
        bindtap="assignPromoter"
        data-id="{{item._id}}"
        data-name="{{item.name}}"
      >
        <text class="sheet-row-name">{{item.name}}</text>
        <text wx:if="{{selectedGuest.promoterId === item._id}}" class="sheet-check">✓</text>
      </view>
    </scroll-view>
    <view class="sheet-cancel" bindtap="closePromoterSheet">
      <text class="sheet-cancel-text">Cancel</text>
    </view>
  </view>
</bottom-sheet>

</view>
