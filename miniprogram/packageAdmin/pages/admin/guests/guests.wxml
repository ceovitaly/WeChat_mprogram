<view class="page">

<!-- Reached via navigateTo from Team. This page previously had NO header
     row of its own and relied on the system bar (title + back button);
     with a custom nav both have to be drawn here. -->
<nav-bar title="All Guests" show-back>
  <view slot="right" class="export-btn" bindtap="exportCSV">
    <text class="export-btn-text">Export</text>
  </view>
</nav-bar>

<view class="search-wrap">
  <input
    class="search-input"
    placeholder="Search by name or phone..."
    placeholder-class="field-placeholder"
    value="{{searchQuery}}"
    bindinput="onSearchInput"
  />
</view>

<!-- Promoter filter chips — filtering runs SERVER-side (getGuestsPage), so a
     chip narrows the whole roster, not just the loaded page. Chips carry the
     promoter _id (stable); the name stays display-only. -->
<scroll-view class="filter-scroll" scroll-x show-scrollbar="{{false}}">
  <view class="filter-row">
    <view
      class="filter-chip {{selectedPromoterId === '' ? 'filter-chip--active' : ''}}"
      bindtap="selectPromoterFilter"
      data-id=""
    >
      <text class="filter-chip-text">All</text>
    </view>
    <view
      wx:for="{{promoters}}"
      wx:key="_id"
      wx:if="{{item.promoCode}}"
      class="filter-chip {{selectedPromoterId === item._id ? 'filter-chip--active' : ''}}"
      bindtap="selectPromoterFilter"
      data-id="{{item._id}}"
    >
      <text class="filter-chip-text">{{item.name}}</text>
    </view>
  </view>
</scroll-view>

<!-- The list moved into its own scroll-view (it used to ride the page's
     native scroll). With navigationStyle:custom a natively-scrolling page
     would have carried <nav-bar> up under the status bar and left the
     rows running beneath the capsule; keeping the nav + search + chips as
     fixed siblings above a flex:1 scroller is the same structure the
     three neighbouring list pages already use. -->
<scroll-view class="scroll-content" scroll-y>

<view wx:if="{{isLoading && filteredGuests.length === 0}}" class="empty-state">
  <text class="empty-text">Loading...</text>
</view>

<view wx:elif="{{!isLoading && filteredGuests.length === 0}}" class="empty-state">
  <text class="empty-icon">👥</text>
  <text class="empty-text">No guests found</text>
</view>

<view wx:else class="guest-list">
  <view
    wx:for="{{filteredGuests}}"
    wx:key="_id"
    class="guest-row"
    bindtap="onGuestTap"
    data-id="{{item._id}}"
  >
    <view class="guest-avatar">
      <text class="guest-avatar-text">{{item.nickName ? item.nickName[0] : '?'}}</text>
    </view>
    <text class="guest-name">{{item.nickName || '—'}}</text>
    <text wx:if="{{item.internalRole}}" class="badge {{item.internalRole === 'staff' ? 'badge-blue' : 'badge-orange'}} internal-badge">{{item.internalRole === 'staff' ? 'STAFF' : 'PROMOTER'}}</text>
    <text class="guest-promoter">{{item.promoterName || 'No promoter'}}</text>
  </view>
  </view>

  <!-- Pager — one small page of the roster at a time; the counter is the
       server-side filtered total, not just what's on screen. -->
  <view wx:if="{{totalCount > 0}}" class="pager">
    <view class="pager-btn {{pageNum <= 1 ? 'pager-btn--off' : ''}}" bindtap="prevPage">
      <text class="pager-btn-text">‹ Prev</text>
    </view>
    <text class="pager-info">{{pageNum}} / {{pageCount}} · {{totalCount}}</text>
    <view class="pager-btn {{pageNum >= pageCount ? 'pager-btn--off' : ''}}" bindtap="nextPage">
      <text class="pager-btn-text">Next ›</text>
    </view>
  </view>

  <view class="safe-area-bottom" />

</scroll-view>

<!-- Change Promoter Sheet -->
<bottom-sheet show="{{showPromoterSheet}}" bind:close="closePromoterSheet">
  <view class="sheet-inner">
    <view class="sheet-header">
      <text class="sheet-title">Change Promoter</text>
      <text class="sheet-guest-name">{{selectedGuest.nickName}}</text>
    </view>
    <scroll-view class="sheet-scroll" scroll-y>
      <view
        wx:for="{{promoters}}"
        wx:key="_id"
        class="sheet-row {{selectedGuest.promoterId === item._id ? 'sheet-row--active' : ''}}"
        bindtap="assignPromoter"
        data-id="{{item._id}}"
        data-name="{{item.name}}"
        data-code="{{item.promoCode}}"
      >
        <text class="sheet-row-name">{{item.name}}</text>
        <text wx:if="{{selectedGuest.promoterId === item._id}}" class="sheet-check">✓</text>
      </view>
    </scroll-view>
    <view class="sheet-cancel" bindtap="closePromoterSheet">
      <text class="sheet-cancel-text">Cancel</text>
    </view>
  </view>
</bottom-sheet>

</view>
