<view class="page">

<!-- Reached via navigateTo from Venues. navigationStyle is now custom, so
     the system back button is gone — show-back restores it (the
     component calls wx.navigateBack() itself). -->
<nav-bar title="{{isEdit ? 'Edit Venue' : 'New Venue'}}" show-back>
  <view slot="right" class="nav-action" bindtap="onSave">
    <text class="nav-action-text {{isProcessing ? 'nav-action-text--dim' : ''}}">Save</text>
  </view>
</nav-bar>

<scroll-view class="content-area" scroll-y show-scrollbar="{{false}}">

<!-- Name & Password -->
<view class="section">
  <text class="section-title">Venue info</text>
  <view class="card">
    <view class="field-row">
      <text class="field-label">Name</text>
      <input
        class="field-input"
        placeholder="Venue name"
        placeholder-class="field-placeholder"
        value="{{name}}"
        bindinput="onNameInput"
        confirm-type="done"
      />
    </view>
    <view class="field-row">
      <text class="field-label">Password</text>
      <input
        class="field-input"
        placeholder="Counter login code"
        placeholder-class="field-placeholder"
        value="{{password}}"
        bindinput="onPasswordInput"
        confirm-type="done"
      />
    </view>
  </view>
</view>

<!-- Address -->
<view wx:if="{{isEdit}}" class="section">
  <text class="section-title">Counter Session</text>
  <view class="card session-card">
    <text>{{counterSession ? 'Occupied' : 'Available'}}</text>
    <block wx:if="{{counterSession}}">
      <text>{{counterSession.staffName}} · {{counterSession.eventTitle}}</text>
      <text>Started: {{counterSession.startedLabel}} · {{counterSession.duration}}</text>
      <text>Last activity: {{counterSession.activeLabel}}</text>
      <view class="session-action" bindtap="forceCounterLogout">Force Logout</view>
    </block>
    <view class="session-refresh" bindtap="loadCounterSession">Refresh</view>
  </view>
</view>

<!-- Address -->
<view class="section">
  <text class="section-title">Location</text>
  <view class="card">
    <view class="field-row" bindtap="chooseLocation">
      <text class="field-label">Address</text>
      <text class="field-picker {{address ? '' : 'field-placeholder'}}">{{address || 'Set on map'}}</text>
    </view>
    <view wx:if="{{latitude || longitude}}" class="field-row" bindtap="openInMaps">
      <text class="field-label">Open in Maps</text>
      <text class="field-picker">View ›</text>
    </view>
  </view>
</view>

<!-- Gallery — photos of the venue shown in the guest app's Gallery tab.
     Managed here per-photo (uploaded immediately, deleted on tap); Save
     below is only for the info fields above. -->
<view wx:if="{{isEdit}}" class="section">
  <text class="section-title">Gallery ({{gallery.length}})</text>
  <view class="card gallery-card">
    <view wx:for="{{gallery}}" wx:key="fileID" class="gallery-item">
      <image class="gallery-img" src="{{item.url}}" mode="aspectFill" bindtap="previewGalleryPhoto" data-url="{{item.url}}" />
      <view class="gallery-del" catchtap="removeGalleryPhoto" data-index="{{index}}">
        <text class="gallery-del-icon">✕</text>
      </view>
    </view>
    <view class="gallery-add" bindtap="addGalleryPhotos">
      <text class="gallery-add-icon">＋</text>
      <text class="gallery-add-text">Add photos</text>
    </view>
  </view>
</view>

<!-- Save -->
<view class="section">
  <view class="save-btn {{isProcessing ? 'save-btn--dim' : ''}}" bindtap="onSave">
    <text class="save-btn-text">{{isProcessing ? 'Saving...' : 'Save Venue'}}</text>
  </view>
</view>

<view class="safe-area-bottom" />
</scroll-view>
</view>
