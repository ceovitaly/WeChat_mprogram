/* Hoisted to app.wxss: .section-title .card .field-row .field-label
   .field-placeholder .field-picker .save-btn(+states) and the
   .nav-action* trio. Only the deltas live here.

   The header row is now <nav-bar> (/components/nav-bar); its Save action
   uses .nav-action / .nav-action-text / .nav-action-text--dim, which
   replaced the page-local .nav-bar / .nav-btn / .nav-btn-text and the
   old shared .nav-title / .nav-btn-text--dim.

   Removed as dead code: the .logo-row/.logo-img/.logo-placeholder/
   .logo-plus/.logo-info/.logo-title/.logo-sub block — venue-edit.wxml
   has no logo picker (venue logos are shown, but not edited, here). */

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  overflow: hidden;
}

.content-area {
  flex: 1;
  height: 0;
}

/* ── Sections ── */
.section {
  padding: 24rpx 24rpx 0;
}

/* ── Field rows ── */
.field-row:active { background: var(--bg); }

.field-label { min-width: 200rpx; flex-shrink: 0; }

.field-input {
  flex: 1;
  text-align: left;
  font-size: 28rpx;
  color: var(--text);
  height: 88rpx;
  padding-left: 20rpx;
}

.field-picker { flex: 1; }

.safe-area-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

/* ─── Venue gallery ─────────────────────────────────────────────────────── */
/* Three-per-row thumbnails inside the card, plus the Add tile. */
.gallery-card {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 20rpx;
}

.gallery-item {
  position: relative;
  width: calc((100% - 24rpx) / 3);
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--bg-inset, #F2F2F7);
}

.gallery-img {
  width: 100%;
  height: 100%;
  display: block;
}

.gallery-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.gallery-del-icon {
  font-size: 22rpx;
  color: #ffffff;
  line-height: 1;
}

.gallery-add {
  width: calc((100% - 24rpx) / 3);
  height: 200rpx;
  border-radius: 16rpx;
  border: 2rpx dashed var(--border, #C6C6C8);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.gallery-add-icon {
  font-size: 40rpx;
  color: var(--text-3, #C7C7CC);
  line-height: 1;
}

.gallery-add-text {
  font-size: 20rpx;
  color: var(--text-3, #C7C7CC);
}
