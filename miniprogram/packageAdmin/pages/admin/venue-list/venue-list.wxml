<view class="page">

<!-- Reached via navigateTo from Team. navigationStyle is now custom, so
     the system back button is gone — show-back restores it (the
     component calls wx.navigateBack() itself). -->
<nav-bar title="Venues" show-back />

<view class="page-toolbar">
  <view class="page-add-btn" bindtap="goCreate">
    <text class="page-add-btn-text">+ Add Venue</text>
  </view>
</view>

<scroll-view class="scroll-content" scroll-y>

  <view wx:if="{{loading}}" class="empty-state">
    <text class="empty-text">Loading...</text>
  </view>

  <view wx:elif="{{venues.length === 0}}" class="empty-state">
    <text class="empty-icon">🏛</text>
    <text class="empty-text">No venues yet</text>
    <view class="empty-btn" bindtap="goCreate">
      <text class="empty-btn-text">Add first venue</text>
    </view>
  </view>

  <view wx:else class="list">
    <view wx:for="{{venues}}" wx:key="_id" class="item-card" bindtap="goEdit" data-id="{{item._id}}">

      <view class="item-top">
        <view class="item-avatar">
          <image wx:if="{{item.logo}}" class="venue-logo-img" src="{{item.logo}}" mode="aspectFill"/>
          <text wx:else class="item-avatar-text">{{item.name[0]}}</text>
        </view>
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <text class="item-sub">{{item.password || 'No password'}}</text>
        </view>
      </view>

      <view class="item-actions">
        <view class="action-btn action-btn--primary" catchtap="goEdit" data-id="{{item._id}}">
          <text>Edit</text>
        </view>
        <view class="action-btn action-btn--danger" catchtap="confirmDelete" data-id="{{item._id}}" data-name="{{item.name}}">
          <text>Delete</text>
        </view>
      </view>

    </view>
  </view>

  <view class="safe-area-bottom"/>

</scroll-view>
</view>
