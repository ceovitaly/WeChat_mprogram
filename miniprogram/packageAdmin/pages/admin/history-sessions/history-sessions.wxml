<view class="history-page"><nav-bar title="Counter Sessions" show-back/><scroll-view class="history-scroll" scroll-y bindscrolltolower="loadMore"><view class="history-section"><view wx:for="{{sessions}}" wx:key="sessionId" class="history-card"><text class="history-name">{{item.staffName || 'Counter'}} · {{item.venueName || 'Venue'}}</text><text class="history-muted">{{item.eventTitle || 'Event'}} · {{item.endedAt ? 'Ended' : 'Active'}}</text><text class="history-muted">{{item.startedLabel}} → {{item.endedAt ? item.endedLabel : 'Now'}}</text><text class="history-muted">Duration: {{item.durationMinutes == null ? '—' : item.durationMinutes}} min · {{item.endReason}}</text><text class="history-muted">QR {{item.qr}} · Manual {{item.manual}} · Unchecked {{item.unchecked}} · Removed {{item.removed}}{{item.incomplete ? ' · Partial (1000 record limit)' : ''}}</text></view><view wx:if="{{!sessions.length &amp;&amp; !loading}}" class="history-empty">No recorded sessions</view><view wx:if="{{hasMore &amp;&amp; !loading}}" class="history-load" bindtap="loadMore">Load more</view></view></scroll-view></view>
