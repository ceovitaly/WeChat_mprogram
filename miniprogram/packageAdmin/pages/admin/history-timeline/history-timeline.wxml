<view class="history-page"><nav-bar title="{{title}}" show-back/><scroll-view class="history-scroll" scroll-y bindscrolltolower="loadMore"><view class="history-section"><text class="history-heading">Activity Timeline · Shanghai time</text><scroll-view scroll-x class="history-filters"><view style="display:flex;gap:12rpx"><view wx:for="{{filters}}" wx:key="*this" class="history-chip {{filter === item ? 'active' : ''}}" data-filter="{{item}}" bindtap="changeFilter">{{item}}</view></view></scroll-view><input class="history-input" placeholder="Search employee, guest, event" value="{{search}}" bindinput="searchInput"/><view class="history-filters"><picker mode="date" bindchange="fromChange"><view class="history-chip">From {{from || 'Any'}}</view></picker><picker mode="date" bindchange="toChange"><view class="history-chip">To {{to || 'Any'}}</view></picker></view><view wx:for="{{rows}}" wx:key="_id" class="history-card history-{{item.color}}"><text class="history-muted">{{item.timeLabel}} · {{item.roleLabel}} · {{item.result || 'success'}}</text><text class="history-name">{{item.actorLabel}} {{item.actionLabel}}</text><text class="history-muted">{{item.objectLabel}}</text><text wx:if="{{item.detailsLabel}}" class="history-muted">{{item.detailsLabel}}</text></view><view wx:if="{{!rows.length && !loading}}" class="history-empty">No recorded activity for this selection</view><view wx:if="{{hasMore && !loading}}" class="history-load" bindtap="loadMore">Load more</view></view></scroll-view></view>
