/* Hoisted to app.wxss: .section-title .card .guest-row(+:last-child)
   .guest-name .guest-info .guest-sub .arrival-time .internal-badge
   .tier-badge .arrived-section-header/-title/-count/-card.
   Only the deltas live here.

   Removed as dead code: .group-badge / --p / --ap / --lap — no matching
   markup in event-guests.wxml (the tier pills use .tier-badge). */

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

/* .top-bar / .top-bar-left / .event-title are gone — the header row is
   now <nav-bar> (/components/nav-bar), which owns the background, the
   inset hairline and the title. Only the pieces placed in its slots are
   styled here, since slot content renders in the page's scope. */

/* default slot: the venue line, directly under the capsule band */
.event-sub {
  display: block;
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 2rpx;
}

/* "right" slot: compact header chips, deliberately NOT the 76rpx house
   CTA pill — they have to fit inside the capsule's own band. */
.close-event-btn {
  background: rgba(255, 59, 48, 0.1);
  border: 1rpx solid rgba(255, 59, 48, 0.25);
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.close-event-btn:active { opacity: 0.7; }

.close-event-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--red);
}

.export-btn {
  background: rgba(48, 209, 88, 0.12);
  border: 1rpx solid rgba(48, 209, 88, 0.3);
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.export-btn:active { opacity: 0.7; }

.export-btn-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #30D158;
}

.stats-bar--closed {
  border-bottom-color: rgba(48, 209, 88, 0.3);
}

.stats-bar {
  background: var(--bg-card);
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  border-bottom: 0.5px solid var(--bg);
  flex-shrink: 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  flex: 1;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
}

.stat-num--green { color: #34C759; }

.stat-label {
  font-size: 20rpx;
  color: var(--text-2);
}

.stat-div {
  width: 1rpx;
  height: 48rpx;
  background: var(--border);
}

.refresh-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding-left: 24rpx;
}

.refresh-btn:active { opacity: 0.5; }

.refresh-icon {
  font-size: 36rpx;
  color: var(--blue);
  line-height: 1;
}

.refresh-time {
  font-size: 18rpx;
  color: var(--text-3);
}

.scroll {
  flex: 1;
  height: 0;
}

/* ─── Promoter filter chips ───
   Same control as the counter workspace (work.wxss), pinned under the stats
   bar as part of the toolbar chrome. */
.chips-bar {
  background: var(--bg-card);
  border-bottom: 0.5px solid var(--bg);
  flex-shrink: 0;
  padding: 14rpx 0 16rpx;
}

.chips-inner {
  display: flex;
  flex-direction: row;
  padding: 0 24rpx;
  gap: 12rpx;
}

.chip {
  height: 56rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  background: var(--bg);
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.chip:active { opacity: 0.7; }

.chip--on { background: var(--blue); }

.chip-text { font-size: 26rpx; font-weight: 500; color: var(--text); }

.chip--on .chip-text { color: #FFFFFF; }

.body {
  padding: 24rpx 24rpx 0;
}

.section {
  margin-bottom: 24rpx;
}

.guest-row--duty { background: rgba(52, 199, 89, 0.06); }
.guest-row--arrived { background: transparent; }

.position-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #34C759;
  min-width: 44rpx;
  text-align: center;
  flex-shrink: 0;
}

.position-num--duty {
  color: #007AFF;
}

.guest-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.guest-name--arrived { color: #1D9E75; }
.guest-name--duty { color: #007AFF; }

.arrival-badge {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--blue);
  background: #E8F0FB;
  border-radius: 10rpx;
  padding: 6rpx 14rpx;
  flex-shrink: 0;
}

.pending-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--text-3);
  flex-shrink: 0;
  margin: 0 15rpx;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-3);
}

.safe-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

/* Tier row tints */
.row--party  { background: rgba(46, 125, 50, 0.07); }
.row--ap     { background: rgba(21, 101, 192, 0.07); }
.row--lap    { background: rgba(230, 81, 0, 0.07); }
.row--extra  { background: transparent; }

/* Tier badge colours — deliberately NOT shared with counter/work, which
   uses solid pastel fills where this page uses translucent ones. */
.tier-badge-text { font-size: 22rpx; font-weight: 700; font-family: monospace; }
.tier-badge--p   { background: rgba(46, 125, 50, 0.12); }
.tier-badge--p .tier-badge-text   { color: #2E7D32; }
.tier-badge--ap  { background: rgba(21, 101, 192, 0.12); }
.tier-badge--ap .tier-badge-text  { color: #1565C0; }
.tier-badge--lap { background: rgba(230, 81, 0, 0.12); }
.tier-badge--lap .tier-badge-text { color: #E65100; }
.tier-badge--e   { background: rgba(255, 149, 0, 0.12); }
.tier-badge--e .tier-badge-text   { color: #E65100; }

@media (prefers-color-scheme: dark) {
  .guest-name--arrived { color: #30D158; }
  .guest-name--duty    { color: #0A84FF; }

  .tier-badge--p .tier-badge-text   { color: #30D158; }
  .tier-badge--ap .tier-badge-text  { color: #64B5F6; }
  .tier-badge--lap .tier-badge-text { color: #FFB74D; }
  .tier-badge--e .tier-badge-text   { color: #FF9500; }
  .tier-badge--e { background: rgba(255, 149, 0, 0.15); }

  .arrived-section-header { background: transparent; }
}
/* Load-more row — pagination footer for the guest list (100 per page) */
.load-more {
  margin: 24rpx 24rpx 8rpx;
  padding: 22rpx 0;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.load-more:active { opacity: 0.7; }

.load-more--busy { opacity: 0.6; }

.load-more-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--blue);
}

/* ── Closed-event report buttons (below the stats bar, in place of the list) ── */

.closed-reports {
  padding: 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.closed-reports-btn {
  height: 76rpx;
  border-radius: 28rpx;
  background: #007AFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.closed-reports-btn:active { opacity: 0.8; }

.closed-reports-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* Paid guests: red stats number + red name/position in the lists. Defined
   after .guest-name--arrived so the same-specificity cascade lands on red. */
.stat-num--red { color: #FF3B30; }
.guest-name--paid { color: #FF3B30; }
.position-num--paid { color: #FF3B30; }

/* Arrival method is separate from the capacity tier: NO SCAN guests show E. */
.noscan-chip {
  flex-shrink: 0;
  margin-left: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(255, 149, 0, 0.15);
}
.noscan-chip-text {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #FF9500;
  white-space: nowrap;
}

@media (prefers-color-scheme: dark) {
  .stat-num--red, .guest-name--paid, .position-num--paid { color: #FF453A; }
}

/* Vertical rule between the All/Paid chips and the promoter chips. */
.chips-divider {
  width: 2rpx;
  height: 36rpx;
  background: var(--border, #E5E5EA);
  margin: 0 8rpx;
  flex-shrink: 0;
  align-self: center;
}
